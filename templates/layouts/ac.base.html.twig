<!DOCTYPE html>
<html lang="nl-NL">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{% endblock %} | HNNW Account Centre</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>🤝</text></svg>">

    <link rel="stylesheet" href="{{ asset("assets/shared/css/style.css") }}">
    <link rel="stylesheet" href="{{ asset("assets/main/css/style.css") }}">
    <link rel="stylesheet" href="{{ asset("assets/account-centre/css/style.css") }}">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}{% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body style="background-color: #020617; color: white; margin: 0; font-family: 'Inter', sans-serif;">
    <main>
        {% block body %}{% endblock %}
    </main>
</body>
</html>
