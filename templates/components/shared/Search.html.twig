<div class="auditLogSearch searchTwig" {{ attributes }}>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/shared/css/searchTwig.css') }}">
    {% endblock %}

    <div>
        {{ form_start(form,{
                attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'search',
                    'data-model': 'norender|*'
                }
            }) }}
            <table>
                
            </table>
            {{ form_rest(form) }}

            <button data-loading="addAttribute(disabled)">Zoek</button>
            
        {{ form_end(form) }}

        
        <span data-loading>Loading</span>
        <table data-loading='hide' class="result">
            <thead>
                {% for key, value in displayFields %}
                    <th>{{ value[0] }}</th>
                {% endfor %}
            </thead>
            <tbody>
            {% if this.results is empty and this.hasSearched %}
                <tr><td Colspan="9">Geen resultaten gevonden</td></tr>
            {% elseif this.hasSearched == false %}
                <tr><td Colspan="9">Klik op zoeken om resultaten te vinden</td></tr>
            {% else %}
                {% for result in this.results %}
                    {% set loopIndex = loop.index0 %}
                    <tr>
                        {% for key, value in result|cast_to_array  %}   
                            {% if value is not empty %}       
                                {% if displayFields[key][1] is not empty %}                 
                                    <td><a href="{{path(displayFields[key][1],pathParameters[loopIndex])}}">{{ value|display}}</a></td>  
                                {% else %}
                                    <td>{{ value|display}}</td> 
                                {% endif %}  
                            {% else %}
                                <td>-</td>   
                            {% endif %}                        
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
        
        {% for key, value in links %}
            {% if value is not empty %}            
                    {% if key == 'prev' %}
                        <button data-loading='hide' data-action="live#action" data-live-action-param='navigate' data-live-link-param="{{ value }}">Vorige pagina</button>                    
                    {% elseif key == 'next'%}
                        <button data-loading='hide' data-action="live#action" data-live-action-param='navigate' data-live-link-param="{{ value }}">Volgende pagina</button>
                    {% else %}
                        <button data-loading='hide' data-action="live#action" data-live-action-param='navigate' data-live-link-param="{{ value }}">{{key}}</button>
                    {% endif %}
            {% endif %}       
            
        {% endfor %}
        
    </div>
</div>