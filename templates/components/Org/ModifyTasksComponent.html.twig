<div {{ attributes }} class="modify-tasks-container">
    {% if this.errorMessage %}
        <p>{{ this.errorMessage }}</p>
    {% endif %}

    <table class="modify-tasks-table">
        <tbody>
        {% for task in this.tasks %}
            <tr id="{{ task.id }}" class="task-row">
                <td>
                    {% if task.deletedAt %}
                        Deleted at: {{ task.deletedAt|date('d/m/Y') }}
                    {% endif %}
                </td>
                <td>
                    <label>
                        Name
                        <input type="text" value="{{ task.title }}" data-model="norender|taskMap[{{ task.id }}].title" >
                    </label>
                    <label>
                        Assigned Profile
                        <select data-model="norender|taskMap[{{ task.id }}].assignedProfile">
                            <option value="">Niemand</option>
                            {% for profile in this.profiles %}
                                <option value="{{ profile.id }}"
                                        {% if task.assignedProfile and task.assignedProfile.id == profile.id %}
                                            selected
                                        {% endif %}
                                >
                                    {{ profile.displayName }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                </td>
                <td>
                    <textarea
                        rows="7"
                        cols="50"
                        data-model="norender|taskMap[{{ task.id }}].description"
                    >{{ task.description }}</textarea>
                </td>
                <td>
                    <label>
                        Work Package
                        <select data-model="norender|taskMap[{{ task.id }}].workPackage">
                            {% for workPackage in this.workPackages %}
                                <option value="{{ workPackage.id }}"
                                        {% if task.workPackage == workPackage %}selected{% endif %}
                                >
                                    {{ workPackage.title }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        Status
                        <select data-model="norender|taskMap[{{ task.id }}].status">
                            {% for status in this.statuses %}
                                <option value="{{ status.id }}"
                                        {% if task.status == status %}selected{% endif %}
                                >
                                    {{ status.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                </td>
                <td>
                    <label>
                        Priority
                        <select data-model="norender|taskMap[{{ task.id }}].priority">
                            <option value="high" {% if task.priority == 'high' %}selected{% endif %}
                            >High</option>
                            <option value="medium" {% if task.priority == 'medium' %}selected{% endif %}
                            >Medium</option>
                            <option value="low" {% if task.priority == 'low' %}selected{% endif %}
                            >Low</option>
                        </select>
                    </label>
                    <label>
                        Slug
                        <input type="text" value="{{ task.slug }}" data-model="norender|taskMap[{{ task.id }}].slug">
                    </label>
                </td>
                <td>
                    <label>
                        Due date
                        <input
                            type="datetime-local"
                            value="{{ task.dueDate ? task.dueDate|date('Y-m-d\\TH:i') : '' }}"
                            data-model="norender|taskMap[{{ task.id }}].dueDate"
                        >
                    </label>
                </td>
                <td>
                    {% if not task.deletedAt %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="updateTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Update
                        </button>
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="deleteTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Remove
                        </button>
                    {% else %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="restoreTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Restore
                        </button>
                    {% endif %}

                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
