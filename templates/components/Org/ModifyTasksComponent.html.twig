<div {{ attributes }} class="modify-tasks-container">
    {% if this.errorMessage %}
        <p>{{ this.errorMessage }}</p>
    {% endif %}

    <form class="create-task-form" data-action="live#action" data-live-action-param="createTask">
        <h3>Nieuwe taak</h3>
        <label>
            Titel
            <input type="text" maxlength="255" required data-model="norender|newTask.title">
        </label>
        <label>
            Slug
            <input type="text" maxlength="255" required data-model="norender|newTask.slug" placeholder="taak-uitvoering">
        </label>
        <label>
            Eigenaar
            <select data-model="norender|newTask.assignedProfile">
                <option value="">Geen eigenaar</option>
                {% for profile in this.profiles %}
                    <option value="{{ profile.id }}">{{ profile.displayName }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            Werkpakket
            <select required data-model="norender|newTask.workPackage">
                {% for workPackage in this.workPackages %}
                    <option value="{{ workPackage.id }}">{{ workPackage.title }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            Status
            <select required data-model="norender|newTask.status">
                {% for status in this.statuses %}
                    <option value="{{ status.id }}">{{ status.name }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            Prioriteit
            <select data-model="norender|newTask.priority">
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low" selected>Low</option>
            </select>
        </label>
        <label>
            Deadline
            <input type="datetime-local" data-model="norender|newTask.dueDate">
        </label>
        <label>
            Taak-DoD (definitie van klaar)
            <textarea rows="4" cols="50" required data-model="norender|newTask.description" placeholder="Beschrijf meetbare criteria om deze taak als klaar te beoordelen."></textarea>
        </label>
        <button type="button" data-action="live#action" data-live-action-param="createTask">Taak aanmaken</button>
    </form>

    <table class="modify-tasks-table">
        <tbody>
        {% for task in this.tasks %}
            <tr id="{{ task.id }}" class="task-row">
                <td>
                    {% if task.deletedAt %}
                        Deleted at: {{ task.deletedAt|date('d/m/Y') }}
                    {% endif %}
                </td>
                <td>
                    <label>
                        Name
                        <input type="text" maxlength="255" required value="{{ task.title }}" data-model="norender|taskMap[{{ task.id }}].title" >
                    </label>
                    <label>
                        Assigned Profile
                        <select data-model="norender|taskMap[{{ task.id }}].assignedProfile">
                            <option value="">Niemand</option>
                            {% for profile in this.profiles %}
                                <option value="{{ profile.id }}"
                                        {% if task.assignedProfile and task.assignedProfile.id == profile.id %}
                                            selected
                                        {% endif %}
                                >
                                    {{ profile.displayName }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                </td>
                <td>
                    <label>
                        Taak-DoD (definitie van klaar)
                    <textarea
                        rows="7"
                        cols="50"
                        required
                        data-model="norender|taskMap[{{ task.id }}].description"
                    >{{ task.description }}</textarea>
                    </label>
                </td>
                <td>
                    <label>
                        Work Package
                        <select data-model="norender|taskMap[{{ task.id }}].workPackage">
                            {% for workPackage in this.workPackages %}
                                <option value="{{ workPackage.id }}"
                                        {% if task.workPackage == workPackage %}selected{% endif %}
                                >
                                    {{ workPackage.title }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        Status
                        <select data-model="norender|taskMap[{{ task.id }}].status">
                            {% for status in this.statuses %}
                                <option value="{{ status.id }}"
                                        {% if task.status == status %}selected{% endif %}
                                >
                                    {{ status.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                </td>
                <td>
                    <label>
                        Priority
                        <select data-model="norender|taskMap[{{ task.id }}].priority">
                            <option value="high" {% if task.priority == 'high' %}selected{% endif %}
                            >High</option>
                            <option value="medium" {% if task.priority == 'medium' %}selected{% endif %}
                            >Medium</option>
                            <option value="low" {% if task.priority == 'low' %}selected{% endif %}
                            >Low</option>
                        </select>
                    </label>
                    <label>
                        Slug
                        <input type="text" maxlength="255" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value="{{ task.slug }}" data-model="norender|taskMap[{{ task.id }}].slug">
                    </label>
                </td>
                <td>
                    <label>
                        Due date
                        <input
                            type="datetime-local"
                            value="{{ task.dueDate ? task.dueDate|date('Y-m-d\\TH:i') : '' }}"
                            data-model="norender|taskMap[{{ task.id }}].dueDate"
                        >
                    </label>
                </td>
                <td>
                    {% if not task.deletedAt %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="updateTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Update
                        </button>
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="deleteTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Remove
                        </button>
                    {% else %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="restoreTask"
                            data-live-id-param="{{ task.id }}"
                        >
                            Restore
                        </button>
                    {% endif %}

                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
