<div {{ attributes }} class="modify-updates-container">
    {% if this.errorMessage %}
        {# <twig:Shared:Alert variant="error"> #}
        <p>{{ this.errorMessage }}</p>
        {# </twig:Shared:Alert> #}
    {% endif %}


    <table class="modify-updates-table">
        <tbody>
        {% for update in this.projectUpdates %}
            <tr id="{{ update.id }}" class="update-row">
                <td>Created by:{{ update.author.displayName }} {# link to profile page #}
                    {% if update.deletedAt %}
                        Project delete at:{{ update.deleteAt ? update.deleteAt|date('d/m/Y') : '-' }} }}
                    {% endif %}
                </td>
                <td>
                    <input type="text" value="{{ update.title }}" data-model="updateMap[{{ update.id }}].title" >
                </td>
                <td>
                    <textarea
                        rows="10"
                        cols="50"
                        data-model="updateMap[{{ update.id }}].content"
                    >{{ update.content }}</textarea>
                </td>
                <td>
                    <label>
                        <input
                            type="checkbox"
                            data-model="updateMap[{{ update.id }}].public"
                            {% if update.isPublic %}checked{% endif %} >
                        Public
                    </label>
                </td>
                <td>
                    {% if not update.deletedAt %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="updateProjectUpdate"
                            data-live-id-param="{{ update.id }}"
                        >
                            Update
                        </button>
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="deleteProjectUpdate"
                            data-live-id-param="{{ update.id }}"
                        >
                            Remove
                        </button>
                    {% elseif update.deletedAt %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="restoreProjectUpdate"
                            data-live-id-param="{{ update.id }}"
                        >
                            Restore
                        </button>
                    {% else %}
                        <p>No actions available</p>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
