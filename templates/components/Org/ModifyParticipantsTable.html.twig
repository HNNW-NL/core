<form method="POST" class="edit-participants-form">
    <input type="submit" class="submit" value="Submit Changes">
    <table class="edit-participants-table" id="edit-participants-table">
        <thead>
        <tr id="table-header-row">
            <td draggable="true">Display Name</td>
            <td draggable="true">Date joined</td>
            <td draggable="true">Status</td>
            <td draggable="true">Role</td>
        </tr>
        </thead>
        <tbody>
        {% for participant in this.participants %}
            <tr>
                <td>{{ participant.profile.displayName }}</td> <!-- link to profile-->
                <td>{{ participant.joinedAt ? participant.joinedAt|date('d/m/Y') : '-' }}</td>
                <td>{{ participant.status.name }}</td>
                <td>
                    <select name="role[{{ participant.id }}]" class="select-role">
                        {% for role in this.roles %}
                            <option value="{{ role.id }}"
                                    {% if role == participant.role %}selected{% endif %}>
                                {{ role.name }}
                            </option>
                        {% endfor %}
                    </select>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</form>
