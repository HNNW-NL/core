{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Edit Account {{ account.id }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/accounts.css') }}">
{% endblock %}

{% block body %}
    <h2>{% if account.id %}Edit Account {{ account.id }}{% else %}Create New Account{% endif %}</h2>

    {{ form_start(form, {'attr': {'class': 'account-form'}}) }}
        {{ form_widget(form) }}
        <div class="actions" style="margin-top: 1.5rem;">
            <button type="submit" class="button">Save</button>
            <a href="{{ path('org_accounts_index') }}" class="button button-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
