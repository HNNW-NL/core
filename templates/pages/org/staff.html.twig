{% extends 'layouts/org.base.html.twig' %}

{% block title %}Staff{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/staff-view.css') }}">
{% endblock %}

{% block javascript %}{% endblock %}

{% block body %}
    {% set data = org_staff() %}

    <div class="staff-header">
        <h2>Organization Staff</h2>
        <p>View the staff members of your organization.</p>
    </div>

    {% if data.items is empty %}
        <div class="staff-empty">
            <p>No staff members found.</p>
        </div>
    {% else %}
        <div class="staff-container">
            {% for member in data.items %}
                <div class="staff-card">
                    <h3 class="staff-name">
                        {% if member.displayName %}
                            {{ member.displayName }}
                        {% else %}
                            {{ member.firstName }} {{ member.lastName }}
                        {% endif %}
                    </h3>

                    <p class="staff-email">
                        {{ member.email }}
                    </p>

                    <p class="staff-role">
                        Role: {{ member.role|default('No role') }}
                    </p>

                    <a
                        class="staff-view-link"
                        href="{{ path('org.viewStaff', {id: member.id}) }}"
                    >
                        View staff member
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}