
{% extends 'layouts/org.base.html.twig' %}

{% block title %}Staff Management{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/staff-view.css') }}">
{% endblock %}

{% block javascript %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('staff-search');
            const staffCards = document.querySelectorAll('.staff-card');
            const noResults = document.getElementById('staff-no-results');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const searchTerm = searchInput.value.toLowerCase().trim();
                    let visibleCount = 0;

                    staffCards.forEach(function (card) {
                        const staffText = [
                            card.querySelector('.staff-name')?.textContent || '',
                            card.querySelector('.staff-email')?.textContent || '',
                            card.querySelector('.staff-role')?.textContent || ''
                        ].join(' ').toLowerCase();

                        const matches = staffText.includes(searchTerm);
                        card.style.display = matches ? '' : 'none';

                        if (matches) {
                            visibleCount++;
                        }
                    });

                    if (noResults) {
                        noResults.hidden = visibleCount > 0;
                    }
                });
            }

            const addButton = document.getElementById('staff-add-button');
            const addForm = document.getElementById('staff-add-form');
            const cancelButton = document.getElementById('staff-add-cancel');

            if (addButton && addForm) {
                addButton.addEventListener('click', function () {
                    addForm.hidden = false;
                    addButton.hidden = true;
                    document.getElementById('staff-add-email')?.focus();
                });
            }

            if (cancelButton && addForm && addButton) {
                cancelButton.addEventListener('click', function () {
                    addForm.hidden = true;
                    addButton.hidden = false;
                });
            }
        });
    </script>
{% endblock %}

{% block body %}
    {% set data = org_staff() %}

    <div class="staff-header">
        <h2>Staff Management</h2>
        <p>View and manage the staff members of your organization.</p>
    </div>

    <div class="staff-actions">
        <button
            type="button"
            id="staff-add-button"
            class="staff-btn staff-btn-primary"
            aria-controls="staff-add-form"
        >
            + Medewerker toevoegen
        </button>
    </div>

    <div id="staff-add-form" class="staff-card" hidden>
        <h3>Medewerker toevoegen</h3>
        <p>Vul de gegevens in. Opslaan is nog niet beschikbaar.</p>

        <div class="staff-form-field">
            <label for="staff-add-email">E-mailadres</label>
            <input
                type="email"
                id="staff-add-email"
                placeholder="naam@voorbeeld.nl"
                autocomplete="off"
            >
        </div>

        <div class="staff-form-field">
            <label for="staff-add-role">Organisatierol</label>
            <select id="staff-add-role">
                {% for role in data.roles|default([]) %}
                    <option value="{{ role.id }}">{{ role.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="staff-actions">
            <button
                type="button"
                class="staff-btn staff-btn-primary"
                disabled
                title="Opslaan wordt later beschikbaar"
            >
                Opslaan
            </button>

            <button
                type="button"
                id="staff-add-cancel"
                class="staff-btn staff-btn-secondary"
            >
                Annuleren
            </button>
        </div>
    </div>

    <div class="staff-search">
        <input
            type="search"
            id="staff-search"
            placeholder="Zoek op naam, e-mail of rol..."
            aria-label="Zoek medewerkers"
        >
    </div>

    {% if data.items is empty %}
        <div class="staff-empty">
            <p>No staff members found.</p>
        </div>
    {% else %}
        <div class="staff-container">
            {% for member in data.items %}
                <div class="staff-card">
                    <h3 class="staff-name">
                        {% if member.displayName %}
                            {{ member.displayName }}
                        {% else %}
                            {{ member.firstName }} {{ member.lastName }}
                        {% endif %}
                    </h3>

                    <p class="staff-email">{{ member.email }}</p>

                    <p class="staff-role">
                        Role: {{ member.role|default('No role') }}
                    </p>

                    <div class="staff-actions">
                        <button
                            type="button"
                            class="staff-btn staff-btn-secondary"
                            disabled
                            title="Rol wijzigen wordt later beschikbaar"
                        >
                            Rol wijzigen
                        </button>

                        <button
                            type="button"
                            class="staff-btn staff-btn-danger"
                            disabled
                            title="Verwijderen wordt later beschikbaar"
                        >
                            Verwijderen
                        </button>
                    </div>

                    <a class="staff-view-link" href="{{ path('org.viewStaff', {id: member.id}) }}">
                        View staff member
                    </a>
                </div>
            {% endfor %}
        </div>

        <div id="staff-no-results" class="staff-empty" hidden>
            <p>Geen medewerkers gevonden voor deze zoekopdracht.</p>
        </div>
    {% endif %}

    <section class="staff-roles">
        <h3>Beschikbare organisatierollen</h3>

        {% if data.roles is defined and data.roles is not empty %}
            <ul>
                {% for role in data.roles %}
                    <li>{{ role.name }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Er zijn nog geen organisatierollen beschikbaar.</p>
        {% endif %}
    </section>
{% endblock %}
