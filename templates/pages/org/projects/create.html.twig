{% extends 'layouts/org.base.html.twig' %}

{% block title %}Create project{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/create-project.css') }}">
{% endblock %}

{% block javascript %}
    <script src="{{ asset('assets/org/js/create-project.js') }}"></script>
{% endblock %}

{% block body %}

<h2>Create project</h2>

    {# Formulier voor het aanmaken van een nieuw project #}
    <form method="post">

    <div>
        <label for="name">Project name</label>
        <input type="text" id="name" name="name" required placeholder="Enter a project name">
        <p id="title-counter">0 characters</p>
    </div>

    <div>
        <label for="summary">Summary</label>
        <textarea id="summary" name="summary" required placeholder="Write a short summary of your project"></textarea>
        <p id="summary-counter">0 characters</p>
    </div>

    <div>
        <label for="description">Description</label>
        <textarea id="description" name="description" required placeholder="Describe your project in detail"></textarea>
        <p id="description-counter">0 characters</p>
    </div>

    <div>
        <label for="capacity">Capacity</label>
        <input value="0" type="number" id="capacity" name="capacity" min="0">
    </div>

    <div>
        <label for="visibility">Visibility</label>
        <select id="visibility" name="visibility" required>
            <option value="" selected disabled>Choose visibility</option>
            <option value="public">Public</option>
            <option value="private">Private</option>
        </select>
    </div>

    {# Project opslaan #}
    <div>
        <button type="submit" id="submit-btn">Create new project</button>
    </div>

</form>

{% endblock %}
