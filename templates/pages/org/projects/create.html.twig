{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Create project{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/create-project.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}
    <script src="{{ asset('assets/org/js/create-project.js') }}"></script>
{% endblock %}

{# Page content #}
{% block body %}
{% include  "/core/org/_modify-project-nav.html.twig" %}

<h2>Create project</h2>

<form method="post">

    <div>
        <label for="name">Project name</label>  
        <input type="text" id="name" name="name" required>
    </div>

    <div>
        <label for="summary">Summary</label>
        <textarea id="summary" name="summary" required></textarea>
        <p id="summary-counter">0 characters</p>
    </div>

    <div>
        <label for="description">Description</label>
        <textarea id="description" name="description" required></textarea>
        <p id="description-counter">0 characters</p>
    </div>

    <div>
        <label for="capacity">Capacity</label>
        <input value="0" type="number" id="capacity" name="capacity" min="0">
    </div>

    <div>
        <label for="visibility">Visibility</label>
        <select id="visibility" name="visibility" required>
            <option value="public">Public</option>
            <option value="private">Private</option>
        </select>
    </div>

    <div>
        <button type="submit" id="submit-btn">Create project</button>
    </div>

</form>
{% endblock %}