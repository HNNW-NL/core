{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Create project{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/create-project.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}
    <script src="{{ asset('assets/org/js/create-project.js') }}"></script>
{% endblock %}

{# Page content #}
{% block body %}

<h2>Create project</h2>

{# hele formulier omgebouwd naar symfony form, de form variabele moet nog uit de controller komen (taak 4). de id's hieronder heb ik niet veranderd, create-project.js zoekt ze op met getElementById #}
{{ form_start(form) }}

    {{ form_errors(form) }}

    {# omgebouwd naar het form veld title, zo heet het in de database #}
    <div>
        <label for="name">Project name</label>
        {{ form_widget(form.title, {'id': 'name', 'attr': {'placeholder': 'Enter a project name'}}) }}
        {{ form_errors(form.title) }}
        <p id="title-counter">0 characters</p>
    </div>

    <div>
        <label for="summary">Summary</label>
        {{ form_widget(form.summary, {'id': 'summary', 'attr': {'placeholder': 'Write a short summary of your project'}}) }}
        {{ form_errors(form.summary) }}
        <p id="summary-counter">0 characters</p>
    </div>

    <div>
        <label for="description">Description</label>
        {{ form_widget(form.description, {'id': 'description', 'attr': {'placeholder': 'Describe your project in detail'}}) }}
        {{ form_errors(form.description) }}
        <p id="description-counter">0 characters</p>
    </div>

    <div>
        <label for="capacity">Capacity</label>
        {{ form_widget(form.capacity, {'id': 'capacity', 'required': false, 'attr': {'min': 0}}) }}
        {{ form_errors(form.capacity) }}
    </div>

    {# select omgebouwd, keuzes moeten nu uit php komen: public, private, met "Choose visibility" als lege keuze #}
    <div>
        <label for="visibility">Visibility</label>
        {{ form_widget(form.visibility, {'id': 'visibility'}) }}
        {{ form_errors(form.visibility) }}
    </div>

    {# de include van components/status-autocomplete.html.twig vervangen door een form veld, dat was een gewone select met de statussen erin #}
    <div>
        <label for="status">Status</label>
        {{ form_widget(form.status, {'id': 'status'}) }}
        {{ form_errors(form.status) }}
    </div>

    {# Project opslaan #}
    <div>
        <button type="submit" id="submit-btn">Create new project</button>
    </div>

{{ form_end(form) }}

{% endblock %}
