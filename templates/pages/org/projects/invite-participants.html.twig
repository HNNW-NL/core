{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Invite project {{ id }} participants{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/org/css/invite-participants.css") }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}
    {{ parent() }}
    <script src="{{ asset('assets/org/js/invite-participants.js') }}" defer></script>
{% endblock %}

{# Page content #}
{% block body %}
    {% include "/core/org/_modify-project-nav.html.twig" %}
    <h2>Projects - Invite Participants</h2>
    <p>Organization panel - invite project ({{ id }}) participants page.</p>
    <div class="page-content">
        <div class="input-content">
            <label for="invite-input">Invite user</label>
            <input type="text" name="invite-input" id="invite-input">
        </div>

        <ul id="profile-list">
            <li class="profile-item active">Test</li>
        </ul>

        <div id="selected-list"></div>
    </div>

{% endblock %}
