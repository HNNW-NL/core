{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify project {{ id }} tasks{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/org/css/modify-tasks.css") }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}{{ importmap('app') }}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Projects - Modify Tasks</h2>
    <p>Organization panel - modify project ({{ id }}) tasks page.</p>
    {{ component("ModifyTasksComponent",{
        projectId: id
    }) }}
{% endblock %}
