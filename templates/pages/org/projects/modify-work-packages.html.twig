{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Werkpakketten beheren{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/org/css/work-packages.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}
<script src="{{ asset('assets/org/js/work-packages.js') }}"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <div class="wp-shell">
        <header class="wp-topbar">
            <div class="wp-topbar-inner">
                <div class="wp-brand">
                    <div class="wp-logo">H</div>
                    <div>
                        Het Nieuwe&sup2; Werken
                        <small>Projecten, mensen en taken</small>
                    </div>
                </div>

                <nav class="wp-nav" aria-label="Navigatie">
                    <span>Projecten</span>
                    <span>Organisatie</span>
                    <span>Notificaties</span>
                    <div class="wp-avatar">SK</div>
                </nav>
            </div>
        </header>

        <main class="wp-main">
            <section class="wp-title-row">
                <div>
                    <h1>Werkpakketten</h1>
                    <p>Maak werk behapbaar per project: beheer pakketten en taken in het organisatiepaneel, en laat projectleden hun eigen voortgang bijwerken in het projectoverzicht.</p>
                </div>

                <div class="wp-tabs" aria-label="Scherm kiezen">
                    <button type="button" aria-pressed="true" data-wp-view="wp-admin-view">Organisatiebeheer</button>
                    <button type="button" aria-pressed="false" data-wp-view="wp-project-view">Projectoverzicht</button>
                </div>
            </section>

            <section class="wp-toolbar">
                <select class="wp-select" aria-label="Project selecteren">
                    <option>Energietransitie dashboard</option>
                    <option>Datakwaliteit subsidies</option>
                    <option>Community pilots</option>
                </select>

                <input class="wp-input" type="search" placeholder="Zoek pakket of taak">

                <button class="wp-primary" type="button">+ Werkpakket</button>
            </section>

            <section id="wp-admin-view" class="wp-view active" aria-label="Organisatiebeheer">
                <div class="wp-layout">
                    <aside class="wp-sidebar" aria-label="Projecten">
                        <h3>Projecten</h3>

                        <a class="wp-project active" href="#">
                            <strong>Energietransitie dashboard</strong>
                            <span>8 leden - 4 pakketten</span>
                        </a>

                        <a class="wp-project" href="#">
                            <strong>Datakwaliteit subsidies</strong>
                            <span>5 leden - 3 pakketten</span>
                        </a>

                        <a class="wp-project" href="#">
                            <strong>Community pilots</strong>
                            <span>11 leden - 6 pakketten</span>
                        </a>
                    </aside>

                    <section class="wp-panel" aria-label="Werkpakketten beheren">
                        <div class="wp-panel-head">
                            <div>
                                <h2>Energietransitie dashboard</h2>
                                <p>Organisatiebeheerders kunnen pakketten aanmaken, taken toevoegen, leden koppelen en statussen beheren.</p>
                            </div>

                            <button class="wp-secondary" type="button">Projectleden beheren</button>
                        </div>

                        <div class="wp-stats" aria-label="Samenvatting">
                            <div class="wp-stat"><strong>4</strong><span>werkpakketten</span></div>
                            <div class="wp-stat"><strong>18</strong><span>taken totaal</span></div>
                            <div class="wp-stat"><strong>61%</strong><span>gemiddeld gereed</span></div>
                        </div>

                        <div class="wp-content-grid">
                            <div class="wp-package-grid">
                                <article class="wp-package">
                                    <div class="wp-package-head">
                                        <div>
                                            <h3>Inventarisatie databronnen</h3>
                                            <p>5 taken - deadline 18 juni</p>
                                        </div>
                                        <span class="wp-status busy">Bezig</span>
                                    </div>

                                    <div class="wp-progress" aria-label="60 procent gereed"><span style="width: 60%"></span></div>

                                    <div class="wp-task done">
                                        <span class="wp-check">✓</span>
                                        <div><strong>Bronnenlijst opschonen</strong><small>toegewezen aan Sara</small></div>
                                        <span class="wp-avatar-mini">S</span>
                                    </div>

                                    <div class="wp-task">
                                        <span class="wp-check"></span>
                                        <div><strong>API-koppelingen controleren</strong><small>toegewezen aan Jamal</small></div>
                                        <span class="wp-avatar-mini">J</span>
                                    </div>

                                    <div class="wp-task">
                                        <span class="wp-check"></span>
                                        <div><strong>Risico's noteren</strong><small>nog niet gekoppeld</small></div>
                                    </div>

                                    <div class="wp-actions">
                                        <button class="wp-ghost" type="button">+ Taak</button>
                                        <div class="wp-actions-group">
                                            <button class="wp-secondary" type="button">Bewerken</button>
                                            <button class="wp-ghost wp-danger" type="button">Verwijderen</button>
                                        </div>
                                    </div>
                                </article>

                                <article class="wp-package">
                                    <div class="wp-package-head">
                                        <div>
                                            <h3>UX validatie</h3>
                                            <p>4 taken - deadline 24 juni</p>
                                        </div>
                                        <span class="wp-status open">Open</span>
                                    </div>

                                    <div class="wp-progress" aria-label="25 procent gereed"><span style="width: 25%"></span></div>

                                    <div class="wp-task done">
                                        <span class="wp-check">✓</span>
                                        <div><strong>Testscript schrijven</strong><small>toegewezen aan Noor</small></div>
                                        <span class="wp-avatar-mini">N</span>
                                    </div>

                                    <div class="wp-task">
                                        <span class="wp-check"></span>
                                        <div><strong>Gebruikers uitnodigen</strong><small>nog niet gekoppeld</small></div>
                                    </div>

                                    <div class="wp-task">
                                        <span class="wp-check"></span>
                                        <div><strong>Feedback samenvatten</strong><small>nog niet gekoppeld</small></div>
                                    </div>

                                    <div class="wp-actions">
                                        <button class="wp-ghost" type="button">+ Taak</button>
                                        <div class="wp-actions-group">
                                            <button class="wp-secondary" type="button">Bewerken</button>
                                            <button class="wp-ghost wp-danger" type="button">Verwijderen</button>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <aside class="wp-form-panel">
                                <h3>Nieuw werkpakket</h3>

                                <form method="post" class="wp-form">
                                    <div class="wp-field">
                                        <label for="title">Titel</label>
                                        <input id="title" name="title" type="text" placeholder="Bijvoorbeeld: Inventarisatie databronnen" required>
                                    </div>

                                    <div class="wp-field">
                                        <label for="slug">Slug</label>
                                        <input id="slug" name="slug" type="text" placeholder="inventarisatie-databronnen" required>
                                    </div>

                                    <div class="wp-field">
                                        <label for="description">Omschrijving</label>
                                        <textarea id="description" name="description" placeholder="Beschrijf kort wat er binnen dit werkpakket moet gebeuren."></textarea>
                                    </div>

                                    <div class="wp-field">
                                        <label for="dueDate">Deadline</label>
                                        <input id="dueDate" name="dueDate" type="date">
                                    </div>

                                    <button class="wp-primary" type="submit">Werkpakket opslaan</button>
                                </form>
                            </aside>
                        </div>
                    </section>
                </div>
            </section>

            <section id="wp-project-view" class="wp-view" aria-label="Projectoverzicht">
                <div class="wp-public-layout">
                    <aside class="wp-summary" aria-label="Projectinformatie">
                        <div class="wp-summary-hero">
                            <h2>Energietransitie dashboard</h2>
                            <p>Gekoppelde projectleden kunnen hun taken bekijken, zichzelf koppelen en voortgang bijwerken.</p>
                            <div class="wp-hero-stats">
                                <div><strong>18</strong><span>taken</span></div>
                                <div><strong>61%</strong><span>gereed</span></div>
                            </div>
                        </div>

                        <h3 class="wp-summary-title">Projectleden</h3>
                        <div class="wp-member">
                            <span class="wp-member-avatar">S</span>
                            <span><strong>Sara Kok</strong><span>3 taken - 2 gereed</span></span>
                        </div>
                        <div class="wp-member">
                            <span class="wp-member-avatar">J</span>
                            <span><strong>Jamal Vermeer</strong><span>2 taken - bezig</span></span>
                        </div>
                        <div class="wp-member">
                            <span class="wp-member-avatar">N</span>
                            <span><strong>Noor Smit</strong><span>1 taak - gereed</span></span>
                        </div>
                    </aside>

                    <section class="wp-board" aria-label="Takenbord">
                        <div class="wp-column">
                            <div class="wp-column-head">
                                <h3>Open</h3>
                                <span class="wp-count">4</span>
                            </div>

                            <article class="wp-board-task">
                                <h4>Risico's noteren</h4>
                                <p>Werk de bekende afhankelijkheden en toegangsrisico's bij.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">Inventarisatie</span>
                                    <button class="wp-primary" type="button">Zelf nemen</button>
                                </div>
                            </article>

                            <article class="wp-board-task">
                                <h4>Gebruikers uitnodigen</h4>
                                <p>Nodig zes projectleden uit voor de validatieronde.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">UX validatie</span>
                                    <button class="wp-primary" type="button">Zelf nemen</button>
                                </div>
                            </article>
                        </div>

                        <div class="wp-column">
                            <div class="wp-column-head">
                                <h3>Bezig</h3>
                                <span class="wp-count">3</span>
                            </div>

                            <article class="wp-board-task busy">
                                <h4>API-koppelingen controleren</h4>
                                <p>Controleer bereikbaarheid en noteer ontbrekende rechten.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">Jamal</span>
                                    <button class="wp-primary" type="button">Gereed melden</button>
                                </div>
                            </article>

                            <article class="wp-board-task busy">
                                <h4>Feedback samenvatten</h4>
                                <p>Maak een samenvatting per thema voor de projectleider.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">Nog niemand</span>
                                    <button class="wp-primary" type="button">Zelf nemen</button>
                                </div>
                            </article>
                        </div>

                        <div class="wp-column">
                            <div class="wp-column-head">
                                <h3>Gereed</h3>
                                <span class="wp-count">11</span>
                            </div>

                            <article class="wp-board-task done">
                                <h4>Bronnenlijst opschonen</h4>
                                <p>Dubbele bronnen zijn verwijderd en eigenaars zijn gekoppeld.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">Sara</span>
                                    <button class="wp-secondary" type="button">Heropenen</button>
                                </div>
                            </article>

                            <article class="wp-board-task done">
                                <h4>Demo publiceren</h4>
                                <p>Prototype is beschikbaar voor de projectgroep.</p>
                                <div class="wp-board-footer">
                                    <span class="wp-tag">Jamal</span>
                                    <button class="wp-secondary" type="button">Heropenen</button>
                                </div>
                            </article>
                        </div>
                    </section>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
