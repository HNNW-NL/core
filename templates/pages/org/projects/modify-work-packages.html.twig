{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify project {{ id }} work packages{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Projects - Modify Work Packages</h2>
    <p>Organization panel - modify project ({{ id }}) work packages page.</p>

    {% for workPackage in workPackages %}
        <h3>{{ workPackage.title }}</h3>
        <p>{{ workPackage.description }}</p>
    {% else %}
        <p>No work packages found.</p>
    {% endfor %}
{% endblock %}
