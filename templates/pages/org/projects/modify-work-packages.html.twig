{% extends 'layouts/org.base.html.twig' %}

{% block title %}Modify project {{ id }} work packages{% endblock %}

{% block stylesheets %}{% endblock %}
{% block javascript %}{% endblock %}

{% block body %}
    <h2>Werkpakketten koppelen</h2>
    <p>Project ID: {{ id }}</p>

    <form method="post">
        <div>
            <label for="title">Titel</label>
            <input id="title" type="text" name="title" required>
        </div>

        <div>
            <label for="description">Beschrijving</label>
            <textarea id="description" name="description"></textarea>
        </div>

        <button type="submit">Werkpakket toevoegen</button>
    </form>

    <hr>

    <h3>Gekoppelde werkpakketten</h3>

    {% if workPackages is defined and workPackages is not empty %}
        {% for workPackage in workPackages %}
            <div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 15px;">
                <h4>{{ workPackage.title }}</h4>

                {% if workPackage.description is defined and workPackage.description is not empty %}
                    <p>{{ workPackage.description }}</p>
                {% else %}
                    <p>Geen beschrijving ingevuld.</p>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <p>Er zijn nog geen werkpakketten gekoppeld aan dit project.</p>
    {% endif %}
{% endblock %}