{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Publish project {{ id }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/org/css/modify-project.css') }}">
{% endblock %}

{% block javascript %}
<script src="{{ asset('assets/org/js/modify-project.js') }}"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="content content--single">
        <main id="main-content">
            <section class="modify-banner" aria-label="Modification notice">
                <p class="eyebrow">Modify</p>
                <h1>Modify Existing Project</h1>
                <p>Review the current values, then update only the fields you want to change.</p>
            </section>
            <form method="post" action="modify.php" enctype="multipart/form-data" novalidate>
                <div>
                    <label for="projectId">Project ID</label>
                    <input type="text" id="projectId" name="projectId" placeholder="e.g. 12" required autocomplete="off">
                </div>
                <section class="modify-meta" aria-label="Audit details">
                    <div>
                        <label for="lastModifiedBy">Last modified by</label>
                        <input type="text" id="lastModifiedBy" name="lastModifiedBy" value="admin@example.com" readonly>
                    </div>
                    <div>
                        <label for="lastModifiedAt">Current server time</label>
                        <input type="text" id="lastModifiedAt" name="lastModifiedAt" value="2026-06-10 15:30" readonly>
                    </div>
                </section>
                <div class="modify-grid">
                    <section class="modify-box" aria-label="Current details">
                        <h2>Current Details</h2>
                        <p class="field-help">Loaded from the database for this project ID.</p>
                        <div>
                            <label for="currentName">Current project name</label>
                            <input type="text" id="currentName" name="currentName" value="" readonly>
                        </div>
                        <div>
                            <label for="currentSummary">Current summary</label>
                            <textarea id="currentSummary" name="currentSummary" rows="3" readonly></textarea>
                        </div>
                        <div>
                            <label for="currentVisibility">Current visibility</label>
                            <input type="text" id="currentVisibility" name="currentVisibility" value="public" readonly>
                        </div>
                    </section>
                    <section class="modify-box" aria-label="New details">
                        <h2>Updated Details</h2>
                        <p class="field-help">Only changed values will be applied.</p>
                        <div>
                            <label for="name">Project name</label>
                            <input type="text" id="name" name="name" placeholder="Project name" required autocomplete="name">
                        </div>
                        <div>
                            <label for="summary">Summary</label>
                            <textarea id="summary" name="summary" rows="3" placeholder="Short project summary" required></textarea>
                        </div>
                        <div>
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="5" placeholder="Describe the project in detail" required></textarea>
                        </div>
                        <div>
                            <label for="visibility">New visibility</label>
                            <select id="visibility" name="visibility" required>
                                <option value="public">Public</option>
                                <option value="private">Private</option>
                                <option value="unlisted">Unlisted</option>
                            </select>
                        </div>
                        <div>
                            <label for="projectFile">Replace file (optional)</label>
                            <input type="file" id="projectFile" name="projectFile" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.zip,.js,.ts,.py,.java,.html,.css,.json,.md" aria-describedby="projectFileHelp">
                            <p id="projectFileHelp" class="field-help">Accepted formats: PDF, Word, images, ZIP, and common code files.</p>
                        </div>
                    </section>
                </div>
                <div class="modify-meta">
                    <div>
                        <label for="effectiveAt">Effective date and time</label>
                        <input type="datetime-local" id="effectiveAt" name="effectiveAt">
                    </div>
                    <div>
                        <label for="versionLabel">Version label</label>
                        <input type="text" id="versionLabel" name="versionLabel" placeholder="e.g. v1.2.1" autocomplete="off">
                    </div>
                </div>
                <div class="button-row">
                    <button type="submit" name="intent" value="modify">Modify project</button>
                    <button type="submit" name="intent" value="delete" class="button-danger" formnovalidate>Delete project</button>
                </div>
            </form>
        </main>
    </div>
    </body>
{% endblock %}
