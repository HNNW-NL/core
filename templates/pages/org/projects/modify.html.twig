{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify Project{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/org/css/modify-project.css') }}?v=20260625">
{% endblock %}

{% block javascript %}
<script src="{{ asset('assets/org/js/modify-project.js') }}?v=20260625"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <p id="unsavedBadge" class="unsaved-badge" role="status" aria-live="polite" hidden>Unsaved changes</p>
    <div class="content content--single">
        <main id="main-content">
            <section class="modify-banner reveal-up" aria-label="Modification notice" style="--reveal-delay: 60ms;">
                <p class="eyebrow">Modify</p>
                <h1>Modify Project</h1>
                <p>Update project details and save your changes.</p>
            </section>
            <form method="post" action="{{ path('org.modifyProject', { id: id }) }}" data-project='{{ project|default({})|json_encode|e('html_attr') }}' data-projects='{{ projects|default([])|json_encode|e('html_attr') }}' novalidate class="reveal-up" style="--reveal-delay: 140ms;">
                <p class="form-status" role="status" aria-live="polite" hidden></p>
                <input type="hidden" id="organisationId" name="organisation_id" value="{{ organisationId|default('') }}">
                <div class="modify-meta">
                    <div>
                        <label for="projectId">Choose project to modify</label>
                        <select id="projectId" name="project_id" required></select>
                    </div>
                </div>
                <fieldset class="modify-meta" aria-label="Audit details">
                    <legend>Audit details</legend>
                    <div>
                        <label for="lastModifiedBy">Last modified by</label>
                        <input type="text" id="lastModifiedBy" value="" readonly>
                    </div>
                    <div>
                        <label for="lastModifiedAt">Current local time</label>
                        <input type="text" id="lastModifiedAt" value="" readonly>
                    </div>
                </fieldset>
                <fieldset class="modify-fields reveal-up" aria-label="Project details" style="--reveal-delay: 220ms;">
                        <legend>Project details</legend>
                        <div>
                            <label for="name">Project title</label>
                            <input type="text" id="name" name="title" placeholder="Project title" required maxlength="120" autocomplete="off" aria-describedby="nameHelp">
                            <p id="nameHelp" class="field-help">Use a clear title (max 120 characters).</p>
                        </div>
                        <div>
                            <label for="summary">Summary</label>
                            <textarea id="summary" name="summary" rows="3" placeholder="Short project summary" required maxlength="280" autocomplete="off" spellcheck="true" aria-describedby="summaryHelp"></textarea>
                            <p id="summaryHelp" class="field-help">Short overview between 5 and 280 characters.</p>
                        </div>
                        <div>
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="5" placeholder="Describe the project in detail" required maxlength="500" autocomplete="off" spellcheck="true" aria-describedby="descriptionHelp"></textarea>
                            <p id="descriptionHelp" class="field-help">Detailed project description between 10 and 500 characters.</p>
                        </div>
                        <div>
                            <label for="visibility">Visibility</label>
                            <select id="visibility" name="visibility" required>
                                <option value="public">Public</option>
                                <option value="private">Private</option>
                                <option value="unlisted">Unlisted</option>
                            </select>
                        </div>
                        <div>
                            <label for="startDate">Start date</label>
                            <input type="date" id="startDate" name="startDate" required aria-describedby="startDateHelp">
                            <p id="startDateHelp" class="field-help">Required. The project start date.</p>
                        </div>
                        <div>
                            <label for="endDate">End date</label>
                            <input type="date" id="endDate" name="endDate" aria-describedby="endDateHelp">
                            <p id="endDateHelp" class="field-help">Optional. Must be on or after start date.</p>
                        </div>
                        <div>
                            <label for="capacity">Capacity</label>
                            <input type="number" id="capacity" name="capacity" min="1" max="500" step="1" inputmode="numeric" placeholder="Max participants" aria-describedby="capacityHelp">
                            <p id="capacityHelp" class="field-help">Optional. Enter a whole number from 1 to 500.</p>
                        </div>
                        <div>
                            <label for="statusId">Status</label>
                            <select id="statusId" name="status_name">
                                <option value="draft">Draft</option>
                                <option value="published">Published</option>
                                <option value="archived">Archived</option>
                            </select>
                        </div>
                </fieldset>
                <div class="button-row button-row--danger" role="group" aria-label="Danger actions">
                    <p class="danger-note">Danger zone: deleting a project is permanent.</p>
                    <button type="submit" name="intent" value="modify">Modify project</button>
                    <button type="submit" name="intent" value="delete" class="button-danger" formnovalidate>Delete project</button>
                </div>
            </form>
        </main>
    </div>
    <dialog id="deleteConfirmDialog" class="delete-dialog" aria-labelledby="deleteDialogTitle">
        <form method="dialog" class="delete-dialog__form">
            <h2 id="deleteDialogTitle">Confirm permanent deletion</h2>
            <p>Type <strong>DELETE</strong> to permanently remove this project. This cannot be undone.</p>
            <label for="deleteConfirmInput">Confirmation</label>
            <input id="deleteConfirmInput" type="text" autocomplete="off" placeholder="Type DELETE">
            <p id="deleteConfirmHint" class="field-help">Type DELETE (all caps) to enable the button.</p>
            <div class="delete-dialog__actions">
                <button value="cancel">Cancel</button>
                <button id="deleteConfirmButton" value="confirm" class="button-danger" disabled>Delete permanently</button>
            </div>
        </form>
    </dialog>
{% endblock %}
