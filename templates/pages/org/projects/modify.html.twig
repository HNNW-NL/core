{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Publish project {{ id }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/org/css/publish-project.css') }}">

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <body>
    <main>
        <h2>Publish Project</h2>
        <form method="post" action="/publish" enctype="multipart/form-data">
            <div>
                <label for="name">Project name</label>
                <input type="text" id="name" name="name" placeholder="My awesome project" required>
            </div>

            <div>
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" placeholder="What does your project do?" required></textarea>
            </div>

            <div>
                <label for="visibility">Visibility</label>
                <select id="visibility" name="visibility" required>
                    <option value="public">Public</option>
                    <option value="private">Private</option>
                    <option value="unlisted">Unlisted</option>
                </select>
            </div>

            <div>
                <button type="submit">Publish project</button>
            </div>
        </form>
    </main>
    </body>
{% endblock %}
