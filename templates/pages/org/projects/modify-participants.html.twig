{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify project {{ id }} participants{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Projects - Modify Participants</h2>
    <p>Organization panel - modify project ({{ id }}) participants page.</p>
    <form method="POST">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Start date</th>
                </tr>
            </thead>
            <tbody>
               <tr>
                   <td>username</td>
                   <td>
                       <select>
                               <option>Role</option>
                       </select>
                   </td>
                   <td>Join Date</td>
               </tr>
            </tbody>
        </table>
        <input type="submit" value="Submit Changes">
    </form>
{% endblock %}
