{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Organisatiepaneel{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h1>Mijn organisaties</h1>

    {% if organisaties|length > 1 %}
        <form method="get" action="{{ path('org.home') }}">
            <label for="organisation">Kies je organisatie:</label>

            <select name="organisation" id="organisation">
                {% for organisatie in organisaties %}
                    <option value="{{ organisatie.id }}"
                        {% if actieveOrganisatie.id == organisatie.id %}selected{% endif %}>
                        {{ organisatie.naam }}
                    </option>
                {% endfor %}
            </select>

            <button type="submit">Wisselen</button>
        </form>
    {% endif %}

    {% if actieveOrganisatie %}
        <section>
            <h2>{{ actieveOrganisatie.naam }}</h2>

            <p>Aantal projecten: {{ actieveOrganisatie.aantalProjecten }}</p>
            <p>Niet-beoordeelde aanvragen: {{ actieveOrganisatie.aantalNietBeoordeeld }}</p>

            <h3>Mijn rollen</h3>

            <ul>
                {% for rol in actieveOrganisatie.rollen %}
                    <li>{{ rol }}</li>
                {% else %}
                    <li>Geen rol gevonden</li>
                {% endfor %}
            </ul>
        </section>

        <nav aria-label="Organisatienavigatie">
            <h2>Beheer</h2>

            <ul>
                {% if actieveOrganisatie.magProjectenBeheren|default(false) %}
                    <li>
                        <a href="{{ path('org.projects', {'organisation': actieveOrganisatie.id}) }}">
                            Projecten
                        </a>
                    </li>
                {% endif %}

                <li>
                    <a href="{{ path('org.jobs.home') }}">Vacatures</a>
                </li>

                <li>
                    <a href="{{ path('org.events.home') }}">Evenementen</a>
                </li>

                {% if actieveOrganisatie.magMedewerkersBeheren|default(false) %}
                    <li>
                        <a href="{{ path('org.staff', {'organisation': actieveOrganisatie.id}) }}">
                            Medewerkers
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% else %}
        <p>Je bent nog niet gekoppeld aan een organisatie.</p>
    {% endif %}
{% endblock %}
