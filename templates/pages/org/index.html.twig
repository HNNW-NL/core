<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>Organisatiedashboard</title>
</head>
<body>
    <main>
    <h1>Mijn organisaties</h1>
        {% if organisaties|length > 1 %}
    <form method="get" action="{{ path('org.home') }}">
        <label for="organisation">Kies je organisatie:</label>

        <select name="organisation" id="organisation">
            {% for organisatie in organisaties %}
                <option value="{{ organisatie.id }}"
                    {% if actieveOrganisatie.id == organisatie.id %}
                        selected
                    {% endif %}
                >
                    {{ organisatie.naam }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Wisselen</button>
    </form>
{% endif %}
    {% if actieveOrganisatie %}
            <section>
                <h2>{{ actieveOrganisatie.naam }}</h2>
            <p>Aantal projecten: {{ actieveOrganisatie.aantalProjecten }}</p>
            <p>Niet-beoordeelde aanvragen: {{ actieveOrganisatie.aantalNietBeoordeeld }}</p>
                <h3>Mijn rollen</h3>
                <ul>
                    {% for rol in actieveOrganisatie.rollen %}
                        <li>{{ rol }}</li>
                    {% else %}
                        <li>Geen rol gevonden</li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <p>Je bent nog niet gekoppeld
               aan een organisatie.</p>
        {% endif %}

{% if organisaties is not empty %}
    <nav aria-label="Organisatienavigatie">
        <h2>Beheer</h2>

        <ul>
            <li>
                <a href="{{ path('org.projects') }}">
                    Projecten
                </a>
            </li>

            <li>
                <a href="{{ path('org.staff') }}">
                    Medewerkers
                </a>
            </li>

            <li>
                Events (nog niet beschikbaar)
            </li>
        </ul>
    </nav>
{% endif %}
    </main>
</body>
</html>
