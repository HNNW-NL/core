{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Projects{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="../../../assets/org/css/projects-view.css">
{% endblock %}

{# JavaScript #}
{% block javascript %}
    <script src="../../../assets/org/js/projects-view.js"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <div class="projects-main">
        <h2>Projects - Overview</h2>
        <p>Organization panel - projects overview page.</p>

        <div class="projects-current-text"><h2>Current projects</h2></div>
        <div class="search-bar-projects">
            <input type="text" id="search-text" placeholder="Search projects...">
            <button id="search-button">Search</button>
        </div>

        <div class="projects-container">
            {% set projects = org_projects() %}
            {% if projects is empty %}
                <div>No projects found.</div>
            {% else %}
                {% for project in projects %}
                    <div class="project-card" data-slug="{{ project.slug }}">{{ project.title }}</div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
