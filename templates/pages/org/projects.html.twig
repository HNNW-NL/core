{% extends 'layouts/org.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Projects{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="../../../assets/org/css/projects-view.css">
{% endblock %}

{# JavaScript #}
{% block javascript %}
    <script src="../../../assets/org/js/projects-view.js"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <div class="projects-main">
        <h2>Projects - Overview</h2>
        <p>Organization panel - projects overview page.</p>

        <div class="projects-current-text"><h2>Current projects</h2></div>
        <div class="search-bar-projects">
            <input type="text" id="search-text" placeholder="Search projects...">
            <button id="search-button">Search</button>
        </div>

        {% set page = (app.request.query.get('page')|default(1)) + 0 %}
        {% set q = app.request.query.get('q')|default('') %}
        {% set data = org_projects(page, 8, q) %}
        {% set projects = data.items %}
        <div class="projects-container">
            {% if projects is empty %}
                <div>No projects found.</div>
            {% else %}
                {% for project in projects %}
                    <div class="project-card" data-slug="{{ project.slug }}">{{ project.title }}</div>
                {% endfor %}
            {% endif %}
        </div>

        {# Pagination controls (simple) #}
        {% set p = data.pagination %}
        <div class="projects-pagination">
            <div>Page {{ p.current_page }} of {{ p.total_pages }}</div>
            <div class="projects-pagination-controls">
                {% set base = '?page=' %}
                {% if q is not empty %}
                    {% set qparam = '&q=' ~ q|url_encode %}
                {% else %}
                    {% set qparam = '' %}
                {% endif %}

                {% if p.current_page > 1 %}
                    <a href="{{ base }}{{ p.current_page - 1 }}{{ qparam }}">Prev</a>
                {% else %}
                    <span class="disabled">Prev</span>
                {% endif %}

                {% for i in 1..p.total_pages %}
                    {% if i == p.current_page %}
                        <strong>{{ i }}</strong>
                    {% else %}
                        <a href="{{ base }}{{ i }}{{ qparam }}">{{ i }}</a>
                    {% endif %}
                {% endfor %}

                {% if p.current_page < p.total_pages %}
                    <a href="{{ base }}{{ p.current_page + 1 }}{{ qparam }}">Next</a>
                {% else %}
                    <span class="disabled">Next</span>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
