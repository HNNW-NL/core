{% extends 'layouts/org.base.html.twig' %}

{% block title %}Account: {{ user.id }}{% endblock %}

{% block body %}
    <h2>Account #{{ user.id }}</h2>

    <dl class="details">
        <dt>First name</dt><dd>{{ user.firstName }}</dd>
        <dt>Last name</dt><dd>{{ user.lastName }}</dd>
        <dt>Email</dt><dd>{{ user.email }}</dd>
        <dt>Active</dt><dd>{{ user.active ? 'Yes' : 'No' }}</dd>
        {% if user.createdAt is defined %}
            <dt>Created</dt><dd>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</dd>
        {% endif %}
    </dl>

    <p>
        <a href="{{ path('org_account_edit', {'id': user.id}) }}">Edit</a>
        <a href="{{ path('org_accounts') }}">Back to list</a>
    </p>
{% endblock %}
