<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organisatie wijzigen</title>
</head>
<body>

<h2>Organisatie wijzigen</h2>

<form method="post">

    <label for="naam">Naam organisatie:</label>
    <input type="text" id="naam" name="naam" required
           value="{{ organisatie.naam }}"><br>

    <label for="adres">Adres:</label>
    <input type="text" id="adres" name="adres" required
           value="{{ organisatie.adres }}"><br>

    <label for="stad">Stad:</label>
    <input type="text" id="stad" name="stad" required
           value="{{ organisatie.stad }}"><br>

    <button type="submit">Wijzig</button>

</form>

<br><br>
<a href="{{ path('organisatie_index') }}">Terug naar overzicht</a>

</body>
</html>
