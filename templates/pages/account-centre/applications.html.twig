{% extends 'layouts/ac.base.html.twig' %}
{% block title %}Mijn aanmeldingen{% endblock %}
{% block body %}
<div id="account-centre-container">
    <a class="btn-back" href="{{ path('account.home') }}">Terug naar mijn account</a>
    <div class="dashboard-header"><h1>{{ pending_only ? 'Lopende aanmeldingen' : 'Mijn aanmeldingen' }}</h1></div>
    {% if pending_only %}<p><a href="{{ path('account.applications') }}">Alle eigen aanmeldingen bekijken</a></p>{% endif %}
    <div id="account-applications" class="account-grid">
        {% for application in records.items %}
            <article class="account-card">
                <h2>{{ application.project.title }}</h2><p>Status: {{ application.status.name }}</p>
                {% if application.status.scope|lower == 'projectapplication' and application.status.name|lower in pending_statuses %}
                    <form action="{{ path('account.applications_cancel', {id: application.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_application' ~ application.id) }}">
                        <button type="submit" class="btn-card-cancel">Aanmelding annuleren</button>
                    </form>
                {% endif %}
            </article>
        {% else %}<p class="account-card">Je hebt geen aanmeldingen in dit overzicht.</p>{% endfor %}
    </div>
    {% include 'pages/account-centre/_pagination.html.twig' with {records: records, pagination_route: 'account.applications', pagination_params: pending_only ? {pending: 1} : {}} %}
</div>
{% endblock %}
