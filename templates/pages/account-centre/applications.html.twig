{% extends 'layouts/ac.base.html.twig' %}
{% block title %}Mijn aanmeldingen{% endblock %}
{% block body %}
<section id="account-centre-container" class="account-records">
    <header class="dashboard-header"><h1>{{ pending_only ? 'Lopende aanmeldingen' : 'Mijn aanmeldingen' }}</h1><p>{{ records.total }} {{ pending_only ? 'lopende aanmeldingen' : 'aanmeldingen' }} voor projecten.</p></header>
    <p>{% if pending_only %}<a href="{{ path('account.applications') }}">Alle aanmeldingen bekijken</a>{% else %}<a href="{{ path('account.applications', {status: 'pending'}) }}">Alleen lopende aanmeldingen</a>{% endif %}</p>
    {% for message in app.flashes('success') %}<p class="alert alert-success" role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p class="alert alert-error" role="alert">{{ message }}</p>{% endfor %}
    <div class="account-grid">
    {% for application in records.items %}
        <article class="account-card"><div><h2>{{ application.project.title }}</h2><p>Status: <strong>{{ application.status.name }}</strong></p></div>
            {% if application.status.name|lower in pending_statuses %}
                <form action="{{ path('account.applications_cancel', {id: application.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_application' ~ application.id) }}">
                    <button class="btn-card-cancel" type="submit">Aanmelding annuleren</button>
                </form>
            {% endif %}
        </article>
    {% else %}
        <p class="account-empty-records">Je hebt geen {{ pending_only ? 'lopende ' : '' }}aanmeldingen. <a href="{{ path('main.projects.home') }}">Ontdek projecten</a>.</p>
    {% endfor %}
    </div>
    {% include 'pages/account-centre/_pagination.html.twig' with {pagination_parameters: pending_only ? {status: 'pending'} : {}} %}
</section>
{% endblock %}
