{% extends 'layouts/ac.base.html.twig' %}
{% block title %}Mijn aanmeldingen{% endblock %}
{% block body %}
<h1>Mijn aanmeldingen</h1>
{% for type in ['success', 'info', 'error'] %}
    {% for message in app.flashes(type) %}<p role="status">{{ message }}</p>{% endfor %}
{% endfor %}
<form method="get">
    <label for="status">Status</label>
    <select id="status" name="status">
        <option value="">Alle statussen</option>
        {% for status in ['Ingediend', 'Geaccepteerd', 'Afgewezen', 'Ingetrokken'] %}
            <option{% if filter == status %} selected{% endif %}>{{ status }}</option>
        {% endfor %}
    </select>
    <button type="submit">Filteren</button>
    <a href="{{ path('account.applications') }}">Filters wissen</a>
</form>
{% for row in rows %}
    {% set application = row.application %}
    <article class="account-card">
        <h2><a href="{{ path('main.projects.detail', {slug: application.project.slug}) }}">{{ application.project.title }}</a></h2>
        <p>{{ application.project.ownerOrganisation.name|default('') }}</p>
        <p>Aangemeld op {{ application.createdAt|date('d-m-Y H:i') }}</p>
        <p>Status {{ row.label }}</p>
        {% if row.withdrawable %}
            <form method="post" action="{{ path('account.applications_cancel', {id: application.id ~ ''}) }}" onsubmit="return confirm('Wil je deze aanvraag intrekken?')">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_application' ~ application.id) }}">
                <button type="submit">Aanvraag intrekken</button>
            </form>
        {% endif %}
    </article>
{% else %}
    <p>Geen aanmeldingen gevonden.</p>
{% endfor %}
{% if pagination.pages > 1 %}
    <nav aria-label="Paginering aanvragen">
        {% if pagination.page > 1 %}<a href="{{ path('account.applications', {status: filter, page: pagination.page - 1}) }}">Vorige</a>{% endif %}
        <span>Pagina {{ pagination.page }} van {{ pagination.pages }}</span>
        {% if pagination.page < pagination.pages %}<a href="{{ path('account.applications', {status: filter, page: pagination.page + 1}) }}">Volgende</a>{% endif %}
    </nav>
{% endif %}
{% endblock %}
