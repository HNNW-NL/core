{% extends 'layouts/ac.base.html.twig' %}

{% block title %}Mijn Aanmeldingen | Account Centre{% endblock %}

{% block body %}
    <div id="account-centre-container">
{% for type in ['success', 'info', 'error'] %}{% for message in app.flashes(type) %}<p role="status">{{ message }}</p>{% endfor %}{% endfor %}

        <div class="dashboard-header">
            <a href="/account" class="btn-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Terug naar Account
            </a>

            <h1>Mijn Aanmeldingen</h1>
            <p>Bekijk de status van je lopende aanmeldingen voor projecten.</p>
        </div>

<form method="get">
    <label for="status">Status</label>
    <select id="status" name="status">
        <option value="">Alle statussen</option>
        {% for status in ['Ingediend', 'Geaccepteerd', 'Afgewezen', 'Ingetrokken'] %}
            <option{% if filter == status %} selected{% endif %}>{{ status }}</option>
        {% endfor %}
    </select>
    <button type="submit">Filteren</button>
    <a href="{{ path('account.applications') }}">Filters wissen</a>
</form>
        <div class="account-grid">
            {% if profile %}

                {% set has_active_applications = false %}

                {% for row in rows %}
                    {% set application = row.application %}

                        {% set has_active_applications = true %}
                        <div class="account-card">
                            <div class="account-card-content">
                                <h3>{% if row.projectSlug %}<a href="{{ path('main.projects.detail', {slug: row.projectSlug}) }}">{{ application.project.title|default('Naamloze aanmelding') }}</a>{% else %}{{ application.project.title|default('Naamloze aanmelding') }}{% endif %}</h3>
                                <p>{{ application.project.ownerOrganisation.name|default('') }}</p>
                                <p>Aangemeld op {{ application.createdAt|date('d-m-Y H:i') }}</p>


                                <p>Status: <strong>{{ row.label }}</strong></p>
                            </div>

                            {% if row.withdrawable %}
                                <form action="{{ path('account.applications_cancel', {'id': application.id}) }}" method="POST" data-controller="confirm" data-action="submit->confirm#submit" data-confirm-message-value="Weet je zeker dat je deze aanmelding wilt annuleren?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_application' ~ application.id) }}">
                                    <button type="submit" class="btn-card-cancel">Aanmelding annuleren</button>
                                </form>
                            {% endif %}
                        </div>
                {% endfor %}

                {% if rows|length == 0 or not has_active_applications %}
                    <div class="account-card account-card-empty">
                        <h3>Geen aanmeldingen</h3>
                        <p>Je hebt je op dit moment nog niet aangemeld voor een project.</p>
                    </div>
                {% endif %}

            {% endif %}
        </div>

    </div>
{% if pagination.pages > 1 %}
    <nav aria-label="Paginering aanvragen">
        {% if pagination.page > 1 %}<a href="{{ path('account.applications', {status: filter, page: pagination.page - 1}) }}">Vorige</a>{% endif %}
        <span>Pagina {{ pagination.page }} van {{ pagination.pages }}</span>
        {% if pagination.page < pagination.pages %}<a href="{{ path('account.applications', {status: filter, page: pagination.page + 1}) }}">Volgende</a>{% endif %}
    </nav>
{% endif %}

{% endblock %}
