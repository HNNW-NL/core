{% extends 'layouts/ac.base.html.twig' %}

{% block title %}Mijn Beschikbaarheid{% endblock %}

{% block body %}
    <div id="account-centre-container">

        <a href="/account" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Terug naar Account
        </a>

        <div class="dashboard-header">
            <h1>Mijn Beschikbaarheid</h1>
            <p>Hier zie je je wekelijkse beschikbaarheid per dag.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'error' : 'success' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# het formulier om beschikbaarheid op te slaan is hier weggehaald, dat komt uit pr #3 van team 4 #}

        {# HISTORIE OVERZICHT #}
        <div class="tidycal-container history-container">
            <div class="tidycal-header">
                <span class="tidycal-title">Opgeslagen beschikbaarheidsschema's</span>
            </div>
            <div class="table-container">
                <table class="custom-table">
                    <thead>
                    <tr>
                        <th>Dag</th>
                        <th>Tijd</th>
                        <th>Geldig vanaf</th>
                        <th class="text-right">Actie</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for availability in availabilities %}
                        <tr>
                            {# de kolommen komen nu rechtstreeks uit de availability entity #}
                            <td>
                                <strong>{{ availability.dayOfWeek }}</strong>
                            </td>
                            <td>{{ availability.startTime|date('H:i') }} - {{ availability.endTime|date('H:i') }}</td>
                            <td>{{ availability.validFrom|date('d-m-Y') }}</td>
                            <td class="text-right">
                                <form action="{{ path('account.availability_delete', {'id': availability.id}) }}" method="POST" onsubmit="return confirm('Weet je zeker dat je dit schema wilt verwijderen?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_availability' ~ availability.id) }}">
                                    <button type="submit" class="btn-card-cancel">Verwijderen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">Nog geen beschikbaarheid opgeslagen.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
