{% extends 'layouts/ac.base.html.twig' %}

{% block title %}Mijn Beschikbaarheid{% endblock %}

{% block body %}
    <div id="account-centre-container">

        <a href="/account" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Terug naar Account
        </a>

        <div class="dashboard-header">
            <h1>Mijn Beschikbaarheid</h1>
            <p>Stel je wekelijkse uren in per dag.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'error' : 'success' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# hele formulier omgebouwd naar symfony form, de form variabele moet nog uit de controller komen (taak 4) #}
        {{ form_start(form, {'action': path('account.availability'), 'attr': {'id': 'tidycal-schedule-form'}}) }}
            {{ form_errors(form) }}

            {{ form_widget(form.availabilityType) }}
            <div class="form-group-row">
                <div class="form-group">
                    {{ form_row(form.hoursPerWeek, {'label': 'Uren per week', 'id': 'calculated_hours', 'attr': {'min': 0, 'max': 168}}) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.startDate, {'label': 'Ingangsdatum'}) }}
                </div>
            </div>

            {# WEEKELIJKSE DIENSTREGELING CONTAINER #}
            <div class="tidycal-container">
                <div class="tidycal-header">
                    <span class="tidycal-title">Beschikbaarheid:</span>
                </div>

                {# de 7 dagen omgebouwd naar form velden, dit weekrooster past nog niet in de database (taak 3) #}
                <div class="tidycal-days-list">
                    {% for key, day in defaultSchedule %}
                        <div class="day-row" data-day="{{ key }}">

                            <div class="day-meta">
                                <label class="switch">
                                    {{ form_widget(form.daysConfig[key].enabled, {'attr': {'class': 'day-toggle', 'aria-labelledby': 'day-name-' ~ key}}) }}
                                    <span class="slider"></span>
                                </label>
                                <span class="day-name" id="day-name-{{ key }}">
                                    {% if day.name == 'Monday' %}Maandag
                                    {% elseif day.name == 'Tuesday' %}Dinsdag
                                    {% elseif day.name == 'Wednesday' %}Woensdag
                                    {% elseif day.name == 'Thursday' %}Donderdag
                                    {% elseif day.name == 'Friday' %}Vrijdag
                                    {% elseif day.name == 'Saturday' %}Zaterdag
                                    {% elseif day.name == 'Sunday' %}Zondag{% endif %}
                                </span>
                            </div>

                            <div class="time-controls-container">
                                <div class="time-inputs">
                                    <div class="availability-time-field">
                                        <label for="{{ form.daysConfig[key].start.vars.id }}">Begintijd</label>
                                        {{ form_widget(form.daysConfig[key].start, {'attr': {'aria-describedby': 'day-name-' ~ key}}) }}
                                        {{ form_errors(form.daysConfig[key].start) }}
                                    </div>
                                    <span>-</span>
                                    <div class="availability-time-field">
                                        <label for="{{ form.daysConfig[key].end.vars.id }}">Eindtijd</label>
                                        {{ form_widget(form.daysConfig[key].end, {'attr': {'aria-describedby': 'day-name-' ~ key}}) }}
                                        {{ form_errors(form.daysConfig[key].end) }}
                                    </div>
                                </div>
                                <div class="unavailable-text">
                                    Niet beschikbaar op {% if day.name == 'Monday' %}maandag{% elseif day.name == 'Tuesday' %}dinsdag{% elseif day.name == 'Wednesday' %}woensdag{% elseif day.name == 'Thursday' %}donderdag{% elseif day.name == 'Friday' %}vrijdag{% elseif day.name == 'Saturday' %}zaterdag{% elseif day.name == 'Sunday' %}zondag{% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="form-actions-container">
                <button type="submit" class="btn-primary">Schema Opslaan</button>
            </div>
        {{ form_end(form) }}

        {# HISTORIE OVERZICHT #}
        <div class="tidycal-container history-container">
            <div class="tidycal-header">
                <span class="tidycal-title">Opgeslagen beschikbaarheidsschema's</span>
            </div>
            <div class="table-container">
                <table class="custom-table dark-table">
                    <thead>
                    <tr>
                        <th>Actieve Dagen</th>
                        <th>Aangemaakt op</th>
                        <th class="text-right">Actie</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for availability in availabilities %}
                        <tr>
                            <td>
                                <strong class="text-light">{{ availability.daysSummary }}</strong>
                            </td>
                            <td class="text-light">{{ availability.startDate|date('d-m-Y') }}</td>
                            <td class="text-right">
                                <form action="{{ path('account.availability_delete', {'id': availability.id}) }}" method="POST" onsubmit="return confirm('Weet je zeker dat je dit schema wilt verwijderen?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_availability' ~ availability.id) }}">
                                    <button type="submit" class="btn-card-cancel">Verwijderen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted-dark">Nog geen schema's opgeslagen.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
