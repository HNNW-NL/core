{% extends 'layouts/ac.base.html.twig' %}

{% block title %}Mijn Werkervaring{% endblock %}

{% block stylesheets %}{% endblock %}

{% block javascript %}{% endblock %}

{% block body %}
    <div id="account-centre-container">

        <a href="{{ path('account.home') }}" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Mijn Werkervaring</h1>
            <p>Beheer hier jouw professionele loopbaan, rollen en werkgeschiedenis.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="account-grid">
            <h3 class="account-grid-title">Toegevoegde Ervaringen</h3>

            {% if experiences is empty %}
                <div class="account-card account-card-empty">
                    <div class="account-card-content">
                        <p>Je hebt nog geen werkervaring toegevoegd.</p>
                    </div>
                </div>
            {% else %}
                {% for experience in experiences %}
                    <div class="account-card">
                        <div class="account-card-content">
                            <h3>{{ experience.jobTitle }}</h3>
                            <p class="account-card-meta">
                                <strong>Bedrijf:</strong> {{ experience.organisationName }} |
                                <strong>Type:</strong> {{ experience.employmentType|default('Onbekend') }} |
                                <strong>Periode:</strong>
                                {{ experience.startDate|date('M Y') }} -
                                {% if experience.isCurrent %}
                                    <em>Heden</em>
                                {% else %}
                                    {{ experience.endDate ? experience.endDate|date('M Y') : 'Onbekend' }}
                                {% endif %}
                            </p>
                            {% if experience.description %}
                                <p class="account-card-description">
                                    {{ experience.description }}
                                </p>
                            {% endif %}
                        </div>

                        <form action="{{ path('account.experience_delete', {'id': experience.id}) }}" method="POST" onsubmit="return confirm('Weet je zeker dat je deze ervaring wilt verwijderen?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_experience' ~ experience.id) }}">
                            <button type="submit" class="btn-card-cancel">Verwijderen</button>
                        </form>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <div class="form-divider-row"></div>

        <div class="account-form-container">
            <div class="form-internal-header">
                <h2>Nieuwe Werkervaring Toevoegen</h2>
                <p>Vul de onderstaande velden in om een werkgever of project toe te voegen aan je profiel.</p>
            </div>

            {# hele formulier omgebouwd naar symfony form, de form variabele moet nog uit de controller komen (taak 4) #}
            {{ form_start(form, {'action': path('account.experience'), 'attr': {'class': 'account-form'}}) }}

                {{ form_errors(form) }}

                <div class="form-group">
                    <label for="{{ form.jobTitle.vars.id }}">Titel / Functietitel</label>
                    {{ form_widget(form.jobTitle, {'attr': {'placeholder': 'bijv. Full Stack Developer'}}) }}
                    {{ form_errors(form.jobTitle) }}
                </div>

                {# select omgebouwd, keuzes moeten nu uit php komen: vast, tijdelijk, oproep, uitzend_detachering, zzp_freelance, stage_afstuderen, payroll. dit veld wordt nog niet opgeslagen (taak 3) #}
                <div class="form-group">
                    <label for="{{ form.employmentType.vars.id }}">Type Dienstverband</label>
                    {{ form_widget(form.employmentType) }}
                    {{ form_errors(form.employmentType) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.organisationName.vars.id }}">Bedrijf of Organisatie</label>
                    {{ form_widget(form.organisationName, {'attr': {'placeholder': 'bijv. Uw Bedrijf B.V.'}}) }}
                    {{ form_errors(form.organisationName) }}
                </div>

                <div class="form-group checkbox-group">
                    {{ form_widget(form.isCurrent) }}
                    <label for="{{ form.isCurrent.vars.id }}">Ik ben momenteel werkzaam in deze functie</label>
                </div>

                <div class="form-group-row">
                    <div class="form-group">
                        <label for="{{ form.startDate.vars.id }}">Startdatum</label>
                        {{ form_widget(form.startDate) }}
                        {{ form_errors(form.startDate) }}
                    </div>

                    <div class="form-group">
                        <label for="{{ form.endDate.vars.id }}">Einddatum</label>
                        {{ form_widget(form.endDate, {'required': false}) }}
                        {{ form_errors(form.endDate) }}
                    </div>
                </div>

                {# allebei omgebouwd, keuzes voor locatie type moeten nu uit php komen: onsite, hybrid, remote. deze velden worden nog niet opgeslagen (taak 3) #}
                <div class="form-group-row">
                    <div class="form-group">
                        <label for="{{ form.location.vars.id }}">Locatie</label>
                        {{ form_widget(form.location, {'required': false, 'attr': {'placeholder': 'bijv. Amsterdam, NL'}}) }}
                        {{ form_errors(form.location) }}
                    </div>

                    <div class="form-group">
                        <label for="{{ form.locationType.vars.id }}">Locatie type</label>
                        {{ form_widget(form.locationType, {'required': false}) }}
                        {{ form_errors(form.locationType) }}
                    </div>
                </div>

                {# omgebouwd naar een form veld, wordt nog niet opgeslagen (taak 3) #}
                <div class="form-group">
                    <label for="{{ form.profileHeadline.vars.id }}">Profiel headline <span class="form-note">(Dit update je user profile tagline)</span></label>
                    {{ form_widget(form.profileHeadline, {'required': false, 'attr': {'placeholder': 'bijv. Ervaren Developer gespecialiseerd in Symfony'}}) }}
                    {{ form_errors(form.profileHeadline) }}
                </div>

                {# select omgebouwd, keuzes moeten nu uit php komen: hier, linkedin, website_organisatie, indeed, andere_vacaturesites, aanbeveling, recruiter, anders. dit veld wordt nog niet opgeslagen (taak 3) #}
                <div class="form-group">
                    <label for="{{ form.vacancySource.vars.id }}">Waar heb je de vacature gevonden?</label>
                    {{ form_widget(form.vacancySource, {'required': false}) }}
                    {{ form_errors(form.vacancySource) }}
                </div>

                {# omgebouwd naar een form veld, wordt nog niet opgeslagen (taak 3) #}
                <div class="form-group">
                    <label for="{{ form.skills.vars.id }}">Skills <span class="form-note">(Gescheiden door komma's)</span></label>
                    {{ form_widget(form.skills, {'required': false, 'attr': {'placeholder': 'bijv. PHP, Symfony, Git, SQL'}}) }}
                    {{ form_errors(form.skills) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.description.vars.id }}">Beschrijving</label>
                    {{ form_widget(form.description, {'required': false, 'attr': {'rows': 5, 'placeholder': 'Vertel kort wat je verantwoordelijkheden en prestaties waren...'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="form-actions-row">
                    <button type="submit">Ervaring Opslaan</button>
                    <a href="{{ path('account.home') }}" class="btn-cancel">Annuleren</a>
                </div>
            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
