{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify Account{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container">

        <a href="{{ path('account.home') }}" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Profiel Wijzigen</h1>
            <p>Wijzig hier uw gegevens en uw zichtbaarheid van de profiel.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="account-flash-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="account-form-container">
            <div class="form-internal-header">
                <h2>Wijzig je profielgegevens</h2>
                <p>Pas je gegevens aan om je profiel up-to-date te houden - je gegevens blijven veilig.</p>
            </div>

            {# hele formulier omgebouwd naar symfony form, de form variabele moet nog uit de controller komen (taak 4) #}
            {{ form_start(form, {'action': path('account.modify')}) }}

                {{ form_errors(form) }}

                <div class="form-group">
                    <label for="{{ form.username.vars.id }}">Gebruikersnaam</label>
                    {{ form_widget(form.username, {'attr': {'placeholder': 'Kies een gebruikersnaam'}}) }}
                    {{ form_errors(form.username) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.firstName.vars.id }}">Voornaam</label>
                    {{ form_widget(form.firstName, {'attr': {'placeholder': 'Voornaam'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.lastName.vars.id }}">Achternaam</label>
                    {{ form_widget(form.lastName, {'attr': {'placeholder': 'Achternaam'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.avatarUrl.vars.id }}">Avatar URL</label>
                    {{ form_widget(form.avatarUrl, {'required': false, 'attr': {'placeholder': 'https://example.com/avatar.png'}}) }}
                    {{ form_errors(form.avatarUrl) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.location.vars.id }}">Locatie</label>
                    {{ form_widget(form.location, {'required': false, 'attr': {'placeholder': 'Bijv. Amsterdam, Nederland'}}) }}
                    {{ form_errors(form.location) }}
                </div>

                <div class="form-group">
                    <label for="{{ form.description.vars.id }}">Over jezelf</label>
                    {{ form_widget(form.description, {'required': false, 'attr': {'rows': 4, 'placeholder': 'Vertel iets over jezelf...'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                {# deze drie stonden alleen op de pagina als de instellingen bestonden, die check kijkt nu naar het formulier #}
                {% if form.language is defined %}
                    <div class="form-group">
                        <label for="{{ form.language.vars.id }}">Taal</label>
                        {{ form_widget(form.language, {'attr': {'maxlength': 5, 'placeholder': 'nl'}}) }}
                        {{ form_errors(form.language) }}
                    </div>

                    {# select omgebouwd, keuzes moeten nu uit php komen: light (White), dark (Dark) #}
                    <div class="form-group">
                        <label for="{{ form.theme.vars.id }}">Thema</label>
                        {{ form_widget(form.theme) }}
                        {{ form_errors(form.theme) }}
                    </div>

                    {# select omgebouwd, keuzes moeten nu uit php komen: public (Public), private (Private) #}
                    <div class="form-group">
                        <label for="{{ form.profileVisibility.vars.id }}">Profiel Zichtbaarheid</label>
                        {{ form_widget(form.profileVisibility) }}
                        {{ form_errors(form.profileVisibility) }}
                    </div>
                {% endif %}

                <button type="submit" class="btn-primary">Wijzigingen opslaan</button>

                <div class="form-footer-link">
                    Heb je je bedacht? <a href="{{ path('account.home') }}">Annuleren</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
