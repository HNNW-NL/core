{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify Account{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container">
        <header class="dashboard-header">
            <h1>Profiel Wijzigen</h1>
        </header>

        <div class="account-form-container">
            <div class="form-internal-header">
                <h2>Wijzig je profielgegevens</h2>
                <p>Pas je gegevens aan om je profiel up-to-date te houden - je gegevens blijven veilig.</p>
            </div>

            <form action="#" method="POST">
                <div class="form-group">
                    <label for="username">Gebruikersnaam</label>
                    <input type="text" id="username" name="username" placeholder="Kies een gebruikersnaam" value="">
                </div>

                <div class="form-group">
                    <label for="email">E-mailadres</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" value="">
                </div>

                <div class="form-group">
                    <label for="phone">Telefoonnummer</label>
                    <input type="tel" id="phone" name="phone" placeholder="Je telefoonnummer" value="">
                </div>

                <div class="form-group">
                    <label for="bio">Over jezelf</label>
                    <textarea id="bio" name="bio" rows="4" placeholder="Vertel iets over jezelf..."></textarea>
                </div>

                <div class="form-group">
                    <label for="talen">Talen</label>
                    <input type="text" id="talen" name="talen" placeholder="Welke talen spreek je?" value="">
                </div>

                <div class="form-group">
                    <label for="expertise">Expertise</label>
                    <input type="text" id="expertise" name="expertise" placeholder="Wat is je expertise?" value="">
                </div>

                <button type="submit" class="btn-primary">Wijzigingen opslaan</button>

                <div class="form-footer-link">
                    Heb je je bedacht? <a href="{{ path('account.home') }}">Annuleren</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
