{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Modify Account{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container">

        <a href="{{ path('account.home') }}" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Profiel Wijzigen</h1>
            <p>Wijzig hier uw gegevens en uw zichtbaarheid van de profiel.</p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="account-flash-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="account-flash-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="account-form-container">
            <div class="form-internal-header">
                <h2>Wijzig je profielgegevens</h2>
                <p>Pas je gegevens aan om je profiel up-to-date te houden - je gegevens blijven veilig.</p>
            </div>

            <form action="{{ path('account.modify') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('account_modify') }}">
                <div class="form-group">
                    {% if errors.username is defined %}
                        <small class="account-flash" role="alert">{{ errors.username }}</small>
                    {% endif %}
                    <label for="username">Gebruikersnaam (Max 12 characters)</label>
                    <input type="text" id="username" name="username" placeholder="Kies een gebruikersnaam" value="{{ formData.username|default('') }}" required>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="email" value="{{ formData.email|default('') }}" disabled>
                </div>

                <div class="form-group">
                    {% if errors.first_name is defined %}
                        <small class="account-flash" role="alert">{{ errors.first_name }}</small>
                    {% endif %}
                    <label for="first_name">Voornaam (Max 50 characters)</label>
                    <input type="text" id="first_name" name="first_name" placeholder="Voornaam" value="{{ formData.first_name|default('') }}" required>
                </div>

                <div class="form-group">
                    {% if errors.last_name is defined %}
                        <small class="account-flash" role="alert">{{ errors.last_name }}</small>
                    {% endif %}
                    <label for="last_name">Achternaam (Max 50 characters)</label>
                    <input type="text" id="last_name" name="last_name" placeholder="Achternaam" value="{{ formData.last_name|default('') }}" required>
                </div>

                <div class="form-group">
                    {% if errors.display_name is defined %}
                        <small class="account-flash" role="alert">{{ errors.display_name }}</small>
                    {% endif %}
                    <label for="display_name">Weergavenaam</label>
                    <input
                        type="text"
                        id="display_name"
                        name="display_name"
                        value="{{ formData.display_name|default('') }}"
                        placeholder="Hoe wil je zichtbaar zijn?"
                    >
                </div>

                <div class="form-group">
                    {% if errors.avatar_url is defined %}
                        <small class="account-flash" role="alert">{{ errors.avatar_url }}</small>
                    {% endif %}
                    <label for="avatar_url">Avatar URL</label>
                    <input type="url" id="avatar_url" name="avatar_url" placeholder="https://example.com/avatar.png" value="{{ formData.avatar_url|default('') }}">
                </div>

                <div class="form-group">
                    {% if errors.location is defined %}
                        <small class="account-flash" role="alert">{{ errors.location }}</small>
                    {% endif %}
                    <label for="location">Locatie</label>
                    <input type="text" id="location" name="location" placeholder="Bijv. Amsterdam, Nederland" value="{{ formData.location|default('') }}">
                </div>

                <div class="form-group">
                    {% if errors.bio is defined %}
                        <small class="account-flash" role="alert">{{ errors.bio }}</small>
                    {% endif %}
                    <label for="bio">Over jezelf (Max 250 characters)</label>
                    <textarea id="bio" name="bio" rows="4" placeholder="Vertel iets over jezelf..." maxlength="250">{{ formData.bio|default('') }}</textarea>
                </div>

                <button type="submit" class="btn-primary">Wijzigingen opslaan</button>

                <div class="form-footer-link">
                    Heb je je bedacht? <a href="{{ path('account.home') }}">Annuleren</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
