{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Projects{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/account-centre/css/accountprojects.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascripts %}
    <script src="{{ asset('assets/account-centre/js/accountprojects.js') }}" defer></script>
{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container" class="projects-page">
        <a href="{{ path('account.home') }}" class="btn-back">
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Mijn projecten</h1>
            <p>Bekijk de projecten die aan jouw account gekoppeld zijn.</p>
        </div>

        <section class="projects-tools" aria-label="Projecten zoeken en filteren">
            <div class="projects-search">
                <label for="project-search">Zoeken</label>
                <input type="search" id="project-search" placeholder="Zoek op project of omschrijving" autocomplete="off">
            </div>
            <div class="projects-status-filter">
                <label for="project-status">Status</label>
                <select id="project-status">
                    <option value="all">Alle statussen</option>
                    <option value="active">Actief</option>
                    <option value="preparation">In voorbereiding</option>
                    <option value="completed">Afgerond</option>
                </select>
            </div>
            <div class="projects-sort">
                <label for="project-sort">Sorteren op</label>
                <select id="project-sort">
                    <option value="name-asc">Naam (A-Z)</option>
                    <option value="name-desc">Naam (Z-A)</option>
                    <option value="status">Status</option>
                </select>
            </div>
            <label class="projects-toggle" for="project-active-only">
                <input type="checkbox" id="project-active-only">
                <span>Alleen actieve projecten</span>
            </label>
            <label class="projects-toggle" for="project-favorites-only">
                <input type="checkbox" id="project-favorites-only">
                <span>Alleen favorieten (<span id="project-favorites-count">0</span>)</span>
            </label>
            <div class="projects-actions">
                <button type="button" class="projects-export" id="projects-export" disabled>Download CSV</button>
                <button type="button" class="projects-reset" id="projects-reset" disabled>Wis filters</button>
            </div>
        </section>

        <p class="projects-result-count" id="projects-result-count" aria-live="polite"></p>
        <p class="projects-filter-status" id="projects-filter-status" aria-live="polite"></p>
        <p class="projects-export-status" id="projects-export-status" aria-live="polite"></p>

        <div class="account-grid projects-grid" id="projects-list">
            <article class="account-card project-card" data-project-id="buurtmoestuin-noord" data-status="active">
                <div class="account-card-content">
                    <h3>Buurtmoestuin Noord</h3>
                    <p>Werk samen met buurtbewoners aan een groene en toegankelijke ontmoetingsplek.</p>
                </div>
                <span class="project-status status-active">Actief</span>
                <button type="button" class="project-favorite" aria-pressed="false">Bewaar</button>
            </article>

            <article class="account-card project-card" data-project-id="digitale-hulp" data-status="preparation">
                <div class="account-card-content">
                    <h3>Digitale hulp voor iedereen</h3>
                    <p>Help inwoners met praktische vragen over digitale diensten en apparaten.</p>
                </div>
                <span class="project-status status-preparation">In voorbereiding</span>
                <button type="button" class="project-favorite" aria-pressed="false">Bewaar</button>
            </article>

            <article class="account-card project-card" data-project-id="jongeren-in-beweging" data-status="completed">
                <div class="account-card-content">
                    <h3>Jongeren in beweging</h3>
                    <p>Draag bij aan activiteiten die jongeren in de wijk samenbrengen.</p>
                </div>
                <span class="project-status status-completed">Afgerond</span>
                <button type="button" class="project-favorite" aria-pressed="false">Bewaar</button>
            </article>
        </div>

        <div class="projects-empty" id="projects-empty" role="status" hidden>
            <p id="projects-empty-text"></p>
            <button type="button" class="projects-empty-reset" id="projects-empty-reset">Wis filters</button>
        </div>
    </div>
{% endblock %}
