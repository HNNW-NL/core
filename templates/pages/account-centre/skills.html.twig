{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Mijn vaardigheden{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section id="account-centre-container">
        <a href="{{ path('account.home') }}" class="btn-back" aria-label="Terug naar Account Centre">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
        </a>

        <header class="dashboard-header">
            <h1>Mijn vaardigheden</h1>
            <p>Beheer hier de vaardigheden die je op je profiel wilt tonen.</p>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-alert alert-{{ label }}" role="status">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <section class="account-form-container" aria-labelledby="skills-add-heading">
            <div class="form-internal-header">
                <h2 id="skills-add-heading">Jouw vaardigheden</h2>
                <p>Voeg je belangrijkste vaardigheden toe om beter gevonden te worden.</p>
            </div>

            <form method="post" action="{{ path('account.skills_save') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('account_skill_save') }}">

                <div class="form-group">
                    <label for="skill_id">Vaardigheid</label>
                    <select name="skill_id" id="skill_id" required>
                        <option value="">Selecteer een vaardigheid</option>
                        {% for skill in availableSkills %}
                            <option value="{{ skill.id }}">{{ skill.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label for="level">Niveau</label>
                    <select name="level" id="level" required>
                        <option value="beginner">Beginner</option>
                        <option value="intermediate">Zelfstandig</option>
                        <option value="advanced">Gevorderd</option>
                        <option value="expert">Expert</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary">Vaardigheid toevoegen</button>
            </form>
        </section>

        <section class="account-form-container" aria-labelledby="skills-list-heading">
            <div class="form-internal-header">
                <h2 id="skills-list-heading">Gekoppelde vaardigheden</h2>
                <p>Bekijk en beheer de vaardigheden op je profiel.</p>
            </div>

            {% if skills is not empty %}
                <div class="account-card-list">
                    {% for item in skills %}
                        <article class="account-card">
                            <div class="account-card-content">
                                <h3>{{ item.skill.name }}</h3>
                                <p>Niveau: {{ item.proficiencyLevel.value }}</p>
                            </div>

                            <form method="post" action="{{ path('account.skills_delete', {'id': item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('account_skill_delete_' ~ item.id) }}">
                                <button type="submit" class="btn-danger">Verwijderen</button>
                            </form>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="account-card account-card-empty">
                    <div class="account-card-content">
                        <p>Je hebt nog geen vaardigheden toegevoegd.</p>
                    </div>
                </div>
            {% endif %}
        </section>
    </section>
{% endblock %}
