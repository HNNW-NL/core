{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Notificaties{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container">

        <a href="{{ path('account.home') }}" class="btn-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Notificaties</h1>
            <p>Bepaal zelf welke updates en nieuwsbrieven je van HNNW wilt ontvangen.</p>
        </div>

        {# Flash messages for success and error state alerts #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="account-form-container">
            {# hele formulier omgebouwd naar symfony form, de form variabele komt uit de controller #}
            {{ form_start(form, {'action': path('account.notifications')}) }}

                {{ form_errors(form) }}

                {# het nieuwsbrief vinkje is weggehaald, het schreef naar hetzelfde database veld als dit vinkje #}
                <div class="form-group-checkbox">
                    {{ form_widget(form.emailNotificationsEnabled) }}
                    <label for="{{ form.emailNotificationsEnabled.vars.id }}">
                        <strong>Nieuwe Projecten</strong>
                        <span>Ontvang direct een melding zodra er een nieuw project start dat matcht met jouw skills.</span>
                    </label>
                    {{ form_errors(form.emailNotificationsEnabled) }}
                </div>

                {# dit vinkje staat vast aan en wordt niet verstuurd, dus zo gelaten #}
                <div class="form-group-checkbox">
                    <input type="checkbox" id="notify_security" name="notify_security" checked disabled>
                    <label for="notify_security">
                        <strong>Beveiliging & Account (Verplicht)</strong>
                        <span>Belangrijke updates over je wachtwoord, privacywijzigingen en inlogpogingen.</span>
                    </label>
                </div>

                <div class="form-actions-row">
                    <button type="submit" class="btn-primary">Voorkeuren Opslaan</button>
                    <a href="{{ path('account.home') }}" class="btn-cancel">
                        Annuleren
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
