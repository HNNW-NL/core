{% extends 'layouts/ac.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Settings{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="../../../public/assets/account-centre/css/settings.css">
{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="account-centre-container" class="settings-page">
        <a href="{{ path('account.home') }}" class="btn-back">
            Terug naar dashboard
        </a>

        <div class="dashboard-header">
            <h1>Accountinstellingen</h1>
            <p>Wijzig de gegevens die je voor je account wilt aanpassen.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="account-flash-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="account-form-container">
            <div class="form-internal-header">
                <h2>Accountgegevens</h2>
                <p>Laat een veld leeg als je die gegevens niet wilt wijzigen.</p>
            </div>

            <form action="{{ path('account.modify') }}" method="POST" class="account-form">
                <div class="form-group">
                    <label for="username">Gebruikersnaam</label>
                    <input type="text" id="username" name="username" placeholder="Nieuwe gebruikersnaam">
                </div>

                <div class="form-group">
                    <label for="email">E-mailadres</label>
                    <input type="email" id="email" name="email" placeholder="nieuw e-mailadres">
                </div>

                <div class="settings-form-divider">
                    <h3>Profielgegevens</h3>
                </div>

                <div class="form-group">
                    <label for="first_name">Voornaam</label>
                    <input type="text" id="first_name" name="first_name" placeholder="Voornaam">
                </div>

                <div class="form-group">
                    <label for="last_name">Achternaam</label>
                    <input type="text" id="last_name" name="last_name" placeholder="Achternaam">
                </div>

                <div class="form-group">
                    <label for="display_name">Weergavenaam</label>
                    <input type="text" id="display_name" name="display_name" placeholder="Naam die anderen zien">
                </div>

                <div class="form-group">
                    <label for="location">Locatie</label>
                    <input type="text" id="location" name="location" placeholder="Bijv. Amsterdam, Nederland">
                </div>

                <div class="form-group">
                    <label for="bio">Over jezelf</label>
                    <textarea id="bio" name="bio" rows="4" placeholder="Vertel iets over jezelf..."></textarea>
                </div>

                <div class="settings-form-divider">
                    <h3>Voorkeuren</h3>
                </div>

                <div class="form-group">
                    <label for="language">Taal</label>
                    <input type="text" id="language" name="language" maxlength="5" value="nl" placeholder="nl">
                </div>

                <div class="form-group">
                    <label for="theme">Thema</label>
                    <select id="theme" name="theme">
                        <option value="dark" selected>Donker</option>
                        <option value="light">Licht</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="profile_visibility">Profielzichtbaarheid</label>
                    <select id="profile_visibility" name="profile_visibility">
                        <option value="public" selected>Openbaar</option>
                        <option value="private">Privé</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary">Wijzigingen opslaan</button>
            </form>
        </div>
    </div>
{% endblock %}
