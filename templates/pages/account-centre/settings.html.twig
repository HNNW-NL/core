{% extends 'layouts/ac.base.html.twig' %}
{% block title %}Accountinstellingen{% endblock %}
{% block body %}
<section id="account-centre-container" class="account-records">
    <header class="dashboard-header"><h1>Accountinstellingen</h1><p>Beheer je profiel en je voorkeuren.</p></header>
    <div class="account-grid">
        <a class="account-card" href="{{ path('account.modify') }}"><div><h2>Profielvoorkeuren</h2><p>Wijzig je profielgegevens, taal, thema en zichtbaarheid.</p></div></a>
        <a class="account-card" href="{{ path('account.notifications') }}"><div><h2>Meldingsvoorkeuren</h2><p>Kies welke e-mailmeldingen je wilt ontvangen.</p></div></a>
    </div>
</section>
{% endblock %}
