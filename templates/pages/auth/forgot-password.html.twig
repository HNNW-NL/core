{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Wachtwoord vergeten{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section class="auth-page register-page" aria-labelledby="forgot-title">
        <h1 id="forgot-title">Wachtwoord vergeten</h1>

        <div class="auth-grid">
            <section class="auth-form" aria-labelledby="forgot-form-title">
                <header class="card-header">
                    <h2 id="forgot-form-title">Reset je wachtwoord</h2>
                    <p class="lead">Voer je e-mailadres in en we sturen je instructies om je wachtwoord te resetten.</p>
                </header>

                <div id="forgot-errors" class="form-errors mb-1" role="alert" aria-live="assertive" tabindex="-1"></div>

                <form id="forgot-form" action="{{ path('auth.forgotPassword') }}" method="post" novalidate>
                    <fieldset>
                        <legend class="visually-hidden">Wachtwoord reset per e-mail</legend>

                        <label for="email">E-mailadres</label>
                        <input id="email" class="auth-input" name="email" type="email" placeholder="you@example.com" autocomplete="email" required aria-required="true" maxlength="254" inputmode="email" spellcheck="false" aria-describedby="email-error">
                        <div id="email-error" class="field-error visually-hidden small" aria-live="polite"></div>

                        <div class="mt-1">
                            <button type="submit" class="btn btn-primary">Stuur reset link</button>
                        </div>
                    </fieldset>
                </form>

                <p class="small mt-1">Terug naar <a href="{{ path('auth.login') }}">Inloggen</a></p>
            </section>
        </div>

    </section>
{% endblock %}
