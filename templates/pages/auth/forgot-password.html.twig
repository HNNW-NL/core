{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Wachtwoord vergeten{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section class="auth-page register-page" aria-labelledby="forgot-title">
        <h1 id="forgot-title">Wachtwoord vergeten</h1>

        <div class="auth-grid">
            <section class="auth-form" aria-labelledby="forgot-form-title">
                <header class="card-header">
                    <h2 id="forgot-form-title">Vraag een herstellink aan</h2>
                    <p class="lead">Vul het e-mailadres van je account in. Je ontvangt een link waarmee je een nieuw wachtwoord kunt instellen.</p>
                </header>

                {% for message in app.flashes('success') %}
                    <div class="form-success" role="status" aria-live="polite">{{ message }}</div>
                {% endfor %}
                {% if errors.general is defined %}
                    <div id="forgot-errors" class="form-errors visible mb-1" role="alert">{{ errors.general }}</div>
                {% endif %}

                <form id="forgot-form" action="{{ path('auth.forgotPassword') }}" method="post" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                    <fieldset>
                        <legend class="visually-hidden">Wachtwoord reset per e-mail</legend>

                        <label for="email">E-mailadres</label>
                        <input id="email" class="auth-input" name="email" type="email" value="{{ email|default('') }}" placeholder="jij@voorbeeld.nl" autocomplete="email" required aria-required="true" maxlength="254" inputmode="email" spellcheck="false" aria-describedby="email-error"{% if errors.email is defined %} aria-invalid="true"{% endif %}>
                        <div id="email-error" class="field-error small{% if errors.email is not defined %} visually-hidden{% endif %}" aria-live="polite">{{ errors.email|default('') }}</div>

                        <div class="mt-1">
                            <button type="submit" class="btn btn-primary">Herstellink aanvragen</button>
                        </div>
                    </fieldset>
                </form>

                <p class="small mt-1">Terug naar <a href="{{ path('auth.login') }}">Inloggen</a></p>
            </section>
        </div>

    </section>
{% endblock %}
