{% extends 'layouts/auth.base.html.twig' %}
{% block title %}Nieuw wachtwoord instellen{% endblock %}
{% block body %}
<section class="auth-page register-page" aria-labelledby="reset-title">
    <h1 id="reset-title">Nieuw wachtwoord instellen</h1>
    <div class="auth-grid">
        <section class="auth-form">
            {% if not valid_link %}
                <h2>Vraag een nieuwe herstellink aan</h2>
                <p class="form-errors visible" role="alert">Deze herstellink is ongeldig of verlopen. Een herstellink is 20 minuten geldig en kan eenmalig worden gebruikt.</p>
                <p class="mt-1"><a class="btn btn-primary" href="{{ path('auth.forgotPassword') }}">Nieuwe herstellink aanvragen</a></p>
            {% else %}
                <h2>Kies je nieuwe wachtwoord</h2>
                {% if errors.general is defined %}<div class="form-errors visible" role="alert">{{ errors.general }}</div>{% endif %}
                <form id="reset-form" method="post" action="{{ path('auth.resetPassword', {token: token, email: email}) }}" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('auth_reset_password') }}">
                    <label for="password">Nieuw wachtwoord</label>
                    <input id="password" class="auth-input" name="password" type="password" minlength="8" maxlength="4096" autocomplete="new-password" required aria-describedby="password-help password-error"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                    <p id="password-help" class="small">Gebruik minimaal 8 tekens. Kies een lang, uniek wachtwoord.</p>
                    <div id="password-error" class="field-error small{% if errors.password is not defined %} visually-hidden{% endif %}" aria-live="polite">{{ errors.password|default('') }}</div>
                    <label for="confirm_password">Bevestig wachtwoord</label>
                    <input id="confirm_password" class="auth-input" name="confirm_password" type="password" minlength="8" maxlength="4096" autocomplete="new-password" required aria-describedby="confirm_password-error"{% if errors.confirm_password is defined %} aria-invalid="true"{% endif %}>
                    <div id="confirm_password-error" class="field-error small{% if errors.confirm_password is not defined %} visually-hidden{% endif %}" aria-live="polite">{{ errors.confirm_password|default('') }}</div>
                    <div class="mt-1"><button type="submit" class="btn btn-primary">Wachtwoord opslaan</button></div>
                </form>
            {% endif %}
            <p class="small mt-1"><a href="{{ path('auth.login') }}">Terug naar inloggen</a></p>
        </section>
    </div>
</section>
{% endblock %}
