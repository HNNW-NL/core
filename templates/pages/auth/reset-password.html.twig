{% extends 'layouts/auth.base.html.twig' %}

{% block title %}Nieuw wachtwoord instellen{% endblock %}

{% block body %}
    <section class="auth-page register-page" aria-labelledby="reset-title">
        <h1 id="reset-title">Nieuw wachtwoord instellen</h1>

        <div class="auth-grid">
            <section class="auth-form" aria-labelledby="reset-form-title">
                {% if not valid_link %}
                    <h2 id="reset-form-title">Vraag een nieuwe herstellink aan</h2>
                    <div class="form-errors visible" role="alert">
                        Deze herstellink is ongeldig of verlopen. Een herstellink is 20 minuten geldig en kan maar één keer worden gebruikt.
                    </div>
                    <p class="mt-1"><a class="btn btn-primary" href="{{ path('auth.forgotPassword') }}">Nieuwe herstellink aanvragen</a></p>
                {% else %}
                    <header class="card-header">
                        <h2 id="reset-form-title">Kies je nieuwe wachtwoord</h2>
                        <p class="lead">Vul je nieuwe wachtwoord twee keer in. Na het opslaan kun je hiermee inloggen.</p>
                    </header>

                    {% if errors.general is defined %}
                        <div class="form-errors visible mb-1" role="alert">{{ errors.general }}</div>
                    {% endif %}

                    <form id="reset-form" action="{{ path('auth.resetPassword', {token: token, email: email}) }}" method="post" data-turbo="false">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                        <fieldset>
                            <legend class="visually-hidden">Een nieuw wachtwoord kiezen</legend>

                            <label for="password">Nieuw wachtwoord</label>
                            <input id="password" class="auth-input" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="4096" required aria-required="true" aria-describedby="password-help password-error"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                            <p id="password-help" class="small">Gebruik minimaal 8 tekens. Een lange, unieke wachtwoordzin is een goede keuze.</p>
                            <div id="password-error" class="field-error small{% if errors.password is not defined %} visually-hidden{% endif %}" aria-live="polite">{{ errors.password|default('') }}</div>

                            <label for="confirm_password">Herhaal je nieuwe wachtwoord</label>
                            <input id="confirm_password" class="auth-input" name="confirm_password" type="password" autocomplete="new-password" minlength="8" maxlength="4096" required aria-required="true" aria-describedby="confirm_password-error"{% if errors.confirm_password is defined %} aria-invalid="true"{% endif %}>
                            <div id="confirm_password-error" class="field-error small{% if errors.confirm_password is not defined %} visually-hidden{% endif %}" aria-live="polite">{{ errors.confirm_password|default('') }}</div>

                            <div class="mt-1">
                                <button type="submit" class="btn btn-primary">Wachtwoord opslaan</button>
                            </div>
                        </fieldset>
                    </form>
                {% endif %}

                <p class="small mt-1">Terug naar <a href="{{ path('auth.login') }}">Inloggen</a></p>
            </section>
        </div>
    </section>
{% endblock %}
