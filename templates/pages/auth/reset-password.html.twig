{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Wachtwoord resetten{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section class="auth-page register-page" aria-labelledby="reset-title">
        <h1 id="reset-title">Wachtwoord resetten</h1>
        <div class="auth-grid">
            <section class="auth-form">
                <header class="card-header"><h2>Nieuw wachtwoord instellen</h2></header>
                {% if errors is not empty %}
                    <div class="form-errors visible" role="alert">
                        <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
                    </div>
                {% endif %}
                <form method="post" action="{{ path('auth.resetPassword', {token: token, email: email}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('auth_reset_password') }}">
                    <label for="password">Nieuw wachtwoord</label>
                    <input id="password" class="auth-input" name="password" type="password" minlength="8" autocomplete="new-password" required>
                    <label for="confirm_password">Bevestig wachtwoord</label>
                    <input id="confirm_password" class="auth-input" name="confirm_password" type="password" minlength="8" autocomplete="new-password" required>
                    <div class="mt-1"><button type="submit" class="btn">Wachtwoord opslaan</button></div>
                </form>
            </section>
        </div>
    </section>
{% endblock %}
