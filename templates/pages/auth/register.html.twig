{% extends 'layouts/auth.base.html.twig' %}

{% block title %}Registreren{% endblock %}

{% block stylesheets %}{% endblock %}

{% block javascript %}{% endblock %}

{% block body %}
    <main class="auth-page">
        <h1>Registreren</h1>

        <div class="auth-grid">
            <section class="auth-form">
                <header class="card-header">
                    <h2>Maak je account aan</h2>
                    <p class="lead">Registreer om toegang te krijgen tot het platform - je gegevens blijven veilig.</p>
                </header>

                <div id="register-errors" class="form-errors mb-1" role="alert" aria-live="assertive" tabindex="-1"></div>

                <form id="register-form" action="/auth/register" method="post" novalidate>
                    <fieldset>
                        <legend class="visually-hidden">Registreren met e-mail</legend>

                        <label for="full_name">Volledige naam</label>
                        <input id="full_name" class="auth-input" name="full_name" type="text" placeholder="Je volledige naam" autocomplete="name" required aria-required="true">
                        <div id="full_name-error" class="field-error visually-hidden small" aria-live="polite"></div>

                        <label for="email">Email</label>
                        <input id="email" class="auth-input" name="email" type="email" placeholder="you@example.com" autocomplete="email" required aria-required="true">
                        <div id="email-error" class="field-error visually-hidden small" aria-live="polite"></div>

                        <label for="password">Wachtwoord</label>
                        <div class="input-row">
                            <input id="password" class="auth-input" name="password" type="password" placeholder="Maak een wachtwoord" autocomplete="new-password" required aria-required="true" aria-describedby="password-help password-strength">
                            <button type="button" class="toggle-password" data-target="password" aria-label="Toon of verberg wachtwoord" aria-pressed="false">Toon</button>
                        </div>

                        <div id="password-help" class="small">Gebruik minimaal 8 tekens en combineer letters, cijfers en symbolen.</div>
                        <div class="pw-strength mt-1">
                            <meter id="pw-meter" min="0" max="4" value="0" low="1" high="3" optimum="4"></meter>
                            <div id="password-strength" class="small" aria-hidden="true"></div>
                        </div>

                        <label for="confirm_password">Bevestig wachtwoord</label>
                        <div class="input-row">
                            <input id="confirm_password" class="auth-input" name="confirm_password" type="password" placeholder="Herhaal je wachtwoord" autocomplete="new-password" required aria-required="true">
                            <button type="button" class="toggle-password" data-target="confirm_password" aria-label="Toon of verberg bevestigingswachtwoord" aria-pressed="false">Toon</button>
                        </div>
                        <div id="confirm_password-error" class="field-error visually-hidden small" aria-live="polite"></div>

                        <label class="remember-me"><input type="checkbox" name="terms" id="terms"> Ik ga akkoord met de <a href="#">voorwaarden en privacyverklaring</a>.</label>

                        <div class="mt-1">
                            <button type="submit" class="btn" disabled>Account aanmaken</button>
                        </div>
                     </fieldset>
                 </form>

                <p class="small mt-1">Heb je al een account? <a href="/auth/login">Inloggen</a></p>
             </section>


         </div>

     </main>
{% endblock %}
