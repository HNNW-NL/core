{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Registreren{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section class="auth-page register-page" aria-labelledby="register-title">
        <h1 id="register-title">Registreren</h1>

        <div class="auth-grid">
            <section class="auth-form">
                <header class="card-header">
                    <h2>Maak je account aan</h2>
                </header>

                <div id="register-errors" class="form-errors{% if errors.general is defined %} visible{% endif %} mb-1" role="alert" aria-live="assertive" tabindex="-1">
                    {% if errors is defined and errors.general is defined %}
                            {{ errors.general }}
                    {% endif %}
                </div>

                <form id="register-form" action="{{ path('auth.register') }}" method="post" novalidate data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
                    <fieldset>
                        <legend class="visually-hidden">Registreren met e-mail</legend>

                        <label for="full_name">Volledige naam</label>
                        <input id="full_name" class="auth-input" name="full_name" value="{{ old.full_name|default('') }}" type="text" placeholder="Je volledige naam" autocomplete="name" required aria-required="true" maxlength="100" aria-describedby="full_name-error"{% if errors.full_name is defined %} aria-invalid="true"{% endif %}>
                        <div id="full_name-error" class="field-error{% if errors.full_name is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.full_name|default('') }}</div>

                        <label for="username">Gebruikersnaam</label>
                        <input id="username" class="auth-input" name="username" value="{{ old.username|default('') }}" type="text" placeholder="Kies een gebruikersnaam" autocomplete="username" required aria-required="true" minlength="3" maxlength="30" spellcheck="false" aria-describedby="username-error"{% if errors.username is defined %} aria-invalid="true"{% endif %}>
                        <div id="username-error" class="field-error{% if errors.username is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.username|default('') }}</div>

                        <label for="email">E-mailadres</label>
                        <input id="email" class="auth-input" name="email" value="{{ old.email|default('') }}" type="email" placeholder="you@example.com" autocomplete="email" required aria-required="true" maxlength="254" inputmode="email" spellcheck="false" aria-describedby="email-error"{% if errors.email is defined %} aria-invalid="true"{% endif %}>
                        <div id="email-error" class="field-error{% if errors.email is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.email|default('') }}</div>

                        <label for="password">Wachtwoord</label>
                        <div class="input-row">
                            <input id="password" class="auth-input" name="password" type="password" placeholder="Maak een wachtwoord" autocomplete="new-password" required aria-required="true" minlength="8" maxlength="4096" aria-describedby="password-help password-strength password-error"{% if errors.password is defined %} aria-invalid="true"{% endif %}>
                            <button type="button" class="toggle-password" data-target="password" aria-label="Toon of verberg wachtwoord" aria-pressed="false">Toon</button>
                        </div>

                        <div id="password-error" class="field-error{% if errors.password is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.password|default('') }}</div>
                        <div id="password-help" class="small">Gebruik minimaal 8 tekens en combineer letters, cijfers en symbolen.</div>
                        <div class="pw-strength mt-1">
                            <meter id="pw-meter" min="0" max="4" value="0" low="1" high="3" optimum="4"></meter>
                            <div id="password-strength" class="small" aria-hidden="true"></div>
                        </div>

                        <label for="confirm_password">Bevestig wachtwoord</label>
                        <div class="input-row">
                            <input id="confirm_password" class="auth-input" name="confirm_password" type="password" placeholder="Herhaal je wachtwoord" autocomplete="new-password" required aria-required="true" minlength="8" aria-describedby="confirm_password-error"{% if errors.confirm_password is defined %} aria-invalid="true"{% endif %}>
                            <button type="button" class="toggle-password" data-target="confirm_password" aria-label="Toon of verberg bevestigingswachtwoord" aria-pressed="false">Toon</button>
                        </div>
                        <div id="confirm_password-error" class="field-error{% if errors.confirm_password is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.confirm_password|default('') }}</div>

                        <label class="remember-me" for="terms">
                            <input type="checkbox" name="terms" id="terms"{% if terms|default(false) %} checked{% endif %} aria-describedby="terms-error" required aria-required="true"{% if errors.terms is defined %} aria-invalid="true"{% endif %}>
                            <span>Ik ga akkoord met de voorwaarden en privacyverklaring.</span>
                        </label>

                        <div id="terms-error" class="field-error{% if errors.terms is not defined %} visually-hidden{% endif %} small" aria-live="polite">{{ errors.terms|default('') }}</div>
                        <div class="mt-1">
                            <button type="submit" class="btn btn-primary">Account aanmaken</button>
                        </div>
                     </fieldset>
                 </form>

                <p class="small mt-1">Heb je al een account? <a href="/auth/login">Inloggen</a></p>
             </section>


         </div>

    </section>
{% endblock %}
