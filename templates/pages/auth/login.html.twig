{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Login{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
<main class>
        <section class="register-page" aria-labelledby="login-title">
        <h1 id="login-title">Inloggen</h1>

        <div class="auth-grid">
            <section class="auth-form">
                <header class="card-header">
                    <h2>Welkom terug</h2>
                    <p class="lead">Log in om toegang te krijgen.</p>
                </header>

                <form id="login-form" method="post">
                    <fieldset>
                        <legend class="visually-hidden">Inloggen met je account</legend>

                        <label for="username">Gebruikersnaam of Email</label>
                        <input id="username" 
                               class="auth-input" 
                               name="_username" 
                               type="text" 
                               value="{{ last_username|default('') }}" 
                               placeholder="Je gebruikersnaam" 
                               autocomplete="username" 
                               required 
                               aria-required="true">

                        <label for="password">Wachtwoord</label>
                        <div class="input-row">
                            <input id="password" 
                                   class="auth-input" 
                                   name="_password" 
                                   type="password" 
                                   placeholder="Je wachtwoord" 
                                   autocomplete="current-password" 
                                   required 
                                   aria-required="true">
                        </div>

                        <input type="hidden" name="_csrf_token">

                        <div class="mt-1">
                            <button type="submit" class="btn">Log in</button>
                        </div>
                    </fieldset>
                </form>

                <p class="small mt-1">Nog geen account? <a href="/auth/register">Registreren</a></p>
                <p class="small mt-1"><a href="/auth/forgot-password">Wachtwoord vergeten?</a></p>
                
            </section>
        </div>
    </main>
{% endblock %}
