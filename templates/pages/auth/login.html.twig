{% extends 'layouts/auth.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Login{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
<section class="auth-page register-page" aria-labelledby="login-title">
    <h1 id="login-title">Inloggen</h1>

    <div class="auth-grid">
        <section class="auth-form">
            <header class="card-header">
                <h2>Log hier in</h2>
            </header>
            {% for msg in app.flashes('error') %}
                <div class="form-errors visible" role="alert" aria-live="assertive">{{ msg }}</div>
            {% endfor %}
            {% for msg in app.flashes('success') %}
                <div class="form-success" role="status" aria-live="polite">{{ msg }}</div>
            {% endfor %}

            {% if error is defined and error %}
                <div class="form-errors visible" role="alert" aria-live="assertive">{{ error }}</div>
            {% endif %}

            <form id="login-form" method="post" action="{{ path('app_login') }}">
                <fieldset>
                    <legend class="visually-hidden">Inloggen met je account</legend>

                    <label for="username">Gebruikersnaam of Email</label>
                    <input id="username" class="auth-input" name="username" type="text" value="{{ last_username|default('') }}" placeholder="Je gebruikersnaam" autocomplete="username" required aria-required="true">

                    <label for="password">Wachtwoord</label>
                    <div class="input-row">
                        <input id="password" class="auth-input" name="password" type="password" placeholder="Je wachtwoord" autocomplete="current-password" required aria-required="true">
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="mt-1">
                        <button type="submit" class="btn">Log in</button>
                    </div>
                </fieldset>
            </form>

            <p class="small mt-1">Nog geen account? <a href="/auth/register">Registreren</a></p>
            <p class="small mt-1"><a href="/auth/forgot-password">Wachtwoord vergeten?</a></p>
        </section>
    </div>
</section>
{% endblock %}
