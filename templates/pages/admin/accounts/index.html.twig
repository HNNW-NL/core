{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Accounts{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/accounts.css') }}">
{% endblock %}

{% block body %}
    {% set overview = admin_account_overview() %}
    <h2>Accounts</h2>
    <p><a href="{{ path('admin.home') }}">Terug naar het admin-dashboard</a></p>

    <form method="get" action="{{ path('admin.accounts.home') }}" class="search-form">
        <label for="account-search">Naam, gebruikersnaam of e-mailadres</label>
        <input id="account-search" type="search" name="q" value="{{ overview.search }}" maxlength="200">
        <label for="account-status">Status</label>
        <select id="account-status" name="status">
            <option value="">Alle statussen</option>
            {% for status in overview.statuses %}
                <option value="{{ status.id }}"{% if status.id ~ '' == overview.status %} selected{% endif %}>{{ status.name }}</option>
            {% endfor %}
        </select>
        <button type="submit">Zoeken</button>
    </form>

    {% if overview.items is empty %}
        <p>Geen accounts gevonden.</p>
    {% else %}
        <p>{{ overview.total }} accounts gevonden.</p>
        <table class="accounts">
            <thead>
                <tr>
                    <th scope="col">Gebruikersnaam</th>
                    <th scope="col">Naam</th>
                    <th scope="col">E-mailadres</th>
                    <th scope="col">Status</th>
                    <th scope="col">Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for account in overview.items %}
                    <tr>
                        <td>{{ account.username }}</td>
                        <td>{{ account.firstName }} {{ account.lastName }}</td>
                        <td>{{ account.email }}</td>
                        <td>{{ account.statusName }}</td>
                        <td><a href="{{ path('admin.accounts.modify', {id: account.id}) }}">Bewerken</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if overview.pages > 1 %}
        {% set filters = {q: overview.search, status: overview.status} %}
        <nav aria-label="Accountpagina's">
            {% if overview.page > 1 %}
                <a href="{{ path('admin.accounts.home', filters|merge({page: overview.page - 1})) }}">Vorige</a>
            {% endif %}
            <span>Pagina {{ overview.page }} van {{ overview.pages }}</span>
            {% if overview.page < overview.pages %}
                <a href="{{ path('admin.accounts.home', filters|merge({page: overview.page + 1})) }}">Volgende</a>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
