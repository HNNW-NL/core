{% extends 'layouts/admin.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Accounts{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/accounts.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Accounts</h2>

    {% if dbConnected is defined and not dbConnected %}
        <div class="alert alert-warning" style="margin-bottom: 16px; padding: 12px; border: 1px solid #f1c40f; background: #fef9e7; color: #b9770e;">
            Database connection failed. Account data may be unavailable.
        </div>
    {% endif %}

    {# Zoek- en filterformulier (AD02-A vereiste) #}
    <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; align-items: center;">
        <form method="get" action="{{ path('admin.accounts.home') }}" class="search-form" style="margin-bottom: 0; display: flex; gap: 8px; align-items: center;">
            <input type="search" name="search" value="{{ search ?? '' }}" placeholder="Search email, first or last name" />
            
            <select name="status" style="padding: 8px;">
                <option value="">Alle statussen</option>
                <option value="1" {% if status is defined and status == '1' %}selected{% endif %}>Actief (Yes)</option>
                <option value="0" {% if status is defined and status == '0' %}selected{% endif %}>Inactief (No)</option>
            </select>

            <button type="submit" style="padding: 10px 20px;">Filter</button>
        </form>
        <a href="{{ path('admin.accounts.modify', {'id': 'new'}) }}" class="button" style="margin-bottom: 0; text-decoration: none; padding: 10px 15px; background: #007bff; color: #fff; border-radius: 4px;">Create</a>
    </div>

    {% if accounts is not empty %}
        <table class="accounts">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for account in accounts %}
                    <tr>
                        <td>{{ account.id }}</td>
                        <td>{{ account.firstName }} {{ account.lastName }}</td>
                        <td>{{ account.email }}</td>
                        <td>{{ account.active ? 'Yes' : 'No' }}</td>
                        <td>
                            <a href="{{ path('admin.accounts.modify', {'id': account.id}) }}">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p style="text-align: center; padding: 2rem; font-style: italic;">No accounts found.</p>
    {% endif %}
{% endblock %}