{% extends 'layouts/admin.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Accounts{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/accounts.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Accounts</h2>
    <form method="get" action="{{ path('admin.accounts.home') }}">
        <label for="account-search">Zoeken op gebruikersnaam of e-mail</label>
        <input id="account-search" type="search" name="search" value="{{ search }}">
        <button type="submit">Zoeken</button>
    </form>
    {% if accounts is empty %}
        <p>Geen accounts gevonden.</p>
    {% else %}
        <table>
            <thead><tr><th>Gebruikersnaam</th><th>E-mail</th><th>Status</th><th>Geregistreerd</th><th>Actie</th></tr></thead>
            <tbody>
            {% for account in accounts %}
                <tr>
                    <td>{{ account.username }}</td>
                    <td>{{ account.email }}</td>
                    <td>{{ account.status ? account.status.name : 'Onbekend' }}</td>
                    <td>{{ account.createdAt|date('d-m-Y') }}</td>
                    <td><a href="{{ path('admin.accounts.modify', {id: account.id}) }}">Bekijken</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
