{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Statuses{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Platformstatussen</h2>

    <p>Overzicht van de bestaande statussen. Wijzigingen verlopen via de centrale statusconfiguratie.</p>
    {% if statuses is empty %}
        <p>Geen statussen gevonden.</p>
    {% else %}
        <table>
            <thead><tr><th>Naam</th><th>Scope</th><th>Kleur</th></tr></thead>
            <tbody>
            {% for status in statuses %}
                <tr><td>{{ status.name }}</td><td>{{ status.scope }}</td><td>{{ status.colourHex }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
