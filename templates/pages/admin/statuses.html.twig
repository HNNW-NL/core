{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Statuses{% endblock %}

{% block body %}
    <h2>Statuses</h2>

    <a href="{{ path('admin.statuses.create') }}">
        Nieuwe status
    </a>

    <p>Aantal statuses: {{ statuses|length }}</p>

    <table>
        <thead>
            <tr>
                <th>Naam</th>
                <th>Scope</th>
                <th>Kleur</th>
            </tr>
        </thead>
        <tbody>
            {% for status in statuses %}
                <tr>
                    <td>{{ status.name }}</td>
                    <td>{{ status.scope }}</td>
                    <td>{{ status.colourHex }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Geen statussen gevonden.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}