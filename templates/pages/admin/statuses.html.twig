{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Statuses{% endblock %}

{% block body %}
    <h2>Statussen</h2>

    {% if statuses is not defined %}
        <p>Statusbeheer volgt in AD11.</p>
        <p><a href="{{ path('admin.home') }}">Terug naar het admin-dashboard</a></p>
    {% else %}
    <a href="{{ path('admin.statuses.create') }}">
        Nieuwe status
    </a>

    <p>Aantal statuses: {{ statuses|length }}</p>

    <table>
        <thead>
            <tr>
                <th>Naam</th>
                <th>Scope</th>
                <th>Kleur</th>
                <th>Acties</th>
            </tr>
        </thead>
        <tbody>
            {% for status in statuses %}
                <tr>
                    <td>{{ status.name }}</td>
                    <td>{{ status.scope }}</td>
                    <td>{{ status.colourHex }}</td>
                    <td>
                        <a href="{{ path('admin.statuses.edit', {
                            id: status.id
                        }) }}">
                            Bewerken
                        </a>

                        <form method="post"
                              action="{{ path('admin.statuses.delete', {
                                  id: status.id
                              }) }}"
                              style="display:inline;">
                            <button type="submit">
                                Verwijderen
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">
                        Geen statussen gevonden.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
{% endblock %}
