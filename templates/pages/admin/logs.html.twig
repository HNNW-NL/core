{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Logs{% endblock %}


{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/admin/css/logs.css") }}">
{% endblock %}

{% block body %}

<header>
    <h2>Logs</h2>
    <p>Overzicht van de 100 niewste Audit/System Logs.</p>
</header>


<div class="dashboard">


    <twig:Shared:Card>
        <twig:Shared:Card:Header>Zoek Audit Logs</twig:Shared:Card:Header>
        <twig:Shared:Card:Content>
            {{ component('Admin:AuditLogSearch',{
                formData: null,
            }) }}
        </twig:Shared:Card:Content>
    </twig:Shared:Card>

    <br><br>

    <twig:Shared:Card>
        <twig:Shared:Card:Header>System Logs</twig:Shared:Card:Header>
        <twig:Shared:Card:Content>
            <table>
                <thead>
                <tr>
                    <th>Datum</th>
                    <th>Code</th>
                    <th>Level</th>
                    <th>Bericht</th>
                    <th>Route</th>
                    <th>Methode</th>
                    <th>IP</th>
                </tr>
                </thead>
                <tbody id="systemLogsTable">
                    {% if systemLogs is not empty %}
                        {% for log in systemLogs %}
                        <tr>
                            <td>{{log.createdAt?.format('Y-m-d H:i:s') ?? ''}}</td>
                            <td>{{log.code ?? ''}}</td>
                            <td>{{log.level ?? ''}}</td>
                            <td>{{log.message ?? ''}}</td>
                            <td>{{log.route ?? ''}}</td>
                            <td>{{log.method ?? ''}}</td>
                            <td>{{log.requestIp ?? ''}}</td>
                        </tr>
                        {% endfor %}
                    {% else %}
                    <tr>
                        <td>Geen system logs gevonden</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </twig:Shared:Card:Content>
    </twig:Shared:Card>
</div>
{% endblock %}