{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Logs{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}
<script defer src="{{ asset("assets/admin/js/logs.css") }}"></script>
{% endblock %}

{# Page content #}
{% block body %}
    <h2>Audit Logs</h2>

    <table border="1" cellpadding="8">
        <thead>
        <tr>
            <th>Datum</th>
            <th>Gebruiker</th>
            <th>Email</th>
            <th>Actie</th>
            <th>Onderdeel</th>
            <th>Entity ID</th>
            <th>IP</th>
        </tr>
        </thead>
        <tbody id="auditLogsTable">
        <tr>
            <td colspan="7">Laden...</td>
        </tr>
        </tbody>
    </table>

    <br><br>

    <h2>System Logs</h2>

    <table border="1" cellpadding="8">
        <thead>
        <tr>
            <th>Datum</th>
            <th>Code</th>
            <th>Level</th>
            <th>Bericht</th>
            <th>Route</th>
            <th>Methode</th>
            <th>IP</th>
        </tr>
        </thead>
        <tbody id="systemLogsTable">
        <tr>
            <td colspan="7">Laden...</td>
        </tr>
        </tbody>
    </table>
{% endblock %}
