{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Logs{% endblock %}


{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/admin/css/logs.css") }}">
{% endblock %}

{% block body %}

<header>
    <h2>Logs</h2>
    <p>Overzicht van de 100 niewste Audit/System Logs.</p>
</header>


<div class="dashboard">


    <twig:Shared:Card>
        <twig:Shared:Card:Header>Zoek Audit Logs</twig:Shared:Card:Header>
        <twig:Shared:Card:Content>
            {{ component('Admin:AuditLogSearch',{
                formData: null,
            }) }}
        </twig:Shared:Card:Content>
    </twig:Shared:Card>

    <br><br>

    <twig:Shared:Card>
        <twig:Shared:Card:Header>Zoek System Logs</twig:Shared:Card:Header>
        <twig:Shared:Card:Content>
            {{ component('Admin:SystemLogSearch',{
                formData: null,
            }) }}
        </twig:Shared:Card:Content>
    </twig:Shared:Card>
</div>
{% endblock %}