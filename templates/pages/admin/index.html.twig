{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Home{% endblock %}

{% block stylesheets %}
<style>

    header{           
        text-align: center;
        margin-top: 20px;        
    }

    .dashboard {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 20px;
        margin: 20px;
        align-items: flex-start;

        .card{
            flex-grow:1;
        }
    }

    .empty {
        color: #888;
        font-size: 14px;
    }
</style>
{% endblock %}

{% block body %}

<header>
    <h2>Dashboard</h2>
    <p>Overzicht van de nieuwste data in het systeem.</p>
</header>

<div class="dashboard">

    <!-- Logs -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Nieuwste logs </twig:Shared:Card:Header>

        {% if logs is not empty %}
            <twig:Shared:Card:List>
                {% for log in logs %}
                    <twig:Shared:Card:Item>
                        {{ log.message }}
                        <small>{{ log.createdAt|date('d-m-Y H:i') }}</small>
                    </twig:Shared:Card:Item>
                {% endfor %}
            </twig:Shared:Card:List>
        {% else %}
            <twig:Shared:Card:Content>
                <p class="empty">Geen logs gevonden.</p>
            </twig:Shared:Card:Content>
        {% endif %}
        <twig:Shared:Card:Footer></twig:Shared:Card:Footer>
    </twig:Shared:Card>

    <!-- Accounts -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Laatst bijgewerkte accounts </twig:Shared:Card:Header>

        {% if accounts is not empty %}
            <twig:Shared:Card:List>
                {% for account in accounts %}
                    <twig:Shared:Card:Item>
                        {{ account.username }}
                        <small>{{ account.createdAt|date('d-m-Y H:i') }}</small>
                    </twig:Shared:Card:Item>
                {% endfor %}
            </twig:Shared:Card:List>
        {% else %}
            <twig:Shared:Card:Content>
                <p class="empty">Geen accounts gevonden.</p>
            </twig:Shared:Card:Content>
        {% endif %}
        <twig:Shared:Card:Footer></twig:Shared:Card:Footer>
    </twig:Shared:Card>

    <!-- Profiles -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Laatst bijgewerkte profielen </twig:Shared:Card:Header>

        {% if profiles is not empty %}
            <twig:Shared:Card:List>
                {% for profile in profiles %}
                    <twig:Shared:Card:Item>
                        {{ profile.firstName  }} {{ profile.lastName }}
                        <small>{{ profile.createdAt|date('d-m-Y H:i') }}</small>
                    </twig:Shared:Card:Item>
                {% endfor %}
            </twig:Shared:Card:List>
        {% else %}
            <twig:Shared:Card:Content>
                <p class="empty">Geen profielen gevonden.</p>
            </twig:Shared:Card:Content>
        {% endif %}
        <twig:Shared:Card:Footer></twig:Shared:Card:Footer>
    </twig:Shared:Card>

</div>

{% endblock %}
