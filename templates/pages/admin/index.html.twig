{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Home{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Dashboard</h2>
    <p>Overzicht van recente systeemgegevens.</p>
    <h3>Nieuwste systeemlogs</h3>
    <ul>
        {% for log in logs %}
            <li>{{ log.message }} — {{ log.createdAt|date('d-m-Y H:i') }}</li>
        {% else %}
            <li>Geen logs gevonden.</li>
        {% endfor %}
    </ul>
    <h3>Nieuwste accounts</h3>
    <ul>
        {% for account in accounts %}
            <li>{{ account.username }} — {{ account.createdAt|date('d-m-Y H:i') }}</li>
        {% else %}
            <li>Geen accounts gevonden.</li>
        {% endfor %}
    </ul>
    <h3>Nieuwste profielen</h3>
    <ul>
        {% for profile in profiles %}
            <li>{{ profile.displayName ?: 'Naamloos profiel' }} — {{ profile.createdAt|date('d-m-Y H:i') }}</li>
        {% else %}
            <li>Geen profielen gevonden.</li>
        {% endfor %}
    </ul>
{% endblock %}
