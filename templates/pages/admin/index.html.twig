{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Home{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/admin/css/index.css") }}">
{% endblock %}

{% block body %}

<header>
    <h2>Dashboard</h2>
    <p>Overzicht van de nieuwste data in het systeem.</p>
</header>

<div class="dashboard">

    <!-- Accounts -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Aantal Actieve Accounts </twig:Shared:Card:Header>
            <twig:Shared:Card:Content>
                {{ activeAccounts }}
            </twig:Shared:Card:Content>
    </twig:Shared:Card>

    <!-- Accounts -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Aantal Active Organisaties </twig:Shared:Card:Header>
        <twig:Shared:Card:Content>
                {{ activeOrganizations }}
            </twig:Shared:Card:Content>
    </twig:Shared:Card>

    <!-- Profiles -->
    <twig:Shared:Card>
        <twig:Shared:Card:Header>Aantal Active Projecten</twig:Shared:Card:Header>
            <twig:Shared:Card:Content>
                {{ activeProjects }}
            </twig:Shared:Card:Content>
    </twig:Shared:Card>

</div>

{% endblock %}
