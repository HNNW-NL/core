{% extends 'layouts/admin.base.html.twig' %}

{% block title %}Admin-dashboard{% endblock %}

{% block stylesheets %}
<style>
    .admin-dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 1rem;
        padding: 0;
    }

    .admin-dashboard-card {
        background: #1e1e1e;
        border-radius: 0.625rem;
        color: #fff;
        padding: 1rem;
    }

    .admin-dashboard-card dd {
        margin: 0.25rem 0 0;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .admin-dashboard-links {
        list-style: none;
    }

    .admin-dashboard-links a {
        display: block;
        color: inherit;
        text-decoration: underline;
    }

    .admin-dashboard-links a:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 0.25rem;
    }
</style>
{% endblock %}

{% block body %}
    {% set totals = admin_dashboard_totals() %}
    <h1>Admin-dashboard</h1>
    <p>Bekijk de platformtotalen en open de beheeronderdelen waarvoor je bevoegd bent.</p>

    <section aria-labelledby="dashboard-totals-heading">
        <h2 id="dashboard-totals-heading">Platformtotalen</h2>
        <p>De totalen tellen alle accounts, organisaties en projecten die niet verwijderd zijn.</p>

        <dl class="admin-dashboard-grid">
            <div class="admin-dashboard-card">
                <dt>Accounts</dt>
                <dd id="dashboard-total-accounts">{{ totals.accounts }}</dd>
            </div>
            <div class="admin-dashboard-card">
                <dt>Organisaties</dt>
                <dd id="dashboard-total-organisations">{{ totals.organisations }}</dd>
            </div>
            <div class="admin-dashboard-card">
                <dt>Projecten</dt>
                <dd id="dashboard-total-projects">{{ totals.projects }}</dd>
            </div>
        </dl>

        {% if totals.accounts == 0 and totals.organisations == 0 and totals.projects == 0 %}
            <p id="dashboard-empty">Er zijn nog geen accounts, organisaties of projecten om te tonen.</p>
        {% endif %}
    </section>

    <nav aria-labelledby="dashboard-navigation-heading">
        <h2 id="dashboard-navigation-heading">Beheeronderdelen</h2>
        <ul class="admin-dashboard-grid admin-dashboard-links">
            {% if is_granted('ADMIN_MANAGE_ACCOUNTS') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.accounts.home') }}">Accounts</a></li>
            {% endif %}
            {% if is_granted('ADMIN_MANAGE_ORGANISATIONS') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.organizations.home') }}">Organisaties <small>Beheer in ontwikkeling</small></a></li>
            {% endif %}
            {% if is_granted('ADMIN_VIEW_LOGS') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.logs') }}">Logs</a></li>
            {% endif %}
            {% if is_granted('ADMIN_MANAGE_SETTINGS') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.statuses') }}">Statussen <small>Statusbeheer volgt in AD11</small></a></li>
            {% endif %}
            <li><a class="admin-dashboard-card" href="{{ path('admin.notifications') }}">Meldingen <small>Beheer in ontwikkeling</small></a></li>
            {% if is_granted('ADMIN_MANAGE_SETTINGS') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.settings') }}">Instellingen <small>Beheer in ontwikkeling</small></a></li>
            {% endif %}
            {% if is_granted('ADMIN_MANAGE_STAFF') %}
                <li><a class="admin-dashboard-card" href="{{ path('admin.social.manageStaff') }}">Social beheer <small>Beheer in ontwikkeling</small></a></li>
            {% endif %}
            <li><a class="admin-dashboard-card" href="{{ path('admin.events.home') }}">Events <small>Beheer in ontwikkeling</small></a></li>
        </ul>
    </nav>
{% endblock %}
