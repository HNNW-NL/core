<nav class="main-breadcrumbs" aria-label="Kruimelpad">
    <ol>
        <li><a href="{{ path('main.home') }}">Home</a></li>

        {% for item in parents|default([]) %}
            <li>
                <a href="{{ item.url }}">{{ item.label }}</a>
            </li>
        {% endfor %}

        <li>
            <span aria-current="page">{{ currentPage }}</span>
        </li>
    </ol>
</nav>
