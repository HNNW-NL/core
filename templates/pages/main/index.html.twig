{% extends 'layouts/main.base.html.twig' %}

{% block title %}Het nieuw werken{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/main/css/home.css') }}">
{% endblock %}

{% block body %}

<div class="page">

    <!-- PROFIEL HEADER -->
    <div class="header">

        <div class="profile">

            <div class="profile-text">
                <h1>Het Nieuwe Werken</h1>
                <p>Concept profiel • Modern leren & werken</p>
            </div>

        </div>

    </div>

    <!-- PROFIEL CONTENT -->
    <div class="content">

        <!-- LINKERKANT -->
        <div>

            <div class="card">
                <h2>About me</h2>
                <p>
                    Het Nieuwe Werken is een moderne manier van leren en werken waarbij flexibiliteit,
                    digitale samenwerking en eigen verantwoordelijkheid centraal staan.
                </p>
            </div>

            <div class="card">
                <h2>Expertise</h2>

                <div class="expertise">
                    <div class="bubble">Expertise 1</div>
                    <div class="bubble">Expertise 2</div>
                    <div class="bubble">Expertise 3</div>
                </div>
            </div>

        </div>

        <!-- RECHTERKANT -->
        <div>

            <div class="card">
                <h2>Actions</h2>

                
                <a href="#" class="btn btn-primary">Edit profile</a>
                <a href="#" class="btn btn-secondary">Projects</a>

                <div class="tip">
                    <div class="tip-line"></div>
                    <div>
                        Leren en werken draait om resultaat, niet om plaats of tijd.
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}