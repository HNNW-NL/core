{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Samenwerken aan publieke opgaven{% endblock %}

{# SEO #}
{% block seoKeywords %}overheid, samenwerken, kennis delen, expertise, publieke sector{% endblock %}
{% block seoDescription %}HNNW brengt vraag en aanbod van werk in de overheid samen. Vind expertise, deel opdrachten en werk transparant samen aan publieke opgaven.{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/index.css') }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
{# Keep homepage content inside the dedicated homepage styling scope. #}
<div class="home-page">

{# Hero section introduces the platform and the primary action for new visitors. #}
<section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="hnnw-eyebrow">Open platform voor de overheid</p>
        <h1 id="hero-title">De juiste mensen voor publieke opgaven. <span>Open, eerlijk en transparant.</span></h1>
        <p class="hero-text">Vind expertise, deel hulpvragen en werk veilig samen aan maatschappelijke opgaven.</p>
        <div class="hero-actions">
            <a class="hnnw-button hnnw-button--primary" href="{{ path('main.projects.home') }}">Bekijk projecten</a>
            {% if app.session.get('account_id') %}
                <a class="hnnw-button hnnw-button--secondary" href="{{ path('account.home') }}">Mijn account</a>
            {% else %}
                <a class="hnnw-button hnnw-button--secondary" href="{{ path('auth.register') }}">Maak een account</a>
            {% endif %}
        </div>
        <p class="hero-reassurance">Voor ambtenaren en publieke teams.</p>
        <p class="hero-note">Open source platform voor de overheid</p>
    </div>

    <div class="hnnw-hero-visual" aria-hidden="true">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-center">{{ ux_icon('mdi:handshake', { 'aria-hidden': 'true' }) }}</div>
        <div class="visual-label label-top">Projecten</div>
        <div class="visual-label label-right">Mensen</div>
        <div class="visual-label label-bottom">Taken</div>
        <div class="visual-caption">Verbind projecten,<br>mensen en taken</div>
    </div>
</section>

{# Open projects highlight current opportunities for new contributors. #}
<section class="open-projects container" id="projects" aria-labelledby="open-projects-title">
    <div class="open-projects-heading">
        <div>
            <p class="hnnw-eyebrow">Doe mee</p>
            <h2 id="open-projects-title">Projecten met open aanmelding</h2>
        </div>
        <a class="open-projects-all" href="{{ path('main.projects.home') }}">Bekijk alle projecten</a>
    </div>

    {% if openProjects is not empty %}
        <div class="open-projects-grid">
            {% for project in openProjects %}
                <article class="open-project-card">
                    <h3><a href="{{ path('main.projects.detail', { slug: project.slug }) }}">{{ project.title }}</a></h3>
                    <p class="open-project-organisation">{{ project.ownerOrganisation.name }}</p>
                    <p class="open-project-summary">{{ project.summary }}</p>
                    <a class="open-project-link" href="{{ path('main.projects.detail', { slug: project.slug }) }}">Bekijk project</a>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p class="open-projects-empty">Er zijn op dit moment geen gepubliceerde projecten waarvoor je je kunt aanmelden.</p>
    {% endif %}
</section>

{# Example workflow explains how collaboration starts on the platform. #}
<section class="workflow container" aria-labelledby="workflow-title">
    <div class="workflow-card">
        <div class="workflow-intro">
            <p class="hnnw-eyebrow">Een voorbeeld</p>
            <h2 id="workflow-title">Zo kan samenwerking beginnen.</h2>
            <p>Een publiek team zoekt kennis voor een maatschappelijke opgave. Het deelt een hulpvraag, waarna mensen met passende ervaring kunnen reageren.</p>
        </div>
        <ol class="workflow-steps">
            <li>
                <span class="workflow-step-number">01</span>
                <h3>Deel een hulpvraag</h3>
                <p>Maak zichtbaar welke kennis of hulp het team zoekt.</p>
            </li>
            <li>
                <span class="workflow-step-number">02</span>
                <h3>Vind expertise</h3>
                <p>Breng mensen met relevante kennis en ervaring bij elkaar.</p>
            </li>
            <li>
                <span class="workflow-step-number">03</span>
                <h3>Werk samen</h3>
                <p>Sluit aan bij het team en werk aan de publieke opgave.</p>
            </li>
        </ol>
    </div>
</section>

{# Core platform benefits explain the value proposition for public teams. #}
<section class="features" id="voordelen" aria-labelledby="features-title">
    <div class="container">
        <div class="section-heading">
            <p class="hnnw-eyebrow">Waarom HNNW</p>
            <h2 id="features-title">Werk slimmer samen binnen en buiten je organisatie.</h2>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon feature-icon-search" aria-hidden="true"></span>
                <h3>Vind expertise</h3>
                <p>Zoek snel de juiste mensen, kennis en ervaring voor jouw opdracht of project.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon feature-icon-share" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <path d="m8.6 10.5 6.8-4"></path>
                        <path d="m8.6 13.5 6.8 4"></path>
                    </svg>
                </span>
                <h3>Deel werk</h3>
                <p>Maak vraag en aanbod zichtbaar, zodat teams sneller kunnen aansluiten en samenwerken.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon feature-icon-impact" aria-hidden="true"></span>
                <h3>Meet impact</h3>
                <p>Krijg inzicht in samenwerking, voortgang en resultaten op één plek.</p>
            </article>
        </div>
    </div>
</section>

{# Final conversion point for visitors ready to participate. #}
<section class="cta-band" id="contact">
    <div class="container cta-content">
        <div>
            <p class="hnnw-eyebrow">Aan de slag</p>
            <h2>Heb je vragen? We vertellen je graag meer.</h2>
        </div>
        <a class="hnnw-button hnnw-button--primary" href="mailto:contact@hnnw.nl">Neem contact op</a>
    </div>
</section>
</div>
{% endblock %}
