{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Home{% endblock %}

{# SEO #}

{% block seoKeywords %}samenwerken, overheid, expertise, open platform{% endblock %}
{% block seoDescription %}Ontdek hoe Het Nieuwe² Werken samenwerking en kennisdeling tussen overheidsorganisaties ondersteunt.{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}



{# CSS #}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/index.css') }}">
{% endblock %}



{# JavaScript #}

{% block javascript %}{% endblock %}



{# Page content #}

{% block body %}
{# Skip link keeps the homepage keyboard-friendly. #}
<a class="skip-link" href="#about">Direct naar de inhoud</a>



{# Hero introduces the platform and its primary call to action. #}
<section class="hero container" id="about" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Open platform voor de overheid</p>
        <h1 id="hero-title">Breng vraag &amp; aanbod van werk bij elkaar — <br><span>open, transparant en samen.</span></h1>
        <p class="hero-text">Publiceer hulpvragen, vind expertise binnen en buiten je organisatie, werk veilig samen en bouw aan interdepartementale impact.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="{{ path('main.projects.home') }}">Bekijk projecten</a>
            {% if app.user %}
                <a class="button button-secondary" href="{{ path('account.home') }}">Mijn account</a>
            {% else %}
                <a class="button button-secondary" href="{{ path('auth.register') }}">Nu aan de slag</a>
            {% endif %}
        </div>
        <p class="hero-note">
            Actief in ontwikkeling
            <span>•</span>
            Open-source
            <span>•</span>
            <a href="https://code.hnnw.nl">Forgejo</a>
        </p>
    </div>

    <div class="visual">
            <div class="center">
                {{ ux_icon('mdi:handshake', {'aria-hidden': 'true'}) }}
            </div>
        <p class="visual-text">Verbind projecten, mensen en taken.</p>
    </div>
</section>

{# Core platform benefits. #}
<section class="features" id="features" aria-labelledby="features-title">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Waarom HNNW</p>
            <h2 id="features-title">Werk slimmer samen binnen en buiten je organisatie.</h2>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon feature-icon-search" aria-hidden="true">{{ ux_icon('mdi:magnify', {'aria-hidden': 'true'}) }}</span>
                <h3>Vind expertise</h3>
                <p>Zoek snel de juiste mensen, kennis en ervaring voor jouw opdracht of project.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon feature-icon-share" aria-hidden="true">{{ ux_icon('mdi:puzzle', {'aria-hidden': 'true'}) }}</span>
                <h3>Deel werk</h3>
                <p>Maak vraag en aanbod zichtbaar, zodat teams sneller kunnen aansluiten en samenwerken.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon feature-icon-impact" aria-hidden="true">{{ ux_icon('mdi:web', {'aria-hidden': 'true'}) }}</span>
                <h3>Meet impact</h3>
                <p>Blijf inzichtelijk over samenwerking, voortgang en resultaten in één overzicht.</p>
            </article>
        </div>
    </div>
</section>

{# Final conversion point for visitors ready to participate. #}
<section class="cta-band" id="contact">
    <div class="container cta-content">
        <div>
            <p class="eyebrow">Aan de slag</p>
            <h2>Start vandaag nog met slimmer samenwerken.</h2>
        </div>
        <a class="button button-primary" href="mailto:contact@hnnw.nl">Neem contact op</a>
    </div>
</section>

<section class="open-projects container" id="projects" aria-labelledby="open-projects-title">
    <div class="open-projects-heading">
        <div>
            <p class="hnnw-eyebrow">Doe mee</p>
            <h2 id="open-projects-title">Openbare projecten</h2>
        </div>
        <a class="open-projects-all" href="{{ path('main.projects.home') }}">Bekijk alle projecten</a>
    </div>

    {% if publicProjects is not empty %}
        <div class="open-projects-grid">
            {% for project in publicProjects %}
                <article class="open-project-card">
                    <h3><a href="{{ path('main.projects.detail', { slug: project.slug }) }}">{{ project.title }}</a></h3>
                    <p class="open-project-organisation">{{ project.organisationName }}</p>
                    <p class="open-project-summary">{{ project.summary }}</p>
                    {% if project.skills is not empty %}
                        <p class="project-skills">Vaardigheden: {{ project.skills|join(', ') }}</p>
                    {% endif %}
                    <p class="project-location">
                        {% if project.location %}
                            {{ project.location }}
                        {% elseif project.remotePossible %}
                            Op afstand mogelijk
                        {% else %}
                            Locatie niet opgegeven
                        {% endif %}
                    </p>
                    <p class="project-status">Status: {{ project.projectStatus == 'published' ? 'Gepubliceerd' : project.projectStatus }}</p>
                    {% if project.canApply %}
                        <p class="project-application-open">Aanmelden mogelijk</p>
                    {% else %}
                        <p class="project-application-closed">Aanmelden niet mogelijk</p>
                    {% endif %}
                    <a class="open-project-link" href="{{ path('main.projects.detail', { slug: project.slug }) }}">Bekijk project</a>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p class="open-projects-empty">Er zijn op dit moment geen openbare projecten beschikbaar.</p>
    {% endif %}
</section>
{% endblock %}
