{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Home{% endblock %}

{# SEO #}

{% block seoKeywords %}{% endblock %}

{% block seoDescription %}{% endblock %}

{% block seoAuthor %}HNNW{% endblock %}



{# CSS #}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/Index.css') }}">
{% endblock %}



{# JavaScript #}

{% block javascript %}{% endblock %}



{# Page content #}

{% block body %}
<section class="hero container" id="about">
    <div class="hero-copy">
        <p class="eyebrow">Open platform voor de overheid</p>
        <h1>Breng vraag &amp; aanbod van werk bij elkaar <span>open, transparant en samen.</span></h1>
        <p class="hero-text">Publiceer hulpvragen, vind expertise binnen en buiten je organisatie, werk veilig samen en bouw aan interdepartementale impact.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="mailto:contact@hnnw.nl">Nu aan de slag</a>
            <a class="button button-secondary" href="https://hnnw.nl">Bezoek HNNW</a>
        </div>
        <p class="hero-note">Open bèta <span>•</span> Transparant via Codeberg <span>•</span> Community op Slack</p>
    </div>

    <div class="hero-visual" aria-label="Verbind projecten, mensen en taken">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-center">🤝</div>
        <div class="visual-label label-top">Projecten</div>
        <div class="visual-label label-right">Mensen</div>
        <div class="visual-label label-bottom">Taken</div>
        <div class="visual-caption">Verbind projecten,<br>mensen en taken</div>
    </div>
</section>

<section class="features" aria-label="Waarom HNNW werkt">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Waarom HNNW</p>
            <h2>Werk slimmer samen binnen en buiten je organisatie.</h2>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon">🔎</span>
                <h3>Vind expertise</h3>
                <p>Zoek snel de juiste mensen, kennis en ervaring voor jouw opdracht of project.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">🤝</span>
                <h3>Deel werk</h3>
                <p>Maak vraag en aanbod zichtbaar, zodat teams sneller kunnen aansluiten en samenwerken.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">📈</span>
                <h3>Meet impact</h3>
                <p>Blijf inzichtelijk over samenwerking, voortgang en resultaten in één overzicht.</p>
            </article>
        </div>
    </div>
</section>

<section class="stats-bar">
    <div class="container stats-grid">
        <div class="stat-item">
            <strong>1.200+</strong>
            <span>leden</span>
        </div>
        <div class="stat-item">
            <strong>340</strong>
            <span>projecten</span>
        </div>
        <div class="stat-item">
            <strong>85%</strong>
            <span>snellere matching</span>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container cta-content">
        <div>
            <p class="eyebrow">Aan de slag</p>
            <h2>Start vandaag nog met slimmer samenwerken.</h2>
        </div>
        <a class="button button-primary" href="mailto:contact@hnnw.nl">Neem contact op</a>
    </div>
</section>
{% endblock %}
