{% extends 'layouts/main.base.html.twig' %}

{% block title %}Project {{ slug }} Werkpakketten{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    {% include "core/main/_project_navigation.html.twig" %}
    {% set workPackageOverviews = workPackages %}
    {% set currentProfile = hnnw_current_profile() %}

    <section class="project-work-packages">
        <header class="project-work-packages__header">
            <h2>Werkpakketten</h2>
            <p>Bekijk de taken binnen dit project en schrijf jezelf in op een beschikbare taak.</p>
        </header>

        {% for flashType, flashMessages in app.flashes %}
            {% for flashMessage in flashMessages %}
                <div class="alert alert-{{ flashType }}">
                    {{ flashMessage }}
                </div>
            {% endfor %}
        {% endfor %}
        {% if currentProfile is null %}
            <p>Log in met een profiel om jezelf in te schrijven op taken.</p>
        {% endif %}

        {% if workPackageOverviews is empty %}
            <p>Er zijn nog geen werkpakketten of taken beschikbaar voor dit project.</p>
        {% else %}
            <div class="work-package-list">
                {% for workPackage in workPackageOverviews %}
                    {% set packageTasks = workPackage.workPackageTasks|filter(task => task.deletedAt is null) %}

                    <article class="work-package-card">
                        <header class="work-package-card__header">
                            <h3>{{ workPackage.title }}</h3>

                            {% if workPackage.dueDate %}
                                <p>Deadline: {{ workPackage.dueDate|date('d-m-Y') }}</p>
                            {% endif %}
                        </header>

                        {% if workPackage.description %}
                            <p>{{ workPackage.description }}</p>
                        {% else %}
                            <p>Geen beschrijving beschikbaar.</p>
                        {% endif %}

                        {% if packageTasks is empty %}
                            <p>Er zijn nog geen taken binnen dit werkpakket.</p>
                        {% else %}
                            <div class="package-task-list">
                                {% for packageTask in packageTasks %}
                                    {% set assignedProfile = packageTask.assignedProfile %}
                                    {% set isAssignedToCurrentProfile = currentProfile and assignedProfile and assignedProfile.id == currentProfile.id %}
                                    {% set statusName = packageTask.status.name %}
                                    {% set statusKey = statusName|lower %}
                                    {% if assignedProfile and statusKey in ['active', 'open'] %}
                                        {% set statusName = 'Assigned' %}
                                    {% elseif statusKey == 'active' %}
                                        {% set statusName = 'Open' %}
                                    {% elseif statusKey in ['assigned', 'toegewezen'] %}
                                        {% set statusName = 'Assigned' %}
                                    {% elseif statusKey in ['in progress', 'in-progress', 'in behandeling', 'bezig'] %}
                                        {% set statusName = 'In progress' %}
                                    {% elseif statusKey in ['changes requested', 'changes_requested'] %}
                                        {% set statusName = 'Changes requested' %}
                                    {% elseif statusKey == 'submitted' %}
                                        {% set statusName = 'Submitted' %}
                                    {% elseif statusKey == 'accepted' %}
                                        {% set statusName = 'Accepted' %}
                                    {% endif %}
                                    {% set workflowEvent = taskWorkflowEvents[packageTask.id.toBase32()] ?? null %}
                                    {% set workflowValues = workflowEvent ? workflowEvent.newValuesJson|default({}) : {} %}

                                    <article class="package-task-card">
                                        <div class="package-task-card__content">
                                            <h4>{{ packageTask.title }}</h4>
                                            <p>Status: {{ statusName }}</p>

                                            {% if packageTask.description %}
                                                <p>{{ packageTask.description }}</p>
                                            {% endif %}

                                            <p>
                                                Prioriteit: {{ packageTask.priority|capitalize }}
                                                {% if packageTask.dueDate %}
                                                    · Deadline: {{ packageTask.dueDate|date('d-m-Y') }}
                                                {% endif %}
                                            </p>
                                            {% if workflowValues.submission is defined and workflowValues.submission %}
                                                <p>Jouw ingediende resultaat: {{ workflowValues.submission }}</p>
                                            {% endif %}
                                            {% if workflowValues.review_reason is defined and workflowValues.review_reason %}
                                                <p>Reviewreden: {{ workflowValues.review_reason }}</p>
                                            {% endif %}
                                        </div>

                                        <div class="package-task-card__action">
                                            {% if assignedProfile %}
                                                {% if isAssignedToCurrentProfile %}
                                                    {% if statusName == 'Assigned' %}
                                                        <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                                            <input type="hidden" name="action" value="start">
                                                            <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('package-task-start-' ~ packageTask.id) }}">
                                                            <button type="submit">Start taak</button>
                                                        </form>
                                                    {% elseif statusName == 'Changes requested' %}
                                                        <p>De projectleider heeft om aanpassingen gevraagd.</p>
                                                        <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                                            <input type="hidden" name="action" value="start">
                                                            <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('package-task-start-' ~ packageTask.id) }}">
                                                            <button type="submit">Verder werken</button>
                                                        </form>
                                                    {% elseif statusName == 'In progress' %}
                                                        <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                                            <input type="hidden" name="action" value="submit">
                                                            <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('package-task-submit-' ~ packageTask.id) }}">
                                                            <label>
                                                                Resultaat
                                                                <textarea name="submission" maxlength="20000" required></textarea>
                                                            </label>
                                                            <button type="submit">Resultaat indienen</button>
                                                        </form>
                                                    {% elseif statusName == 'Submitted' %}
                                                        <span>Je resultaat wacht op beoordeling.</span>
                                                    {% elseif statusName == 'Accepted' %}
                                                        <span>Je resultaat is geaccepteerd.</span>
                                                    {% else %}
                                                        <span>Jij bent ingeschreven op deze taak.</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span>Deze taak is al toegewezen.</span>
                                                {% endif %}
                                            {% elseif currentProfile %}
                                                <form method="post" action="{{ path('main.projects.workPackages.enrollTask', { slug: slug, taskId: packageTask.id.toRfc4122() }) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('enroll-package-task-' ~ packageTask.id.toRfc4122()) }}">
                                                    <button type="submit">Inschrijven</button>
                                                </form>
                                            {% else %}
                                                <span>Beschikbaar</span>
                                            {% endif %}
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
