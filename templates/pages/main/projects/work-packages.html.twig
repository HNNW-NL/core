{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Project {{ slug }} Werkpakketten{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>Werkpakketten</h2>

    <p>Overzicht van de werkpakketten voor project {{ slug }}.</p>

    {% if workPackages is defined and workPackages is not empty %}
        {% for workPackage in workPackages %}
            <div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 15px;">
                <h3>{{ workPackage.title }}</h3>

                {% if workPackage.description is not empty %}
                    <p>{{ workPackage.description }}</p>
                {% else %}
                    <p>Geen beschrijving beschikbaar.</p>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <p>Er zijn nog geen werkpakketten gekoppeld aan dit project.</p>
    {% endif %}
{% endblock %} 
