{% extends 'layouts/main.base.html.twig' %}

{% block title %}Taken{% endblock %}

{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}
    
{% block body %}
    {% set workPackageOverviews = hnnw_work_package_overviews(slug) %}
    {% set currentProfile = hnnw_current_profile() %}

    <section class="project-tasks">
        <header>
            <h2>Taken</h2>
            <p>Bekijk de beschikbare taken en schrijf jezelf in.</p>
        </header>

        {% for flashType, flashMessages in app.flashes %}
            {% for flashMessage in flashMessages %}
                <div class="alert alert-{{ flashType }}">
                    {{ flashMessage }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if currentProfile is null %}
            <p>Log in met een profiel om jezelf in te schrijven op taken.</p>
        {% endif %}

        {% for overview in workPackageOverviews %}
            {% set workPackage = overview.workPackage %}
            {% set packageTasks = overview.packageTasks %}

            {% if packageTasks is not empty %}
                <h3>{{ workPackage.title }}</h3>

                {% for packageTask in packageTasks %}
                    {% set assignedProfile = packageTask.assignedProfile %}
                    {% set isMine = currentProfile and assignedProfile and assignedProfile.id == currentProfile.id %}

                    <article>
                        <h4>{{ packageTask.title }}</h4>

                        {% if packageTask.description %}
                            <p>{{ packageTask.description }}</p>
                        {% endif %}

                        <p>Prioriteit: {{ packageTask.priority|capitalize }}</p>

                        {% if assignedProfile %}
                            {% if isMine %}
                                <p>Jij bent ingeschreven op deze taak.</p>
                            {% else %}
                                <p>Deze taak is al toegewezen.</p>
                            {% endif %}
                        {% elseif currentProfile %}
                            <form method="post"
                                  action="{{ path('main.projects.tasks.enroll', {
                                      slug: slug,
                                      taskId: packageTask.id.toRfc4122()
                                  }) }}">

                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('enroll-package-task-' ~ packageTask.id.toRfc4122()) }}">

                                <button type="submit">Inschrijven</button>
                            </form>
                        {% else %}
                            <p>Beschikbaar</p>
                        {% endif %}
                    </article>
                {% endfor %}
            {% endif %}
        {% else %}
            <p>Er zijn geen taken beschikbaar.</p>
        {% endfor %}
    </section>
{% endblock %}