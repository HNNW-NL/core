{% extends 'layouts/main.base.html.twig' %}

{% block title %}Taken{% endblock %}

{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}
    
{% block body %}
    {% include "core/main/_project_navigation.html.twig" %}
    {% set workPackageOverviews = hnnw_work_package_overviews(slug) %}
    {% set currentProfile = hnnw_current_profile() %}

    <section class="project-tasks">
        <header>
            <h2>Taken</h2>
            <p>Schrijf jezelf in, werk aan je taak en dien je resultaat ter beoordeling in.</p>
        </header>

        {% for flashType, flashMessages in app.flashes %}
            {% for flashMessage in flashMessages %}
                <div class="alert alert-{{ flashType }}">
                    {{ flashMessage }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if currentProfile is null %}
            <p>Log in met een profiel om jezelf in te schrijven op taken.</p>
        {% endif %}

        {% for overview in workPackageOverviews %}
            {% set workPackage = overview.workPackage %}
            {% set packageTasks = overview.packageTasks %}

            {% if packageTasks is not empty %}
                <h3>{{ workPackage.title }}</h3>

                {% for packageTask in packageTasks %}
                    {% set assignedProfile = packageTask.assignedProfile %}
                    {% set isMine = currentProfile and assignedProfile and assignedProfile.id == currentProfile.id %}
                    {% set statusName = packageTask.status.name %}
                    {% set statusKey = statusName|lower %}
                    {% if assignedProfile and statusKey in ['active', 'open'] %}
                        {% set statusName = 'Assigned' %}
                    {% elseif statusKey == 'active' %}
                        {% set statusName = 'Open' %}
                    {% elseif statusKey in ['assigned', 'toegewezen'] %}
                        {% set statusName = 'Assigned' %}
                    {% elseif statusKey in ['in progress', 'in-progress', 'in behandeling', 'bezig'] %}
                        {% set statusName = 'In progress' %}
                    {% elseif statusKey in ['changes requested', 'changes_requested'] %}
                        {% set statusName = 'Changes requested' %}
                    {% elseif statusKey == 'submitted' %}
                        {% set statusName = 'Submitted' %}
                    {% elseif statusKey == 'accepted' %}
                        {% set statusName = 'Accepted' %}
                    {% endif %}
                    {% set workflowEvent = taskWorkflowEvents[packageTask.id.toBase32()] ?? null %}
                    {% set workflowValues = workflowEvent ? workflowEvent.newValuesJson|default({}) : {} %}

                    <article>
                        <h4>{{ packageTask.title }}</h4>

                        {% if packageTask.description %}
                            <p>{{ packageTask.description }}</p>
                        {% endif %}

                        <p>Prioriteit: {{ packageTask.priority|capitalize }}</p>
                        <p>Status: {{ statusName }}</p>
                        {% if workflowValues.submission is defined and workflowValues.submission %}
                            <p>Jouw ingediende resultaat: {{ workflowValues.submission }}</p>
                        {% endif %}
                        {% if workflowValues.review_reason is defined and workflowValues.review_reason %}
                            <p>Reviewreden: {{ workflowValues.review_reason }}</p>
                        {% endif %}

                        {% if assignedProfile %}
                            {% if isMine %}
                                {% if statusName == 'Assigned' %}
                                    {% set action = 'start' %}
                                    <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                        <input type="hidden" name="action" value="{{ action }}">
                                        <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('package-task-' ~ action ~ '-' ~ packageTask.id) }}">
                                        <button type="submit">Start taak</button>
                                    </form>
                                {% elseif statusName == 'Changes requested' %}
                                    {% set action = 'start' %}
                                    <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                        <input type="hidden" name="action" value="{{ action }}">
                                        <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('package-task-' ~ action ~ '-' ~ packageTask.id) }}">
                                        <button type="submit">Verder werken</button>
                                    </form>
                                {% elseif statusName == 'In progress' %}
                                    {% set action = 'submit' %}
                                    <form method="post" action="{{ path('main.projects.workPackages', { slug: slug }) }}">
                                        <input type="hidden" name="action" value="{{ action }}">
                                        <input type="hidden" name="task_id" value="{{ packageTask.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('package-task-' ~ action ~ '-' ~ packageTask.id) }}">
                                        <label>
                                            Resultaat
                                            <textarea name="submission" maxlength="20000" required></textarea>
                                        </label>
                                        <button type="submit">Resultaat indienen</button>
                                    </form>
                                {% elseif statusName == 'Submitted' %}
                                    <p>Je resultaat wacht op beoordeling.</p>
                                {% elseif statusName == 'Accepted' %}
                                    <p>Je resultaat is geaccepteerd.</p>
                                {% else %}
                                    <p>Jij bent ingeschreven op deze taak.</p>
                                {% endif %}
                            {% else %}
                                <p>Deze taak is al toegewezen.</p>
                            {% endif %}
                        {% elseif currentProfile %}
                            <form method="post"
                                  action="{{ path('main.projects.workPackages.enrollTask', {
                                      slug: slug,
                                      taskId: packageTask.id.toRfc4122()
                                  }) }}">

                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('enroll-package-task-' ~ packageTask.id.toRfc4122()) }}">

                                <button type="submit">Inschrijven</button>
                            </form>
                        {% else %}
                            <p>Beschikbaar</p>
                        {% endif %}
                    </article>
                {% endfor %}
            {% endif %}
        {% else %}
            <p>Er zijn geen taken beschikbaar.</p>
        {% endfor %}
    </section>
{% endblock %}
