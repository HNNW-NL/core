{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Project {{ slug }} reviews{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    {% set reviews = project.reviews|filter(review => review.isPublic and review.deletedAt is null) %}

    <h2>Reviews</h2>
    <p>Reviews van project {{ project.title }}.</p>

    {% if reviews is not empty %}
        <div class="participants-grid">
            {% for review in reviews %}
                <article class="participant-card">
                    <h3>{{ review.title|default('Review') }}</h3>
                    {% if review.rating is not null %}
                        <p>Beoordeling {{ review.rating }}/5</p>
                    {% endif %}
                    {% if review.message %}
                        <p>{{ review.message }}</p>
                    {% endif %}
                    <small>{{ review.createdAt|date('d-m-Y') }}</small>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p class="empty">Nog geen reviews gevonden.</p>
    {% endif %}
{% endblock %}
