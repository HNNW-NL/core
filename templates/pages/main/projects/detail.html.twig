{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Project {{ slug }} details{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <h2>{{ project.title }}</h2>

    {% if project.summary %}
        <p>{{ project.summary }}</p>
    {% endif %}

    {% if project.visibility == 'public'
        and project.publishedAt is not null
        and project.deletedAt is null %}
        <a href="{{ path('main.projects.apply', {slug: slug}) }}"
           class="btn-primary">
            Aanmelden voor dit project
        </a>
    {% endif %}
{% endblock %}
