{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Project
	{{ slug }}
	participants
{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW
{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
	<h2>Projects - Participants</h2>
	<p>Main - projects participants page. For project
		{{ slug }}.</p>
	<h2>Deelnemers</h2>
	<p>Deelnemers van project
		{{ slug }}.</p>

	{% if participants is not empty %}
		<div class="participants-grid">
			{% for participant in participants %}
				<div class="participant-card">
					{% if participant.avatarUrl %}
						<img src="{{ participant.avatarUrl }}" alt="{{ participant.fullName }}" class="participant-avatar">
					{% endif %}
					<h3>{{ participant.fullName }}</h3>
					{% if participant.roleName %}
						<p class="participant-role">{{ participant.roleName }}</p>
					{% endif %}
					<p class="participant-status">{{ participant.statusName }}</p>
					{% if participant.joinedAt %}
						<small>Lid sinds
							{{ participant.joinedAt|date('d-m-Y') }}</small>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	{% else %}
		<p class="empty">Nog geen deelnemers gevonden.</p>
	{% endif %}
{% endblock %}
