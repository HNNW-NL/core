{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Project {{ slug }} participants{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
	<h2>Deelnemers</h2>
	<p>Deelnemers van project {{ overview.project.title }}.</p>

	{% if overview.participants is not empty %}
		<div class="participants-grid">
			{% for participant in overview.participants %}
				<div class="participant-card">
					{% if participant.profile.avatarUrl %}
						<img src="{{ participant.profile.avatarUrl }}" alt="{{ participant.profile.displayName|default(participant.profile.firstName) }}" class="participant-avatar">
					{% endif %}
					<h3>{{ participant.profile.displayName|default(participant.profile.firstName ~ ' ' ~ participant.profile.lastName) }}</h3>
					{% if participant.role %}
						<p class="participant-role">{{ participant.role.name }}</p>
					{% endif %}
					<p class="participant-status">{{ participant.status.name }}</p>
					{% if participant.joinedAt %}
						<small>Lid sinds {{ participant.joinedAt|date('d-m-Y') }}</small>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	{% else %}
		<p class="empty">Nog geen deelnemers gevonden.</p>
	{% endif %}
{% endblock %}