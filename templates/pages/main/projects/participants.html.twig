{% extends 'layouts/main.base.html.twig' %}
{% block title %}Deelnemers · {{ project.title }}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/main/css/participants.css') }}">
{% endblock %}
{% block body %}
<section class="participants-page">
    <a class="participants-back" href="{{ path('main.projects.detail', {slug: project.slug}) }}">Terug naar {{ project.title }}</a>
    <div class="participants-heading">
        <div><h1>Projectdeelnemers</h1><p>{{ project.title }}</p></div>
        <p>{{ participants.total }} {{ participants.total == 1 ? 'deelnemer' : 'deelnemers' }}</p>
    </div>
    {% if is_granted('PROJECT_EDIT', project) and is_granted('ORG_MANAGE_PROJECTS', project.ownerOrganisation) %}
        <p class="participants-back"><a href="{{ path('org.modifyProject.participants', {id: project.id ~ ''}) }}">Aanvragen en deelnemers beheren</a></p>
    {% endif %}
    <ul class="participant-grid">
        {% for participant in participants.items %}
            <li class="participant-card">
                {% if participant.avatar %}
                    <img class="participant-avatar" src="{{ participant.avatar }}" alt="" referrerpolicy="no-referrer" loading="lazy">
                {% else %}
                    <span class="participant-avatar participant-avatar--empty" aria-hidden="true">{{ participant.name|slice(0, 1)|upper }}</span>
                {% endif %}
                <div class="participant-info">
                    <h2>{% if participant.username %}<a href="{{ path('main.profile', {slug: participant.username}) }}">{{ participant.name }}</a>{% else %}{{ participant.name }}{% endif %}</h2>
                    <p>{{ participant.roles|join(' · ')|default('Deelnemer') }}</p>
                </div>
            </li>
        {% else %}
            <li class="participant-empty">Er zijn nog geen actieve deelnemers.</li>
        {% endfor %}
    </ul>
    {% if participants.pages > 1 %}
        <nav class="participants-pagination" aria-label="Paginering projectdeelnemers">
            {% if participants.page > 1 %}<a rel="prev" href="{{ path('main.projects.participants', {slug: project.slug, page: participants.page - 1}) }}">Vorige</a>{% endif %}
            <span>Pagina {{ participants.page }} van {{ participants.pages }}</span>
            {% if participants.page < participants.pages %}<a rel="next" href="{{ path('main.projects.participants', {slug: project.slug, page: participants.page + 1}) }}">Volgende</a>{% endif %}
        </nav>
    {% endif %}
</section>
{% endblock %}
