{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Applying for project {{ slug }}{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    {% if verification_required|default(false) %}
        <h1>Bevestig eerst je e-mailadres</h1>
        <p role="alert">Open de bevestigingslink in je e-mail voordat je je aanmeldt voor een project.</p>
        <p><a href="{{ path('account.home') }}">Terug naar mijn account</a></p>
    {% else %}
        <h1>Aanmelden voor {{ project.title }}</h1>
        <p><a href="{{ path('main.projects.detail', {slug: slug}) }}">Terug naar het project</a></p>
    {% endif %}
{% endblock %}
