{% extends 'layouts/main.base.html.twig' %}

{% block title %}Profiel van {{ profile.displayName }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/profile.css') }}">
{% endblock %}

{% block body %}
    <div class="profile-page">
        <header class="profile-header">
            <div class="profile-avatar">
                {% if profile.avatarUrl %}
                    <img src="{{ profile.avatarUrl }}" alt="Profielfoto van {{ profile.displayName }}">
                {% else %}
                    <span class="profile-avatar-placeholder" aria-hidden="true">{{ profile.displayName|first|upper }}</span>
                {% endif %}
            </div>

            <div class="profile-text">
                <h1>{{ profile.displayName }}</h1>
                <p>@{{ profile.username }}</p>
            </div>
        </header>

        <div class="profile-grid">
            <section class="profile-card card-about-me" aria-labelledby="about-title">
                <h2 id="about-title">Over mij</h2>
                <p class="text-muted">{{ profile.biography ?: 'Deze gebruiker heeft nog geen biografie toegevoegd.' }}</p>

                <h2>Vaardigheden</h2>
                {% if profile.skills is not empty %}
                    <ul class="public-profile-list">
                        {% for skill in profile.skills %}
                            <li>
                                {{ skill.name }}
                                {% if skill.proficiency %}
                                    <span class="text-muted">({{ skill.proficiency }})</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted">Er zijn nog geen openbare vaardigheden toegevoegd.</p>
                {% endif %}
            </section>

            <section class="profile-card profile-actions" aria-labelledby="experience-title">
                <h2 id="experience-title">Ervaring</h2>
                {% if profile.experiences is not empty %}
                    <ul class="public-profile-list">
                        {% for experience in profile.experiences %}
                            <li>
                                <strong>{{ experience.title }}</strong>
                                <span>{{ experience.organisation }}</span>
                                <span class="text-muted">
                                    {{ experience.startDate|date('m-Y') }} –
                                    {% if experience.isCurrent %}heden{% elseif experience.endDate %}{{ experience.endDate|date('m-Y') }}{% else %}onbekend{% endif %}
                                </span>
                                {% if experience.description %}
                                    <p class="text-muted">{{ experience.description }}</p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted">Er is nog geen openbare ervaring toegevoegd.</p>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
