{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}Vacatures{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <section>
        <h1>Vacatures</h1>

        <form method="get" action="{{ path('main.jobs.home') }}" role="search">
            <label for="job-search">Zoek op functietitel of trefwoord</label>
            <input
                type="search"
                id="job-search"
                name="q"
                value="{{ q }}"
                maxlength="100"
                placeholder="Bijvoorbeeld: developer"
            >
            <button type="submit">Zoeken</button>
            {% if q is not empty %}
                <a href="{{ path('main.jobs.home') }}">Zoekopdracht wissen</a>
            {% endif %}
        </form>

        {% if q is not empty %}
            <p>
                {{ jobs|length }}
                {{ jobs|length == 1 ? 'resultaat' : 'resultaten' }}
                voor &ldquo;{{ q }}&rdquo;
            </p>
        {% endif %}

        {% for job in jobs %}
            <article>
                <h2>
                    <a href="{{ path('main.jobs.detail', {slug: job.slug}) }}">
                        {{ job.title }}
                    </a>
                </h2>
                {% if job.organisation %}<p>{{ job.organisation.name }}</p>{% endif %}
                {% if job.location %}<p>{{ job.location }}</p>{% endif %}
                {% if job.description %}<p>{{ job.description|striptags|slice(0, 250) }}</p>{% endif %}
                {% if job.applicationUrl %}
                    <a href="{{ job.applicationUrl }}" target="_blank" rel="noopener noreferrer">Solliciteren via externe website</a>
                {% endif %}
            </article>
        {% else %}
            {% if q is not empty %}
                <p>Geen vacatures gevonden voor &ldquo;{{ q }}&rdquo;. Controleer de spelling of probeer een andere zoekterm.</p>
            {% else %}
                <p>Er zijn momenteel geen gepubliceerde vacatures beschikbaar.</p>
            {% endif %}
        {% endfor %}
    </section>
{% endblock %}
