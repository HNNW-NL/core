                    </a>
                </div>

                <div id="p-info">
                    <div id="pi-core">
                        <div id="pc-info">
                            <div id="pci-title">
                                <div id="pci-name">
                                    <div id="pcin-name">
                                        <h1>Riley de Man</h1>
                                    </div>
                                    <figure id="pcin-verification">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m8.38 12l2.41 2.42l4.83-4.84"/><path d="M10.75 2.45c.69-.59 1.82-.59 2.52 0l1.58 1.36c.3.26.86.47 1.26.47h1.7c1.06 0 1.93.87 1.93 1.93v1.7c0 .39.21.96.47 1.26l1.36 1.58c.59.69.59 1.82 0 2.52l-1.36 1.58c-.26.3-.47.86-.47 1.26v1.7c0 1.06-.87 1.93-1.93 1.93h-1.7c-.39 0-.96.21-1.26.47l-1.58 1.36c-.69.59-1.82.59-2.52 0l-1.58-1.36c-.3-.26-.86-.47-1.26-.47H6.18c-1.06 0-1.93-.87-1.93-1.93V16.1c0-.39-.21-.95-.46-1.25l-1.35-1.59c-.58-.69-.58-1.81 0-2.5l1.35-1.59c.25-.3.46-.86.46-1.25V6.2c0-1.06.87-1.93 1.93-1.93h1.73c.39 0 .96-.21 1.26-.47z"/></g></svg>
                                    </figure>
                                </div>
                                <div id="pci-pronouns">
                                    <p>He/Him</p>
                                </div>
                            </div>

                            <p id="pci-headline">Software Engineer & Software  Developer | Software Engineer intern @ SCC-ICT | Product Owner & Lead Developer Het Nieuwe² Werken (HNNW) @ DIVD Academy</p>
                        </div>
                        <div id="pc-companies">
                            <p>Companies</p>
                        </div>
                    </div>
                    <div id="pi-website">
                        <a id="piw-link" href="https://rileydeman.com" target="_blank">
                            <p>rileydeman.com</p>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6v2H5v12h12v-6zM13 3v2h4.586l-7.793 7.793l1.414 1.414L19 6.414V11h2V3z"/></svg>
                        </a>
                    </div>
                    <div id="pi-stats">
                        <p>Stats (e.g. XX connections, XX projects)</p>
                    </div>
                    <div id="pi-btns">
                        <p>Buttons</p>
                    </div>
                </div>
            </section>
        </article>

        <section id="suggestions"></section>
    </div>
{% endblock %}
