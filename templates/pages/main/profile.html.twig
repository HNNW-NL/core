{% extends 'layouts/main.base.html.twig' %}

{# Page title meta tag #}
{% block title %}{{ slug }}{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset("assets/main/css/home.css") }}">
    <link rel="stylesheet" href="{{ asset("assets/main/css/profile.css") }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}{% endblock %}

{# Page content #}
{% block body %}
    <div id="inner-main">
        <article id="profile">
            <section id="basic-info">
                <figure id="p-cover">
                    <img id="pc-img" src="https://media.licdn.com/dms/image/v2/D5616AQHtxtU_sS1o7w/profile-displaybackgroundimage-shrink_200_800/B56Zl2YtDMHUAU-/0/1758627819695?e=1794441600&v=beta&t=ZiD7Z1BJWgWRmtmRrDPZjT7PravrhrK5zkbA81-h-ws" alt="">
                </figure>

                <div id="p-image">
                    <figure id="p-avatar">
                        <img src="https://media.licdn.com/dms/image/v2/D4E03AQGx8fit2XBp2A/profile-displayphoto-scale_400_400/B4EaD3zpHZK8Ag-/0/1790863906206?e=1794441600&v=beta&t=W3uTqqtcOYTucKEcldnKQ4OYZemJ-0MxI8Xnx2LVAcg" alt="">
                    </figure>
                    <a id="pi-icon" href="">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M14.826 19A3 3 0 0 1 12 21a3 3 0 0 1-2.825-2zM12 2a7 7 0 0 1 7 7v3.528a1 1 0 0 0 .106.447l1.717 3.433A1.1 1.1 0 0 1 19.838 18H4.162a1.1 1.1 0 0 1-.984-1.592l1.717-3.433A1 1 0 0 0 5 12.528V9a7 7 0 0 1 7-7"/></svg>
                    </a>
                </div>
            </section>
        </article>

        <section id="suggestions"></section>
    </div>
{% endblock %}
