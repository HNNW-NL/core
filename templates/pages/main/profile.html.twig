{% extends 'layouts/ac.base.html.twig' %}

{% block title %}Mijn profiel{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/account-centre/css/profile.css') }}">
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('assets/account-centre/js/profile.js') }}" defer></script>
{% endblock %}

{% block body %}
{% set account = app.user %}
{% set fullName = profile ? (profile.firstName ~ ' ' ~ profile.lastName)|trim : '' %}
{% set displayName = (profile ? profile.displayName : '') ?: fullName ?: (account ? account.username : 'Mijn profiel') %}
{% set isOnline = profile and profile.online %}
<section class="profile-page" aria-labelledby="profile-name">
    <a class="profile-back" href="{{ path(account ? 'account.home' : 'main.home') }}">
        <span aria-hidden="true">&larr;</span> {{ account ? 'Terug naar dashboard' : 'Terug naar home' }}
    </a>

    <div class="profile-hero">
        <div class="profile-identity">
            <div class="profile-avatar" aria-hidden="true">
                <span>{{ displayName|slice(0, 1)|upper }}</span>
                {% if profile and profile.avatarUrl %}
                    <img src="{{ profile.avatarUrl }}" alt="" referrerpolicy="no-referrer" data-profile-avatar>
                {% endif %}
            </div>
            <div id="profile-text">
                <p class="profile-eyebrow">Mijn profiel</p>
                <h1 id="profile-name">{{ displayName }}</h1>
                {% if account %}<p class="profile-username">@{{ account.username }}</p>{% endif %}
                {% if account %}
                    <p id="profile-presence" class="profile-presence{{ isOnline ? ' is-online' : '' }}"><span aria-hidden="true"></span>Status: {{ isOnline ? 'Online' : 'Offline' }}</p>
                {% endif %}
            </div>
        </div>
        <a class="profile-button profile-button-primary" href="{{ path(account ? 'account.modify' : 'auth.login') }}">{{ account ? 'Profiel wijzigen' : 'Inloggen' }} <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="profile-grid">
        <div class="profile-main">
            <section class="profile-panel" aria-labelledby="profile-about-title">
                <p class="profile-eyebrow">Even voorstellen</p>
                <h2 id="profile-about-title">Over mij</h2>
                {% if profile and profile.description %}
                    <p class="profile-description">{{ profile.description }}</p>
                {% else %}
                    <p class="profile-muted">Je hebt nog niets over jezelf verteld. Laat weten wie je bent, wat je graag doet en waar je aan wilt bijdragen.</p>
                    {% if account %}<a class="profile-text-link" href="{{ path('account.modify') }}">Voeg een introductie toe <span aria-hidden="true">&rarr;</span></a>{% endif %}
                {% endif %}
            </section>
            {% if account %}
                <section class="profile-panel profile-next" aria-labelledby="profile-next-title">
                    <div><h2 id="profile-next-title">Samen aan de slag</h2><p class="profile-muted">Bekijk je projecten en ontdek waar je kunt bijdragen.</p></div>
                    <div class="profile-actions">
                        <a class="profile-button profile-button-secondary" href="{{ path('account.projects') }}">Mijn projecten <span aria-hidden="true">&rarr;</span></a>
                        <a class="profile-text-link" href="{{ path('main.projects.home') }}">Ontdek projecten</a>
                    </div>
                </section>
            {% else %}
                <section class="profile-panel"><h2>Jouw plek bij HNNW</h2><p class="profile-muted">Log in om je profiel en projecten te bekijken.</p></section>
            {% endif %}
        </div>

        <aside class="profile-panel profile-details" aria-labelledby="profile-details-title">
            <h2 id="profile-details-title">Profielgegevens</h2>
            <dl>
                <div><dt>Locatie</dt><dd><span id="current-location">{{ profile and profile.location ? profile.location : 'Niet ingesteld' }}</span>{% if account %}<button class="profile-text-link" type="button" data-location-open aria-haspopup="dialog">Wijzigen</button>{% endif %}</dd></div>
                {% if account %}
                    <div><dt>E-mailadres</dt><dd>{{ account.email }}</dd></div>
                    <div><dt>E-mailverificatie</dt><dd class="profile-verification{{ account.emailVerifiedAt ? ' is-verified' : '' }}">{{ account.emailVerifiedAt ? 'Bevestigd' : 'Nog niet bevestigd' }}</dd></div>
                    <div><dt>Laatst ingelogd</dt><dd>{{ account.lastLoginAt ? account.lastLoginAt|date('d-m-Y H:i') : 'Onbekend' }}</dd></div>
                {% endif %}
            </dl>
            {% if account %}<a class="profile-settings" href="{{ path('account.settings') }}">Accountinstellingen <span aria-hidden="true">&rarr;</span></a>{% endif %}
        </aside>
    </div>

    {% if account %}
        <dialog id="location-popup" class="profile-location-dialog" aria-labelledby="location-title">
            <form id="profile-location-form" action="{{ path('profile_update_location') }}" method="post">
                <p class="profile-eyebrow">Jouw profiel</p>
                <h2 id="location-title">Locatie wijzigen</h2>
                <p class="profile-muted">In welke plaats ben je te vinden?</p>
                <label for="new-location">Plaats</label>
                <input type="text" id="new-location" name="location" list="profile-cities" value="{{ profile ? profile.location : '' }}" maxlength="255" placeholder="Bijvoorbeeld Den Haag" required>
                <datalist id="profile-cities">
                    {% for city in ['Den Haag', 'Amsterdam', 'Rotterdam', 'Utrecht', 'Eindhoven', 'Groningen', 'Maastricht'] %}<option value="{{ city }}"></option>{% endfor %}
                </datalist>
                <p id="profile-location-error" class="profile-location-error" role="alert" hidden></p>
                <div class="profile-actions">
                    <button class="profile-button profile-button-primary" type="submit">Opslaan</button>
                    <button class="profile-button profile-button-secondary" type="button" data-location-close>Annuleren</button>
                </div>
            </form>
        </dialog>
    {% endif %}
</section>
{% endblock %}
