{% extends 'layouts/main.base.html.twig' %}

{% block title %}
	Profiel
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('assets/main/css/home.css') }}">
{% endblock %}

{% block javascript %}
	{# defer: het script wacht tot de pagina er is, dan bestaan de knoppen al #}
	<script src="{{ asset('assets/main/js/profile.js') }}" defer></script>
{% endblock %}

{% block body %}
<div class="page">

        <div class="header">

                  <!-- Profile Picture -->
                 <div class="profile-avatar">
                 <img id="preview" src="default-profile.png" alt="Profile Picture">
                 </div>

                 <input type="file" id="upload" class="upload-input">

                 <!-- eigen knop -->
                 <label for="upload" class="upload-btn">
                   Kies profielfoto
                 </label>

                 </div>







                <div class="profile-text">
                    <h1>Naam</h1>
                    <p>@username</p>
                    {# <p>Locatie</p> #}
                     <p onclick="openLocationPopup()" class="location-edit">
                   Locatie: <span id="current-location">{{ profile.location ?? 'Niet ingesteld' }}</span>
                    <span class="location-edit-icon">✏️</span>
                      </p>

                    {% if app and app.user %}

                        <p>Status:
                            {% if app.user.status and app.user.status.id == 1 %}
                                Online
                            {% elseif app.user.status and app.user.status.id == 2 %}
                                Afwezig
                            {% else %}
                                Offline
                            {% endif %}
                        </p>


                        <p>
                            {% if app.user.lastLoginAt %}

                                Laatst actief: {{ app.user.lastLoginAt|date('d-m-Y H:i')|default('Zojuist') }}
                            {% else %}
                                Laatst actief: Onbekend
                            {% endif %}
                        </p>
                    {% else %}

                        <p>Occupation / Status</p>
                        <p>Laatst actief: Onbekend</p>
                    {% endif %}
                </div>
                <div id="location-popup" class="location-popup">
    <h3>Locatie aanpassen</h3>
    <select id="new-location">
        <option value="">-- Kies een stad --</option>
        <option value="Den Haag">Den Haag</option>
        <option value="Amsterdam">Amsterdam</option>
        <option value="Rotterdam">Rotterdam</option>
        <option value="Utrecht">Utrecht</option>
        <option value="Eindhoven">Eindhoven</option>
        <option value="Groningen">Groningen</option>
        <option value="Maastricht">Maastricht</option>
    </select>
    <button class="btn-primary" onclick="saveLocation()">Opslaan</button>
    <button class="btn-cancel" onclick="closePopup()">Annuleren</button>
</div>

			<div id="popup-overlay" class="popup-overlay" onclick="closePopup()"></div>
		</div>
	</div>

	<div class="main-grid">

		<div class="card-about-me">
			<h2 class="about-me">Over mij</h2>
			<p class="text-muted">This is an example text.</p>

			<h2 class="expertise">Expertise</h2>
			<div class="expertise-container">
				<div class="bubble">Expertise 1</div>
				<div class="bubble">Expertise 2</div>
				<div class="bubble">Expertise 3</div>
			</div>
		</div>

		<div class="card">
			<div class="action-buttons">
				<a href="#" class="btn-outline">Edit Profile</a>
				<a href="#" class="btn-outline">Projects</a>
                    <a href="#" class="socials">Socials
                    <div class="socials-icons">
                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v12/icons/instagram.svg" alt="Instagram Icon" width="50" height="50">
                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v12/icons/youtube.svg" alt="YouTube Icon" width="50" height="50">
                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v12/icons/tiktok.svg" alt="TikTok Icon" width="50" height="50">
            </div>
</a>
                    </a>
			</div>
		</div>

		<div class="tech-stack">
			<div class="tech-icon">
				<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JS">
			</div>
			<div class="tech-icon">
				<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" alt="HTML5">
			</div>
			<div class="tech-icon">
				<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg" alt="CSS3">
			</div>
			<div class="tech-icon">
				<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" alt="MySQL">
			</div>
			<div class="tech-icon">
				<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg" alt="PHP">
			</div>
		</div>

		<div class="achievements-bar">
			<div class="circle"></div>
			<div class="circle"></div>
			<div class="circle"></div>
			<div class="circle"></div>
			<div class="circle"></div>
		</div>

	</div>

</div>

    {% endblock %}

