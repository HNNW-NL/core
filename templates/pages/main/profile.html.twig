{% extends 'layouts/main.base.html.twig' %}
{% block title %}{{ profileView.name }}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/main/css/profile-responsive.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/main/css/profile-navigation.css') }}">
{% endblock %}
{% block body %}
<article class="profile-page">
    <section class="profile-hero">
        <div class="profile-cover" aria-hidden="true"></div>
        <div class="profile-intro">
            {% if profileView.avatar %}
                <img class="profile-avatar" src="{{ profileView.avatar }}" alt="Profielfoto van {{ profileView.name }}" referrerpolicy="no-referrer">
            {% else %}
                <span class="profile-avatar profile-avatar--empty" aria-hidden="true">{{ profileView.name|slice(0, 1)|upper }}</span>
            {% endif %}
            <div>
                <h1>{{ profileView.name }}</h1>
                <p class="profile-username">@{{ profileView.username }}</p>
                {% if profileView.headline %}<p class="profile-headline">{{ profileView.headline }}</p>{% endif %}
                {% if profileView.location %}<p class="profile-location">{{ profileView.location }}</p>{% endif %}
                {% if profileView.canEdit %}<a class="profile-edit" href="{{ path('account.modify') }}">Profiel bewerken</a>{% endif %}
            </div>
        </div>
    </section>
    <div class="profile-columns">
        <div class="profile-main">
            <section class="profile-section">
                <h2>Over mij</h2>
                <p class="profile-biography">{{ profileView.biography|default('Er is nog geen biografie toegevoegd.') }}</p>
            </section>
            {% if profileView.experience is not empty %}
                <section class="profile-section">
                    <h2>Ervaring</h2>
                    <ul class="profile-experience">
                        {% for experience in profileView.experience %}
                            <li>
                                <h3>{{ experience.jobTitle }}</h3>
                                <p>{{ experience.organisationName|default(experience.externalOrganisationName) }}</p>
                                <p class="profile-period">{{ experience.startDate|date('m-Y') }} – {{ experience.endDate ? experience.endDate|date('m-Y') : 'heden' }}</p>
                                {% if experience.description %}<p class="profile-biography">{{ experience.description }}</p>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
        {% if profileView.skills is not empty %}
            <section class="profile-section profile-skills">
                <h2>Vaardigheden</h2>
                <ul class="profile-skill-list">{% for skill in profileView.skills %}<li>{{ skill.name }}</li>{% endfor %}</ul>
            </section>
        {% endif %}
    </div>
</article>
{% endblock %}
