{% extends 'layouts/main.base.html.twig' %}

{% block title %}
  Profiel
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/main/css/home.css') }}">
{% endblock %}

{% block body %}
    <div class="page">

        <div class="header">
            <div class="profile">
                <div class="profile-avatar"></div>

                <div class="profile-text">
                    <h1>Naam</h1>
                    
                    {% if app and app.user %}
                        
                        
                        <p>Status: 
                            {% if app.user.statusId == 1 %}
                                Online
                            {% else %}
                                Offline
                            {% endif %}
                        </p>
                        
                        
                        <p>
                            {% if app.user.lastLoginAt %}
                                Laatst actief: {{ app.user.lastLoginAt|date('d-m-Y H:i') }}
                            {% else %}
                                Laatst actief: Onbekend
                            {% endif %}
                        </p>
                    {% else %}
                        
                        <p>Occupation / Status</p>
                        <p>Laatst actief: Onbekend</p>
                    {% endif %}
                   
                    
                    <p>Locatie</p>
                </div>
            </div>

            <div class="tech-stack">
                <div class="tech-icon">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JS">
                </div>
                <div class="tech-icon">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" alt="HTML5">
                </div>
                <div class="tech-icon">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg" alt="CSS3">
                </div>
                <div class="tech-icon">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" alt="MySQL">
                </div>
                <div class="tech-icon">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg" alt="PHP">
                </div>
            </div>
        </div>

        <div class="main-grid">

            <div class="card-about-me">
                <h2>Over mij</h2>
                <p class="text-muted">This is an example text.</p>

                <h2 style="margin-top: 40px;">Expertise</h2>
                <div class="expertise-container">
                    <div class="bubble">Expertise 1</div>
                    <div class="bubble">Expertise 2</div>
                    <div class="bubble">Expertise 3</div>
                </div>
            </div>

            <div class="card">
                <div class="action-buttons">
                    <a href="#" class="btn-outline">Edit Profile</a>
                    <a href="#" class="btn-outline">Projects</a>
                </div>
            </div>

            <div class="achievements-bar">
                <div class="circle"></div>
                <div class="circle"></div>
                <div class="circle"></div>
                <div class="circle"></div>
                <div class="circle"></div>
            </div>

        </div>

    </div>
{% endblock %}