{% extends 'layouts/main.base.html.twig' %}
{% import 'pages/main/_profile-pagination.html.twig' as pagination %}

{# Page title meta tag #}
{% block title %}{{ profileView.name }}{% endblock %}

{# SEO #}
{% block seoKeywords %}{% endblock %}
{% block seoDescription %}{% endblock %}
{% block seoAuthor %}HNNW{% endblock %}

{# CSS #}
{% block stylesheets %}
    {# Navigatie staat in home.css; alle geneste responsive profielregels staan in profile.css. #}
    <link rel="stylesheet" href="{{ asset("assets/main/css/home.css") }}">
    <link rel="stylesheet" href="{{ asset("assets/main/css/profile.css") }}">
{% endblock %}

{# JavaScript #}
{% block javascript %}<script src="{{ asset('assets/main/js/profile.js') }}" defer></script>{% endblock %}

{# Page content #}
{% block body %}
    <div id="inner-main" class="profile-page">
        <article id="profile">
            <section id="basic-info">
                <figure id="p-cover">
                    <img id="pc-img" src="{{ asset("assets/shared/img/placeholders/banner.svg") }}" alt="">
                </figure>

                <div id="p-image">
                    <figure id="p-avatar" data-profile-fallback="{{ profileView.name|slice(0, 1)|upper }}">{% if profileView.avatar %}<img src="{{ profileView.avatar }}" alt="Profielfoto van {{ profileView.name }}" referrerpolicy="no-referrer">{% else %}<img src="{{ asset('assets/shared/img/placeholders/profile.svg') }}" alt="">{% endif %}</figure>
                    <a id="pi-icon" href="" aria-disabled="true" tabindex="-1" title="Profielmeldingen zijn niet beschikbaar">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M14.826 19A3 3 0 0 1 12 21a3 3 0 0 1-2.825-2zM12 2a7 7 0 0 1 7 7v3.528a1 1 0 0 0 .106.447l1.717 3.433A1.1 1.1 0 0 1 19.838 18H4.162a1.1 1.1 0 0 1-.984-1.592l1.717-3.433A1 1 0 0 0 5 12.528V9a7 7 0 0 1 7-7"/></svg>
                    </a>
                </div>

                <div id="p-info">
                    <div id="pi-core">
                        <div id="pc-info">
                            <div id="pci-title">
                                <div id="pci-name">
                                    <div id="pcin-name">
                                        <h1>{{ profileView.name }}</h1>
                                    </div>
                                    <figure id="pcin-verification" title="E-mailadres bevestigd"{% if not profileView.emailVerified %} hidden{% endif %}>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m8.38 12l2.41 2.42l4.83-4.84"/><path d="M10.75 2.45c.69-.59 1.82-.59 2.52 0l1.58 1.36c.3.26.86.47 1.26.47h1.7c1.06 0 1.93.87 1.93 1.93v1.7c0 .39.21.96.47 1.26l1.36 1.58c.59.69.59 1.82 0 2.52l-1.36 1.58c-.26.3-.47.86-.47 1.26v1.7c0 1.06-.87 1.93-1.93 1.93h-1.7c-.39 0-.96.21-1.26.47l-1.58 1.36c-.69.59-1.82.59-2.52 0l-1.58-1.36c-.3-.26-.86-.47-1.26-.47H6.18c-1.06 0-1.93-.87-1.93-1.93V16.1c0-.39-.21-.95-.46-1.25l-1.35-1.59c-.58-.69-.58-1.81 0-2.5l1.35-1.59c.25-.3.46-.86.46-1.25V6.2c0-1.06.87-1.93 1.93-1.93h1.73c.39 0 .96-.21 1.26-.47z"/></g></svg>
                                    </figure>
                                </div>
                                {# Pronouns en connecties hebben nog geen veld/relatie in het huidige datamodel. #}
                                <div id="pci-pronouns" hidden aria-hidden="true">
                                    <p></p>
                                </div>
                            </div>

                            <p id="pci-headline">{{ profileView.headline }}</p>
                            <p id="pci-location">{{ profileView.location }}</p>
                        </div>
                        {% if profileView.experience is not empty or profileView.education is not empty %}
                        <div id="pc-companies">
                            {% for experience in profileView.experience|slice(0, 1) %}
                                {% set companyName = experience.organisationName|default(experience.externalOrganisationName) %}
                                <div class="company">
                                    <figure class="comp-icon" data-profile-fallback="{{ companyName|slice(0, 1) }}">{% if experience.organisationLogo %}<img src="{{ experience.organisationLogo }}" alt="" referrerpolicy="no-referrer">{% else %}<span>{{ companyName|slice(0, 1) }}</span>{% endif %}</figure>
                                    <p>{{ companyName }}</p>
                                </div>
                            {% endfor %}
                            {% for education in profileView.education|slice(0, 1) %}
                                <div class="company">
                                    <figure class="comp-icon" data-profile-fallback="{{ education.school|slice(0, 1) }}">{% if education.logo %}<img src="{{ education.logo }}" alt="" referrerpolicy="no-referrer">{% else %}<span>{{ education.school|slice(0, 1) }}</span>{% endif %}</figure>
                                    <p>{{ education.school }}</p>
                                </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>

                    {% if profileView.pagination.socialLinks is defined and profileView.pagination.socialLinks.total > 0 %}
                    <div id="pi-website">
                        {% for link in profileView.socialLinks %}
                            <a {% if loop.first %}id="piw-link"{% endif %} class="profile-website" href="{{ link.url }}" target="_blank" rel="noopener noreferrer"><p>{{ link.label|default(link.url) }}</p><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6v2H5v12h12v-6zM13 3v2h4.586l-7.793 7.793l1.414 1.414L19 6.414V11h2V3z"/></svg></a>
                        {% endfor %}
                    </div>
                    {{ pagination.section(profileView, 'socialLinks', 'pi-website', '') }}
                    {% endif %}
                    <div id="pi-stats">
                        <p><span>{{ profileView.publicProjectCount }}</span> openbare projecten{% if profileView.sections.skills %} · <span>{{ profileView.pagination.skills.total }}</span> vaardigheden{% endif %}{% if profileView.sections.certificates %} · <span>{{ profileView.pagination.certificates.total }}</span> certificeringen{% endif %}</p>
                    </div>
                    <div id="pi-btns">
                        <a href="#profile-projects" id="pib-projects"><span>Bekijk projecten</span></a>
                        {% if profileView.canEdit %}<a href="{{ path('account.modify') }}"><span>Profiel bewerken</span></a>{% endif %}
                    </div>
                </div>
            </section>

            <section id="about" class="section">
                <h2 id="a-title">Over</h2>
                <p id="a-descr" class="profile-biography">{{ profileView.biography|default('Er is nog geen biografie toegevoegd.')|nl2br }}</p>
                {% if profileView.topSkills is not empty %}<div id="top-skills">
                    <figure id="ts-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="m19.467 8.694l.246-.566a4.36 4.36 0 0 1 2.22-2.25l.759-.339a.53.53 0 0 0 0-.963l-.717-.319a4.37 4.37 0 0 1-2.251-2.326l-.253-.611a.506.506 0 0 0-.942 0l-.253.61a4.37 4.37 0 0 1-2.25 2.327l-.718.32a.53.53 0 0 0 0 .962l.76.338a4.36 4.36 0 0 1 2.219 2.251l.246.566c.18.414.753.414.934 0M5 6a1 1 0 0 0-.8.4l-3 4a1 1 0 0 0 .057 1.269l9 10a1 1 0 0 0 1.486 0l9-10l-1.486-1.338L11 19.505l-7.707-8.563L5.5 8H14V6z"/></svg>
                    </figure>
                    <div id="ts-content">
                        <p id="ts-title">Top skills</p>
                        <p>{{ profileView.topSkills|map(skill => skill.name)|join(' • ') }}</p>
                    </div>
                </div>
            {% endif %}</section>

            {% if profileView.sections.experience %}
            <section id="experience" class="section">
                <h2 id="e-title">Werkervaring</h2>

                {% set experiences = profileView.experienceGroups %}

                <div id="e-list" class="profile-experience">
                    {% for experience in experiences %}
                        <article class="e-item">
                            <figure class="ei-logo" data-profile-fallback="{{ experience.company|slice(0, 1) }}">
                                {% if experience.logo %}
                                    <img src="{{ experience.logo }}" alt="{{ experience.company }}">
                                {% else %}
                                    <span>{{ experience.company|slice(0, 1) }}</span>
                                {% endif %}
                            </figure>

                            <div class="ei-content">
                                {% if experience.positions|length > 1 %}
                                    <div class="ei-company">
                                        <h3>{{ experience.company }}</h3>
                                        {% if experience.duration|default('') %}<p class="ei-muted">{{ experience.duration }}</p>{% endif %}
                                        {% if experience.location|default('') %}<p class="ei-muted">{{ experience.location }}</p>{% endif %}
                                    </div>

                                    <div class="ei-timeline">
                                        {% for position in experience.positions %}
                                            <div class="ei-position">
                                                <h4>{{ position.title }}</h4>
                                                {% if position.type|default(null) %}<p>{{ position.type }}</p>{% endif %}
                                                <p class="ei-muted">{{ position.period }}</p>
                                                {% if position.location|default(null) %}
                                                    <p class="ei-muted">{{ position.location }}</p>
                                                {% endif %}
                                                {% if position.description %}
                                                    <p class="ei-description">{{ position.description|nl2br }}</p>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    {% set position = experience.positions|first %}
                                    <h3>{{ position.title }}</h3>
                                    <p>{{ experience.company }}{% if position.type|default(null) %} · {{ position.type }}{% endif %}</p>
                                    <p class="ei-muted">{{ position.period }}</p>
                                    {% if position.location|default(null) %}<p class="ei-muted">{{ position.location }}</p>{% endif %}
                                    {% if position.description %}
                                        <p class="ei-description">{{ position.description|nl2br }}</p>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </article>
                    {% else %}<p class="profile-empty">Er is nog geen werkervaring toegevoegd.</p>
                    {% endfor %}
                </div>
                {{ pagination.section(profileView, 'experience', 'experience', 'e-footer') }}
            </section>
            {% endif %}

            {% if profileView.sections.education %}
            <section id="education" class="section">
                <h2 id="edu-title">Onderwijs</h2>

                {% set educations = profileView.education|map(education => {
    school: education.school, degree: education.degree, fieldOfStudy: education.fieldOfStudy, logo: education.logo,
    period: education.startDate|date('m-Y') ~ ' – ' ~ (education.endDate ? education.endDate|date('m-Y') : 'heden'),
    description: education.description
}) %}

                <div id="edu-list">
                    {% for education in educations %}
                        <article class="edu-item">
                            <figure class="edui-logo" data-profile-fallback="{{ education.school|slice(0, 1) }}">
                                {% if education.logo %}
                                    <img src="{{ education.logo }}" alt="{{ education.school }}">
                                {% else %}
                                    <span>{{ education.school|slice(0, 1) }}</span>
                                {% endif %}
                            </figure>

                            <div class="edui-content">
                                <h3>{{ education.school }}</h3>
                                {% if education.degree %}<p>{{ education.degree }}</p>{% endif %}
                                {% if education.fieldOfStudy %}<p>{{ education.fieldOfStudy }}</p>{% endif %}
                                <p class="edui-muted">{{ education.period }}</p>

                                {% if education.description %}
                                    <p class="edui-description">{{ education.description|nl2br }}</p>
                                {% endif %}

                                {% if education.skills|default(null) %}
                                    <p class="edui-skills">
                                        <strong>Vaardigheden:</strong> {{ education.skills }}
                                    </p>
                                {% endif %}
                            </div>
                        </article>
                    {% else %}<p class="profile-empty">Er zijn nog geen opleidingen toegevoegd.</p>
                    {% endfor %}
                </div>
                {{ pagination.section(profileView, 'education', 'education', 'edu-footer') }}
            </section>
            {% endif %}

            {% if profileView.sections.certificates %}
            <section id="licenses" class="section">
                <h2 id="l-title">Licenties en certificeringen ({{ profileView.pagination.certificates.total }})</h2>

                {% set certificates = profileView.certificates|map(certificate => {
    title: certificate.title, issuer: certificate.issuer,
    issued: certificate.issuedOn ? certificate.issuedOn|date('m-Y') : '',
    expires: certificate.expiresOn ? certificate.expiresOn|date('m-Y') : '',
    credential: certificate.credential, url: certificate.url
}) %}

                <div id="l-list">
                    {% for certificate in certificates %}
                        <article class="l-item">
                            <figure class="li-logo">
                                {% if certificate.logo|default(null) %}
                                    <img src="{{ certificate.logo }}" alt="{{ certificate.issuer }}">
                                {% else %}
                                    <span>{{ certificate.issuer|slice(0, 1) }}</span>
                                {% endif %}
                            </figure>

                            <div class="li-content">
                                <h3>{{ certificate.title }}</h3>
                                <p>{{ certificate.issuer }}</p>
                                {% if certificate.issued %}<p class="li-muted">{{ certificate.issued }}</p>{% endif %}
                                {% if certificate.expires %}<p class="li-muted">Geldig tot {{ certificate.expires }}</p>{% endif %}

                                {% if certificate.credential %}
                                    <p class="li-muted">
                                        Credential ID: {{ certificate.credential }}
                                    </p>
                                {% endif %}

                                {% if certificate.url %}
                                    <a class="li-action" href="{{ certificate.url }}" target="_blank" rel="noopener noreferrer">
                                        <p>Certificaat weergeven</p>
                                        <span aria-hidden="true">↗</span>
                                    </a>
                                {% endif %}
                            </div>
                        </article>
                    {% else %}<p class="profile-empty">Er zijn nog geen certificaten toegevoegd.</p>
                    {% endfor %}
                </div>
                {{ pagination.section(profileView, 'certificates', 'licenses', 'l-footer') }}
            </section>
            {% endif %}

            {% if profileView.sections.skills %}
            <section id="skills" class="section">
                <h2 id="s-title">Vaardigheden ({{ profileView.pagination.skills.total }})</h2>

                {% set profileSkills = profileView.skills %}

                <div id="s-list" class="profile-skill-list">
                    {% for skill in profileSkills %}
                        <article class="s-item">
                            <h3>{{ skill.name }}</h3>

                            {% if skill.context %}
                                <div class="si-context">
                                    <span aria-hidden="true">◇</span>
                                    <p>{{ skill.context }}</p>
                                </div>
                            {% endif %}

                            {% if skill.endorsements|default(null) is not null %}
                                <p class="si-endorsements">
                                    {{ skill.endorsements }} onderschrijvingen
                                </p>
                            {% endif %}
                        </article>
                    {% else %}<p class="profile-empty">Er zijn nog geen vaardigheden toegevoegd.</p>
                    {% endfor %}
                </div>
                {{ pagination.section(profileView, 'skills', 'skills', 's-footer') }}
            </section>
            {% endif %}

            <section id="profile-projects" class="section">
                <h2>Openbare projecten</h2>
                <ul>
                    {% for project in profileView.projects %}
                        <li><a href="{{ path('main.projects.detail', {slug: project.slug}) }}">{{ project.title }}</a></li>
                    {% else %}<li class="profile-empty">Er zijn geen openbare projecten beschikbaar.</li>{% endfor %}
                </ul>
                {% if profileView.projectPages > 1 %}
                    <nav class="profile-project-pagination" aria-label="Paginering openbare projecten">
                        {% if profileView.projectPage > 1 %}<a rel="prev" href="{{ path('main.profile', app.request.query.all|merge({slug: profileView.username, projects_page: profileView.projectPage - 1})) }}#profile-projects">Vorige</a>{% endif %}
                        <span>Pagina {{ profileView.projectPage }} van {{ profileView.projectPages }}</span>
                        {% if profileView.projectPage < profileView.projectPages %}<a rel="next" href="{{ path('main.profile', app.request.query.all|merge({slug: profileView.username, projects_page: profileView.projectPage + 1})) }}#profile-projects">Volgende</a>{% endif %}
                    </nav>
                {% endif %}
            </section>

            <section id="recommendations" class="section">
                <h2 id="r-title">Aanbevelingen</h2>

                {% set receivedRecommendations = profileView.receivedRecommendations %}

                {% set givenRecommendations = profileView.givenRecommendations %}

                <div id="r-tabs">
                    <input type="radio" name="recommendation-tab" id="rt-received" checked>
                    <input type="radio" name="recommendation-tab" id="rt-given">

                    <div id="rt-navigation">
                        <label for="rt-received">Ontvangen</label>
                        <label for="rt-given">Gegeven</label>
                    </div>

                    <div id="rt-received-content" class="rt-content">
                        {% for recommendation in receivedRecommendations %}
                            <article class="r-item">
                                <figure class="ri-avatar">
                                    <span>{{ recommendation.initials }}</span>
                                </figure>

                                <div class="ri-content">
                                    <h3>{{ recommendation.name }}</h3>
                                    {% if recommendation.headline|default('') %}<p class="ri-headline">{{ recommendation.headline }}</p>{% endif %}
                                    <p class="ri-muted">{{ recommendation.date|date('m-Y') }}</p>
                                    {% if recommendation.relation|default('') %}<p class="ri-muted">{{ recommendation.relation }}</p>{% endif %}
                                    <p class="ri-description">{{ recommendation.text|nl2br }}</p>
                                </div>
                            </article>
                        {% else %}
                            <p class="r-empty">Er zijn nog geen ontvangen aanbevelingen.</p>
                        {% endfor %}
                    </div>

                    <div id="rt-given-content" class="rt-content">
                        {% for recommendation in givenRecommendations %}
                            <article class="r-item">
                                <figure class="ri-avatar">
                                    <span>{{ recommendation.initials }}</span>
                                </figure>

                                <div class="ri-content">
                                    <h3>{{ recommendation.name }}</h3>
                                    {% if recommendation.headline|default('') %}<p class="ri-headline">{{ recommendation.headline }}</p>{% endif %}
                                    <p class="ri-muted">{{ recommendation.date|date('m-Y') }}</p>
                                    <p class="ri-description">{{ recommendation.text|nl2br }}</p>
                                </div>
                            </article>
                        {% else %}
                            <p class="r-empty">Er zijn nog geen gegeven aanbevelingen.</p>
                        {% endfor %}
                    </div>
                </div>
            </section>
        </article>

        <section id="suggestions">
            <section id="more-profiles-for-you" class="section">
                <h3>Meer profielen voor jou</h3>
                {% set suggestedProfiles = profileView.suggestions|slice(0, 3) %}

                <div class="suggestion-list">
                    {% for person in suggestedProfiles %}
                        <article class="suggestion-person">
                            <figure class="sp-avatar" aria-hidden="true">
                                <span>{{ person.initials }}</span>
                            </figure>
                            <div class="sp-content">
                                <p class="sp-name">{{ person.name }}</p>
                                <p class="sp-headline">{{ person.headline|default('') }}</p>

                                <a class="sp-action" href="{{ path('main.profile', {slug: person.username}) }}">
                                    <p>Bekijk profiel</p>
                                </a>
                            </div>
                        </article>
                    {% else %}<p class="profile-empty">Er zijn nog geen andere openbare profielen beschikbaar.</p>
                    {% endfor %}
                </div>
                <a class="suggestion-footer" href="#more-profiles-for-you">
                    <p>Alles weergeven</p>
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M5 12h14m-6-6 6 6-6 6"/>
                    </svg>
                </a>
            </section>

            <section id="people-you-may-know" class="section">
                <h3>Personen die jij wellicht kent</h3>
                {% set peopleYouMayKnow = profileView.suggestions|slice(3, 3) %}

                <div class="suggestion-list">
                    {% for person in peopleYouMayKnow %}
                        <article class="suggestion-person">
                            <figure class="sp-avatar" aria-hidden="true">
                                <span>{{ person.initials }}</span>
                            </figure>
                            <div class="sp-content">
                                <p class="sp-name">{{ person.name }}</p>
                                <p class="sp-headline">{{ person.headline|default('') }}</p>

                                <a class="sp-action" href="{{ path('main.profile', {slug: person.username}) }}">
                                    <p>Bekijk profiel</p>
                                </a>
                            </div>
                        </article>
                    {% else %}<p class="profile-empty">Er zijn nog geen andere openbare profielen beschikbaar.</p>
                    {% endfor %}
                </div>
                <a class="suggestion-footer" href="#people-you-may-know">
                    <p>Alles weergeven</p>
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M5 12h14m-6-6 6 6-6 6"/>
                    </svg>
                </a>
            </section>
        </section>
    </div>
{% endblock %}
