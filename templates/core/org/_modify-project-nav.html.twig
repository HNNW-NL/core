
<link rel="stylesheet" href="{{ asset("assets/org/css/modify-project-nav.css") }}">

<nav class="sidebar">
    <h2>Dashboard</h2>

    {% set currentRoute = app.request.attributes.get('_route') %}
    <ul>
        {% for route, label in {
            'org.modifyProject.workPackages': 'Werkpakketten',
            'org.modifyProject.tasks': 'Tasks',
            'org.modifyProject': 'Edit Visibility',
            'org.modifyProject.reviews': 'Reviews',
            'org.modifyProject.participants': 'Participants',
            'org.modifyProject.inviteParticipants': 'Invite Participants'
        } %}
            <li>
                <a href="{{ path(route, { id: id }) }}"{% if currentRoute == route %} class="active" aria-current="page"{% endif %}>{{ label }}</a>
            </li>
        {% endfor %}
    </ul>
</nav>
