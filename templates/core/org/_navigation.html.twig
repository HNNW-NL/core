{# alleen de thema-schakelaar; een echt menu is er in deze sectie nog niet #}
<div class="theme-bar">
    <div class="theme-toggle" role="group" aria-label="Thema">
        <button type="button" data-theme-mode="auto" aria-pressed="true">Auto</button>
        <button type="button" data-theme-mode="light" aria-pressed="false">Licht</button>
        <button type="button" data-theme-mode="dark" aria-pressed="false">Donker</button>
    </div>
</div>
