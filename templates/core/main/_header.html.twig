{% set currentRoute = app.request.attributes.get('_route')|default('') %}
<header id="hnnw-header"
        data-controller="navigation"
        data-action="keydown.esc@window->navigation#escape click@document->navigation#outside resize@window->navigation#resize">
    <div class="header-inner">
        <a href="{{ path('main.home') }}" class="logo-name" aria-label="Het Nieuwe Nieuwe Werken, home">
            <span class="logo-name-het">Het</span><span>Nieuwe</span><sup>2</sup><span class="logo-name-werken">Werken</span>
        </a>
        <button type="button" class="hamburger" aria-label="Navigatiemenu" aria-controls="navbar" aria-expanded="false" data-navigation-target="toggle" data-action="navigation#toggle">
            <svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <nav class="navbar" id="navbar" aria-label="Hoofdnavigatie" data-navigation-target="menu" data-action="click->navigation#follow">
            <ul class="nav-links">
            <li><a class="nav-button" href="{{ path('main.home') }}" {% if currentRoute == 'main.home' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-7 9 7v11h-6v-7H9v7H3z"/></svg><span>Home</span></a></li>
            <li><a class="nav-button" href="{{ path('main.projects.home') }}" {% if currentRoute starts with 'main.projects.' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v15H3z M8 5V3h8v2 M3 11h18"/></svg><span>Projecten</span></a></li>
            <li><a class="nav-button" href="{{ path('main.jobs.home') }}" {% if currentRoute starts with 'main.jobs.' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v14H3z M8 7V3h8v4 M3 13h18"/></svg><span>Vacatures</span></a></li>
            <li><a class="nav-button" href="{{ path('main.events') }}" {% if currentRoute in ['main.events', 'main.event'] %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v16H3z M7 3v4 M17 3v4 M3 10h18"/></svg><span>Evenementen</span></a></li>
            <li><a class="nav-button" href="{{ path('main.about') }}" {% if currentRoute == 'main.about' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18 M12 11v6 M12 7h.01"/></svg><span>Over ons</span></a></li>
            <li><a class="nav-button" href="{{ path('main.contact') }}" {% if currentRoute == 'main.contact' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18v14H3z M3 5l9 8 9-8"/></svg><span>Contact</span></a></li>
            {% if is_granted('ROLE_USER') %}
            <li><a class="nav-button" href="{{ path('account.notifications') }}" {% if currentRoute == 'account.notifications' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14l-2-4V9a5 5 0 0 0-10 0v4z M10 21h4"/></svg><span>Meldingen</span></a></li>
            <li><a class="nav-button" href="{{ path('account.home') }}" {% if currentRoute starts with 'account.' and currentRoute != 'account.notifications' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Account</span></a></li>
            {% else %}
            <li><a class="nav-button" href="{{ path('auth.login') }}" {% if currentRoute == 'auth.login' %}aria-current="page"{% endif %}><svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v16h-6 M3 12h12 M11 8l4 4-4 4"/></svg><span>Inloggen</span></a></li>
            {% endif %}
            </ul>
        </nav>
    </div>
</header>
